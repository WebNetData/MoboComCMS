{
  "id": "music",
  "name": "موزیک",
  "nameEn": "Music",
  "description": "آهنگ، آلبوم، هنرمند و پلی‌لیست با پخش‌کنندهٔ سراسری، دانلود با کیفیت ۱۲۸ و ۳۲۰ و متن آهنگ.",
  "descriptionEn": "Tracks, albums, artists and playlists with a site-wide player, 128/320 downloads and lyrics.",
  "version": "2.0.0",
  "kind": "module",
  "apiVersion": 1,
  "category": "content",
  "icon": "bolt",
  "defaultEnabled": true,
  "requiresCore": "^1.0.0",
  "publicPaths": [
    "/music"
  ],
  "adminPaths": [
    "/admin/music"
  ],
  "settings": [
    {
      "key": "seo.title",
      "label": "عنوان سئوی صفحهٔ اصلی موزیک",
      "labelEn": "music home SEO title",
      "type": "text",
      "public": true
    },
    {
      "key": "seo.description",
      "label": "توضیح متای صفحهٔ اصلی موزیک",
      "labelEn": "music home meta description",
      "type": "textarea",
      "public": true
    },
    {
      "key": "hq-members-only",
      "label": "کیفیت ۳۲۰ فقط برای اعضای ویژه",
      "labelEn": "320 kbps for VIP members only",
      "type": "boolean",
      "default": true
    },
    {
      "key": "download-members-only",
      "label": "دانلود فقط برای اعضای ویژه (پخش آنلاین برای همه)",
      "labelEn": "Downloads for VIP only (streaming stays open)",
      "type": "boolean",
      "default": false
    }
  ],
  "permissions": [
    {
      "id": "music.manage",
      "label": "مدیریت موزیک"
    },
    {
      "id": "music.author",
      "label": "نویسندهٔ موزیک (فقط آثار خودش)"
    }
  ],
  "adminMenu": {
    "title": "موزیک",
    "titleEn": "Music",
    "icon": "music",
    "order": 60,
    "items": [
      {
        "href": "/admin/music",
        "label": "داشبورد موزیک",
        "labelEn": "Music dashboard",
        "icon": "grid",
        "permissions": [
          "music.manage"
        ],
        "exact": true
      },
      {
        "href": "/admin/music/library",
        "label": "آهنگ، آلبوم و هنرمند",
        "labelEn": "Tracks, albums & artists",
        "icon": "grid",
        "permissions": [
          "music.manage",
          "music.author"
        ]
      },
      {
        "href": "/admin/taxonomy?tax=music",
        "label": "دسته‌بندی موزیک",
        "labelEn": "Categories",
        "icon": "grid",
        "permissions": [
          "music.manage"
        ]
      },
      {
        "href": "/admin/music/settings",
        "label": "صفحهٔ اصلی موزیک",
        "labelEn": "Music home",
        "icon": "sliders",
        "permissions": [
          "music.manage",
          "settings.manage"
        ]
      },
      {
        "href": "/admin/sections/music",
        "label": "تنظیمات بخش و آدرس",
        "labelEn": "Section settings & address",
        "icon": "sliders",
        "permissions": [
          "settings.manage"
        ]
      }
    ]
  }
}
