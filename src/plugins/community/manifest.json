    "order": 35,
    "items": [
      { "href": "/admin/community", "label": "داشبورد جامعه", "labelEn": "Community dashboard", "icon": "grid", "permissions": ["community.moderate", "users.manage"], "exact": true },
      { "href": "/admin/community/reports", "label": "گزارش‌ها", "labelEn": "Reports", "icon": "shield", "permissions": ["community.moderate", "users.manage"] },
      { "href": "/admin/community/posts", "label": "پست‌ها", "labelEn": "Posts", "icon": "sliders", "permissions": ["community.moderate", "users.manage"] },
      { "href": "/admin/community/people", "label": "کاربران و نشان تأیید", "labelEn": "Members & verification", "icon": "devices", "permissions": ["community.moderate", "users.manage"] },
      { "href": "/admin/sections/community", "label": "تنظیمات بخش و آدرس", "labelEn": "Section settings & address", "icon": "sliders", "permissions": ["settings.manage"] }
    ]
  },
  "settings": [
    { "key": "seo.title", "label": "عنوان سئوی صفحهٔ «تازه‌ها»", "labelEn": "Feed SEO title", "type": "text", "public": true },
    { "key": "seo.description", "label": "توضیح متای صفحهٔ «تازه‌ها»", "labelEn": "Feed meta description", "type": "textarea", "public": true },
    { "key": "posts.enabled", "label": "کاربران بتوانند پست بگذارند", "labelEn": "Members can post", "type": "boolean", "default": true },
    { "key": "posts.images", "label": "ارسال تصویر در پست", "labelEn": "Images in posts", "type": "boolean", "default": true },
