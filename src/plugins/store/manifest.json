{
  "id": "store",
  "name": "فروشگاه",
  "nameEn": "Store",
  "description": "فروشگاه‌ساز کامل: سبد خرید، برند، فیلتر و مرتب‌سازی، پیشنهاد شگفت‌انگیز، مدیریت سفارش با پیگیری مرحله‌ای، انبارداری و گزارش فروش.",
  "descriptionEn": "Full store builder: cart, brands, filtered listings, timed offers, staged order tracking, inventory and sales reports.",
  "version": "2.0.0",
  "kind": "module",
  "apiVersion": 1,
  "category": "commerce",
  "icon": "grid",
  "defaultEnabled": false,
  "stateSetting": "storeEnabled",
  "requiresCore": "^1.0.0",
  "publicPaths": [
    "/products",
    "/checkout/product",
    "/cart",
    "/checkout/cart",
    "/track"
  ],
  "adminPaths": [
    "/admin/store",
    "/admin/products",
    "/admin/productcats",
    "/admin/productgroups",
    "/admin/product-feedback",
    "/admin/product-deliveries",
    "/admin/delivery",
    "/admin/shipping-carriers"
  ],
  "adminMenu": {
    "title": "فروشگاه",
    "titleEn": "Store",
    "icon": "grid",
    "order": 10,
    "items": [
      {
        "href": "/admin/store",
        "label": "داشبورد فروشگاه",
        "labelEn": "Store dashboard",
        "icon": "grid",
        "permissions": [
          "orders.manage",
          "cms.products"
        ],
        "exact": true
      },
      {
        "href": "/admin/store/orders",
        "label": "سفارش‌ها",
        "labelEn": "Orders",
        "icon": "wallet",
        "permissions": [
          "orders.manage"
        ]
      },
      {
        "href": "/admin/store/returns",
        "label": "لغو و مرجوعی",
        "labelEn": "Returns & cancellations",
        "icon": "wallet",
        "permissions": [
          "orders.manage"
        ]
      },
      {
        "href": "/admin/store/shipments",
        "label": "مرسوله‌ها و بارنامه‌ها",
        "labelEn": "Shipments & waybills",
        "icon": "wallet",
        "permissions": [
          "orders.manage"
        ]
      },
      {
        "href": "/admin/store/products",
        "label": "محصولات",
        "labelEn": "Products",
        "icon": "grid",
        "permissions": [
          "cms.products"
        ]
      },
      {
        "href": "/admin/store/inventory",
        "label": "انبار و موجودی",
        "labelEn": "Inventory",
        "icon": "sliders",
        "permissions": [
          "cms.products"
        ]
      },
      {
        "href": "/admin/store/brands",
        "label": "برندها",
        "labelEn": "Brands",
        "icon": "grid",
        "permissions": [
          "cms.products"
        ]
      },
      {
        "href": "/admin/productcats",
        "label": "دسته‌بندی محصولات",
        "labelEn": "Product categories",
        "icon": "grid",
        "permissions": [
          "cms.products"
        ]
      },
      {
        "href": "/admin/productgroups",
        "label": "گروه‌های مشخصات",
        "labelEn": "Attribute groups",
        "icon": "grid",
        "permissions": [
          "cms.products"
        ]
      },
      {
        "href": "/admin/store/customers",
        "label": "مشتریان",
        "labelEn": "Customers",
        "icon": "devices",
        "permissions": [
          "orders.manage",
          "users.manage"
        ]
      },
      {
        "href": "/admin/product-feedback",
        "label": "دیدگاه‌ها و پرسش‌ها",
        "labelEn": "Reviews & questions",
        "icon": "chat",
        "permissions": [
          "cms.products"
        ]
      },
      {
        "href": "/admin/shipping-carriers",
        "label": "شرکت‌های حمل و تعرفهٔ ارسال",
        "labelEn": "Carriers & shipping rates",
        "icon": "sliders",
        "permissions": [
          "orders.manage",
          "settings.manage"
        ]
      },
      {
        "href": "/admin/delivery",
        "label": "زمان‌بندی و هزینهٔ ارسال",
        "labelEn": "Delivery schedule",
        "icon": "sliders",
        "permissions": [
          "orders.manage",
          "settings.manage"
        ]
      },
      {
        "href": "/admin/products",
        "label": "ویرایش سریع محصولات",
        "labelEn": "Quick product editor",
        "icon": "grid",
        "permissions": [
          "cms.products"
        ]
      },
      {
        "href": "/admin/store/currency",
        "label": "نرخ ارز و قیمت ارزی",
        "labelEn": "Exchange rates & FX pricing",
        "icon": "wallet",
        "permissions": [
          "cms.products",
          "orders.manage",
          "settings.manage"
        ]
      },
      {
        "href": "/admin/store/settings",
        "label": "ویترین فروشگاه",
        "labelEn": "Storefront",
        "icon": "sliders",
        "permissions": [
          "settings.manage",
          "cms.products"
        ]
      },
      {
        "href": "/admin/sections/store",
        "label": "تنظیمات بخش و آدرس",
        "labelEn": "Section settings & address",
        "icon": "sliders",
        "permissions": [
          "settings.manage"
        ]
      }
    ]
  },
  "settings": [
    {
      "key": "seo.title",
      "label": "عنوان سئوی صفحهٔ اصلی فروشگاه",
      "labelEn": "store home SEO title",
      "type": "text",
      "public": true
    },
    {
      "key": "seo.description",
      "label": "توضیح متای صفحهٔ اصلی فروشگاه",
      "labelEn": "store home meta description",
      "type": "textarea",
      "public": true
    }
  ]
}
