        "icon": "plus",
        "permissions": [
          "games.manage"
        ]
      },
      {
        "href": "/admin/games/releases",
        "label": "تقویم انتشار",
        "labelEn": "Release calendar",
        "icon": "sliders",
        "permissions": [
          "games.manage"
        ]
      },
      {
        "href": "/admin/games/franchises",
        "label": "مجموعه‌ها",
        "labelEn": "Franchises",
        "icon": "grid",
        "permissions": [
          "games.manage"
        ]
      },
      {
        "href": "/admin/taxonomy?tax=games",
        "label": "دسته‌بندی بازی‌ها",
