{
  "id": "games",
  "name": "گیم",
  "nameEn": "Games",
  "description": "پرتال بازی به سبک گیم‌آپ: نقد و نمره، تقویم انتشار، برترین‌ها، مجموعه‌ها، آپدیت و DLC، کتابخانهٔ بازی کاربران و مدیریت تخصصی.",
  "descriptionEn": "GameUp-style games portal: reviews and scores, release calendar, top lists, franchises, updates and DLC, member game libraries and a dedicated admin.",
  "version": "2.0.0",
  "kind": "module",
  "apiVersion": 1,
  "category": "content",
  "icon": "devices",
  "defaultEnabled": true,
  "requiresCore": "^1.0.0",
  "publicPaths": [
    "/games"
  ],
  "adminPaths": [
    "/admin/games"
  ],
  "permissions": [
    {
      "id": "games.manage",
      "label": "مدیریت گیم"
    }
  ],
  "adminMenu": {
    "title": "بازی",
    "titleEn": "Games",
    "icon": "bolt",
    "order": 40,
