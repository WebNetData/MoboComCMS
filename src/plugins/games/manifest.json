        "label": "داشبورد بازی",
        "labelEn": "Games dashboard",
        "icon": "grid",
        "permissions": [
          "games.manage"
        ],
        "exact": true
      },
      {
        "href": "/admin/games/titles",
        "label": "همهٔ بازی‌ها",
