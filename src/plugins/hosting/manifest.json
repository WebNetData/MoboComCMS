{
  "id": "hosting",
  "name": "میزبانی، سرور و ابر",
  "nameEn": "Hosting, servers and cloud",
  "description": "فروش هاست، نمایندگی، سرور مجازی و اختصاصی، سرویس ابری ساعتی و ثبت و انتقال دامنه، با اتصال به کنترل‌پنل‌ها، مجازی‌سازها، API ارائه‌دهندگان و ثبت‌کننده‌ها.",
  "descriptionEn": "Sell hosting, reseller hosting, VPS, dedicated and hourly cloud services, connected to hosting panels, virtualizers and provider APIs.",
  "version": "1.0.0",
  "kind": "module",
  "apiVersion": 1,
  "category": "commerce",
  "icon": "server",
  "defaultEnabled": false,
  "requiresCore": "^1.0.0",
  "publicPaths": [
    "/hosting",
    "/servers",
    "/domains"
  ],
  "adminPaths": [
    "/admin/hosting"
  ],
  "permissions": [
    {
      "id": "hosting.manage",
      "label": "مدیریت میزبانی، سرور و ابر"
    }
  ],
  "settings": [
    {
      "key": "seo.title",
      "label": "عنوان سئوی صفحه‌های میزبانی و سرور",
      "labelEn": "Hosting pages SEO title",
      "type": "text",
      "public": true
    },
    {
      "key": "seo.description",
      "label": "توضیح متای صفحه‌های میزبانی و سرور",
      "labelEn": "Hosting pages meta description",
      "type": "textarea",
      "public": true
    },
    {
      "key": "reminder-days",
      "label": "یادآوری سررسید، چند روز مانده (با ویرگول جدا کنید)",
      "labelEn": "Days before the due date to remind",
      "type": "text",
      "default": "7,3,1"
    },
    {
      "key": "grace-days",
      "label": "مهلت پس از سررسید تا تعلیق (روز)",
      "labelEn": "Days after the due date before suspension",
      "type": "number",
      "default": 3
    },
    {
      "key": "terminate-days",
      "label": "مهلت پس از تعلیق تا حذف (روز)",
      "labelEn": "Days after suspension before termination",
      "type": "number",
      "default": 14
    },
    {
      "key": "auto-renew",
      "label": "تمدید خودکار از کیف پول برای کسانی که روشن کرده‌اند",
      "labelEn": "Renew from the wallet for customers who turned it on",
      "type": "boolean",
      "default": true
    },
    {
      "key": "hourly-min-hours",
      "label": "سرویس ساعتی: موجودی کیف پول دست‌کم برای چند ساعت",
      "labelEn": "Hourly: wallet must cover this many hours to buy",
      "type": "number",
      "default": 24
    },
    {
      "key": "domain-reminder-days",
      "label": "دامنه: یادآوری انقضا، چند روز مانده (با ویرگول)",
      "labelEn": "Domains: days before expiry to remind",
      "type": "text",
      "default": "30,7,1"
    }
  ],
  "adminMenu": {
    "area": "commerce",
    "title": "میزبانی و سرور",
    "titleEn": "Hosting & servers",
    "icon": "server",
    "order": 46,
    "items": [
      {
        "href": "/admin/hosting/services",
        "label": "سرویس‌های مشتریان",
        "labelEn": "Customer services",
        "icon": "server",
        "permissions": [
          "hosting.manage"
        ]
      },
      {
        "href": "/admin/hosting",
        "label": "محصولات و پلن‌ها",
        "labelEn": "Products and plans",
        "icon": "layers",
        "permissions": [
          "hosting.manage"
        ]
      },
      {
        "href": "/admin/hosting/domains",
        "label": "دامنه‌ها",
        "labelEn": "Domains",
        "icon": "globe",
        "permissions": [
          "hosting.manage"
        ]
      },
      {
        "href": "/admin/hosting/tlds",
        "label": "پسوند و قیمت دامنه",
        "labelEn": "Domain prices",
        "icon": "tag",
        "permissions": [
          "hosting.manage"
        ]
      },
      {
        "href": "/admin/hosting/providers",
        "label": "سامانه‌های متصل",
        "labelEn": "Connected systems",
        "icon": "plug",
        "permissions": [
          "hosting.manage"
        ]
      },
      {
        "href": "/admin/sections/hosting",
        "label": "تنظیمات بخش و آدرس",
        "labelEn": "Section settings & address",
        "icon": "sliders",
        "permissions": [
          "settings.manage"
        ]
      }
    ]
  }
}
