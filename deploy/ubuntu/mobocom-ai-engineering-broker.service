[Unit]
Description=MoboCom narrow engineering host broker
After=docker.service network.target
Requires=docker.service
[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/node /usr/local/lib/mobocom-engineering/broker.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectHome=true
[Install]
WantedBy=multi-user.target
