#!/usr/bin/env bash
# The one command an owner needs on the server. Installed root-owned as /usr/local/bin/mobocom by install.sh.
#
#   sudo mobocom status              is the site healthy, which version, is an update waiting, the last backup
#   sudo mobocom update [VERSION]    backup, new code, build, restart; goes back by itself if the site does not start
#   sudo mobocom versions            the released versions and which one is installed
#   sudo mobocom downgrade VERSION   back to an earlier released version, the same safe way (the database is kept)
#   sudo mobocom backup              a backup of the database and stored files, now
#   sudo mobocom backups             the backups on this server
#   sudo mobocom rollback [commit]   back to the version before the last update (the database is not changed)
#   sudo mobocom restore <name>      put a backup back (name from "backups", or latest); asks before it starts
#   sudo mobocom panel on [--ip IP]  turn the Server Panel on (optionally only for these IPs), off, or show its status
#
# update, backup and rollback run as the service user. Only restore needs root, and it lives in this root-owned file
# so root never runs code the site could rewrite.
set -euo pipefail
# Raised when this file gains commands; the one-line installer replaces an installed copy only with a higher one.
HELPER_VERSION=3

APP_USER="${MOBOCOM_APP_USER:-mobocom}"
APP_DIR="${MOBOCOM_APP_DIR:-/opt/mobocom/app}"
ENV_FILE="${MOBOCOM_ENV_FILE:-/etc/mobocom/mobocom.env}"
SERVICE="${MOBOCOM_SERVICE:-mobocom}"
HEALTH="${MOBOCOM_HEALTH_URL:-http://127.0.0.1:3000/api/health/ready}"

die() { echo "[mobocom] $*" >&2; exit 1; }
usage() { sed -n '4,14p' "$0" | sed 's/^# \{0,1\}//'; }
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
[ -f "$APP_DIR/package.json" ] || die "no site in $APP_DIR"
cd "$APP_DIR"
as_app() { sudo -u "$APP_USER" -H "$@"; }
# Environment is evaluated only after dropping root. Runtime configuration is kept local.
db() { as_app bash -c 'set -a; . "$1"; set +a; cd "$2"; if [ -z "${DATABASE_URL:-}" ]; then eval "$(node scripts/load-runtime-env.cjs)"; fi; exec node scripts/host-backup-db.cjs "$3" "$4"' _ "$ENV_FILE" "$APP_DIR" "$1" "$2"; }

# Only the settings this file reads are taken from the environment file; it is never run as root.
setting() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 | sed -e 's/^["'\'']//' -e 's/["'\'']$//'; }
backup_dir() {
  local dir
  dir="$(setting HOST_BACKUP_DIR)"
  if [ -z "$dir" ]; then
    dir="$(setting BACKUP_DIR)"
    case "$dir" in /*) ;; *) dir=/var/backups/mobocom ;; esac
  fi
  printf '%s\n' "$dir"
}
# Sets one KEY=value line of the environment file, keeping every other line, its owner and its mode; the new file
# replaces the old one in one step. Values are checked by the caller.
set_setting() {
  local file="$1" key="$2" value="$3" next
  next="$(mktemp "$(dirname "$file")/.mobocom.env.XXXXXXXX")"
  { grep -v "^$key=" "$file" || true; printf '%s=%s\n' "$key" "$value"; } > "$next"
  chown --reference="$file" "$next"; chmod --reference="$file" "$next"
  mv -f -- "$next" "$file"
}
# IPv4 addresses, IPv4 ranges (a.b.c.d/n) and IPv6 addresses, separated by commas, as the panel reads them.
valid_ips() {
  local entry
  [ -n "$1" ] || return 1
  for entry in ${1//,/ }; do
    [[ "$entry" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$ || "$entry" =~ ^[0-9A-Fa-f:]{2,39}$ ]] || return 1
  done
}
# The address this SSH session comes from, offered as the panel's allowed IP.
ssh_ip() { who -m --ips 2>/dev/null | awk '{print $NF}' | tr -d '()' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$|^[0-9A-Fa-f:]{2,39}$' | head -1 || true; }

panel() {
  local action="${1:-status}" ips='' any=0 url
  [ $# -eq 0 ] || shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --ip) [ $# -ge 2 ] || die 'name the allowed IP: --ip 1.2.3.4 (several: --ip 1.2.3.4,5.6.7.0/24)'; ips="$2"; shift 2 ;;
      --any-ip) any=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  url="$(setting NEXTAUTH_URL)"; url="${url%/}"
  case "$action" in
    status)
      echo "server panel: $([ "$(setting SERVER_PANEL_ENABLED)" = true ] && echo on || echo off)"
      local allowed; allowed="$(setting SERVER_PANEL_ALLOWED_IPS)"
      echo "allowed IPs:  ${allowed:-any (no restriction)}"
      echo "address:      ${url:-https://YOUR-DOMAIN}/admin/server"
      return 0
      ;;
    on)
      if [ -n "$ips" ]; then valid_ips "$ips" || die "not a list of IP addresses: $ips"; fi
      set_setting "$ENV_FILE" SERVER_PANEL_ENABLED true
      if [ -n "$ips" ]; then set_setting "$ENV_FILE" SERVER_PANEL_ALLOWED_IPS "$ips"; fi
      if [ "$any" = 1 ]; then set_setting "$ENV_FILE" SERVER_PANEL_ALLOWED_IPS ''; fi
      ;;
    off) set_setting "$ENV_FILE" SERVER_PANEL_ENABLED false ;;
    *) die 'usage: sudo mobocom panel on [--ip IP[,IP…]|--any-ip] | off | status' ;;
  esac
  echo "[mobocom] restarting the site"
  systemctl restart "$SERVICE"
  wait_healthy || die "the site did not come back; see: journalctl -u $SERVICE -n 80"
  if [ "$action" = off ]; then echo '[mobocom] the Server Panel is off'; return 0; fi
  echo "[mobocom] the Server Panel is on: ${url:-https://YOUR-DOMAIN}/admin/server"
  echo '          open it signed in as an administrator, then enter your password (and two-step code) to unlock it.'
  if [ -z "$(setting SERVER_PANEL_ALLOWED_IPS)" ]; then
    local mine; mine="$(ssh_ip)"
    echo '          It accepts any IP address. To allow only yours (recommended):'
    echo "          sudo mobocom panel on --ip ${mine:-YOUR.IP.ADDRESS}"
  else
    echo "          allowed IPs: $(setting SERVER_PANEL_ALLOWED_IPS)"
  fi
}

backup_names() { find "$(backup_dir)" -maxdepth 1 -type f -name 'db-*.dump' -printf '%f\n' 2>/dev/null | sed -e 's/^db-//' -e 's/\.dump$//' | sort; }

wait_healthy() {
  local i
  for ((i = 0; i < 120; i++)); do
    if curl -fsS -m 5 "$HEALTH" >/dev/null 2>&1; then return 0; fi
    sleep 3
  done
  return 1
}

status() {
  local name branch waiting
  echo "service:  $(systemctl is-active "$SERVICE" 2>/dev/null || true)"
  if curl -fsS -m 5 "$HEALTH" >/dev/null 2>&1; then echo "site:     healthy"; else echo "site:     NOT answering"; fi
  echo "version:  $(as_app node -p "require('./package.json').version")"
  branch="${1:-main}"
  if [ -f /etc/mobocom/release-public.pem ]; then
    echo 'update:   signed package through /admin/updates (no GitHub required)'
  elif as_app git check-ref-format --branch "$branch" >/dev/null && as_app git fetch --quiet origin "$branch" 2>/dev/null; then
    waiting="$(as_app git rev-list --count "HEAD..origin/$branch")"
    echo "update:   $waiting new change(s) on $branch"
  else
    echo "update:   could not reach the repository"
  fi
  name="$(backup_names | tail -1)"
  echo "backup:   ${name:-NONE}"
  echo "disk:     $(df -Pm . | awk 'NR==2 {print $4}') MB free"
  if [ "$(helper_version "$APP_DIR/deploy/ubuntu/mobocom")" -gt "$HELPER_VERSION" ]; then
    echo "note:     a newer helper came with the code; run: sudo install -m 755 $APP_DIR/deploy/ubuntu/mobocom /usr/local/bin/mobocom"
  fi
  return 0
}
helper_version() { local v; v="$(sed -n 's/^HELPER_VERSION=\([0-9]\{1,4\}\)$/\1/p' "$1" 2>/dev/null | head -1)"; printf '%s\n' "${v:-1}"; }

# Released versions are Git tags vX.Y.Z of the repository the site was installed from.
version_tag() { [[ "$1" =~ ^v?([0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4})$ ]] && printf 'v%s\n' "${BASH_REMATCH[1]}"; }
package_install() { [ -f /etc/mobocom/release-public.pem ]; }
fetch_tags() { as_app env GIT_TERMINAL_PROMPT=0 git fetch --quiet --tags origin || die 'could not reach the code repository'; }
tag_commit() { as_app git rev-parse --verify --quiet "refs/tags/$1^{commit}" || die "version ${1#v} does not exist; see: sudo mobocom versions"; }
is_older() { as_app git merge-base --is-ancestor "$1" HEAD; }
versions() {
  local head tag commit mark
  fetch_tags
  head="$(as_app git rev-parse HEAD)"
  echo "installed: $(as_app node -p "require('./package.json').version") ($(as_app git describe --tags --always HEAD))"
  echo 'released versions:'
  while read -r tag; do
    [ -n "$tag" ] || continue
    commit="$(as_app git rev-parse --verify --quiet "refs/tags/$tag^{commit}")" || continue
    if [ "$commit" = "$head" ]; then mark='installed'
    elif is_older "$commit"; then mark="older: sudo mobocom downgrade ${tag#v}"
    else mark="newer: sudo mobocom update ${tag#v}"; fi
    printf '  %-10s %s\n' "${tag#v}" "$mark"
  done < <(as_app git tag --list 'v[0-9]*' --sort=-v:refname)
}
# The site's own update script does the work. One older than UPDATE_TO knows only UPDATE_ROLLBACK_TO, which
# moves to the same exact commit the same safe way (it only words its messages as "going back").
run_update() { as_app env "$@" UPDATE_ENV_FILE="$ENV_FILE" MOBOCOM_ENV_FILE="$ENV_FILE" MOBOCOM_APP_DIR="$APP_DIR" bash deploy/ubuntu/update.sh; }
to_commit() {
  if grep -q 'UPDATE_TO:-' deploy/ubuntu/update.sh; then run_update UPDATE_TO="$1"; else run_update UPDATE_ROLLBACK_TO="$1"; fi
}
downgrade() {
  local tag commit answer yes=0
  [ "${2:-}" != --yes ] || yes=1
  [ -n "${1:-}" ] || die 'name a version: sudo mobocom downgrade 1.6.1 (list: sudo mobocom versions)'
  tag="$(version_tag "$1")" || die "not a version number: $1 (list: sudo mobocom versions)"
  fetch_tags
  commit="$(tag_commit "$tag")"
  [ "$commit" != "$(as_app git rev-parse HEAD)" ] || die "version ${tag#v} is already installed"
  is_older "$commit" || die "version ${tag#v} is not older than the installed code; use: sudo mobocom update ${tag#v}"
  cat <<EOF

The site's code goes back to version ${tag#v}. First a backup of the database and files is taken.
Your data stays as it is: orders, users, posts and uploaded files are kept, and the database is not rewound.
If version ${tag#v} cannot start with this data, the current version comes back by itself.
To also put the data back to an earlier day, use a backup afterwards: sudo mobocom backups, sudo mobocom restore NAME
EOF
  if [ "$yes" = 0 ]; then
    read -r -p "Type DOWNGRADE to continue: " answer
    [ "$answer" = DOWNGRADE ] || die 'nothing was changed'
  fi
  run_update UPDATE_ROLLBACK_TO="$commit"
}

restore() {
  local name="${1:-}" dir dump files answer
  dir="$(backup_dir)"
  [ -n "$name" ] || { usage; die "name a backup: sudo mobocom restore latest"; }
  [ "$name" != latest ] || name="$(backup_names | tail -1)"
  [[ "$name" =~ ^[0-9]{8}-[0-9]{6}$ ]] || die "no such backup: ${1:-}; see: sudo mobocom backups"
  dump="$dir/db-$name.dump"
  files="$dir/storage-$name.tar.gz"
  [ -f "$dump" ] && [ -f "$files" ] || die "backup $name is incomplete in $dir"

  cat <<EOF

Everything saved after backup $name goes back to how it was then:
orders, users, posts and uploaded files. A backup of the current state is taken first.
EOF
  if [ "${MOBOCOM_RESTORE_CONFIRM:-}" != "$name" ]; then
    read -r -p "Type RESTORE to continue: " answer
    [ "$answer" = RESTORE ] || die "nothing was changed"
  fi

  # Same lock as both update entry points. Never steal a live/abandoned lock by age.
  LOCK="$APP_DIR/storage/update/lock"
  as_app mkdir -p "$(dirname "$LOCK")"
  as_app mkdir "$LOCK" 2>/dev/null || die 'another update or restore is running'
  trap 'as_app rmdir "$LOCK" 2>/dev/null || true' EXIT
  STOPPED=0; ADOPTED=0; COMMITTED=0
  holding="$(as_app mktemp -d "$(dirname "$APP_DIR")/.restore.XXXXXXXX")"
  restore_exit() {
    local code=$?
    if [ "$ADOPTED" = 1 ] && [ "$COMMITTED" = 0 ]; then
      if ! as_app python3 deploy/ubuntu/restore-files.py undo "$APP_DIR/storage" "$holding"; then
        echo "[mobocom] file recovery failed; service left stopped; staging: $holding" >&2
        STOPPED=0; code=1
      fi
    fi
    if [ "$STOPPED" = 1 ]; then systemctl start "$SERVICE" || code=1; fi
    as_app rmdir "$LOCK" 2>/dev/null || true
    return "$code"
  }
  trap restore_exit EXIT
  trap 'exit 130' INT TERM HUP
  echo '[mobocom] validating private copies of the backup as the service user'
  [ ! -L "$dump" ] && [ ! -L "$files" ] || die 'backup links are not accepted'
  as_app cp --no-dereference -- "$dump" "$holding/db.dump"
  as_app cp --no-dereference -- "$files" "$holding/storage.tar.gz"
  [ ! -L "$holding/db.dump" ] && [ ! -L "$holding/storage.tar.gz" ] || die 'backup links are not accepted'
  db list "$holding/db.dump"
  as_app python3 deploy/ubuntu/restore-files.py extract "$holding/storage.tar.gz" "$holding"
  echo '[mobocom] stopping the site and backing up the current state'
  systemctl stop "$SERVICE"; STOPPED=1
  as_app env MOBOCOM_ENV_FILE="$ENV_FILE" MOBOCOM_APP_DIR="$APP_DIR" bash deploy/ubuntu/backup.sh || die 'safety backup failed; nothing was replaced'
  # Adopt files first; if the DB transaction fails the EXIT handler restores the old files.
  if as_app python3 deploy/ubuntu/restore-files.py adopt "$APP_DIR/storage" "$holding"; then
    ADOPTED=1
  else
    code=$?
    if [ "$code" = 2 ]; then STOPPED=0; fi
    die "file adoption failed; inspect private staging: $holding"
  fi
  db restore "$holding/db.dump" || die 'database restore failed; the DB transaction was rolled back'
  COMMITTED=1
  systemctl start "$SERVICE"; STOPPED=0
  wait_healthy || die "restored data retained; service unhealthy; inspect: journalctl -u $SERVICE"
  echo "[mobocom] restored $name; current config, backups and update state kept. Previous files: $holding/before"
}

command="${1:-}"
[ $# -eq 0 ] || shift
case "$command" in
  status) status "$@" ;;
  update)
    ! package_install || die 'upload a signed .mbrelease package through /admin/updates'
    if tag="$(version_tag "${1:-}")"; then
      fetch_tags
      commit="$(tag_commit "$tag")"
      [ "$commit" != "$(as_app git rev-parse HEAD)" ] || die "version ${tag#v} is already installed"
      ! is_older "$commit" || die "version ${tag#v} is older than the installed code; use: sudo mobocom downgrade ${tag#v}"
      to_commit "$commit"
      status
    else
      branch="${1:-main}"
      run_update BRANCH="$branch"
      status "$branch"
    fi
    ;;
  versions) ! package_install || die 'this site takes signed packages through /admin/updates'; versions ;;
  downgrade)
    ! package_install || die 'package recovery uses the retained private .package.*/before snapshot; see the recovery guide'
    downgrade "$@"
    status
    ;;
  backup) as_app env MOBOCOM_ENV_FILE="$ENV_FILE" MOBOCOM_APP_DIR="$APP_DIR" bash deploy/ubuntu/backup.sh ;;
  backups)
    for name in $(backup_names); do
      printf '%s  database %s  files %s\n' "$name" "$(du -h "$(backup_dir)/db-$name.dump" | cut -f1)" "$(du -h "$(backup_dir)/storage-$name.tar.gz" 2>/dev/null | cut -f1)"
    done
    ;;
  rollback)
    [ ! -f /etc/mobocom/release-public.pem ] || die 'package recovery uses the retained private .package.*/before snapshot; see the recovery guide'
    target="${1:-}"
    if [ -z "$target" ]; then
      target="$(tail -1 storage/update/history.log 2>/dev/null | awk '{print $2}')"
      [ -n "$target" ] || die "no earlier version is recorded; name a commit: sudo mobocom rollback <commit>"
    fi
    as_app env UPDATE_ROLLBACK_TO="$target" UPDATE_ENV_FILE="$ENV_FILE" MOBOCOM_ENV_FILE="$ENV_FILE" MOBOCOM_APP_DIR="$APP_DIR" bash deploy/ubuntu/update.sh
    ;;
  restore) restore "$@" ;;
  panel) panel "$@" ;;
  *) usage; [ -z "$command" ] || [ "$command" = help ] || exit 2 ;;
esac
