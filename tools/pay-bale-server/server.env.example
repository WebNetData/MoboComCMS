# Server-owned GoOmni2.4.2 connection. Never put a personal access token in Gateway credentials.
MOBOCOM_PAY_BALE_ENABLED=false
MOBOCOM_PAY_BALE_SESSION=
MOBOCOM_PAY_BALE_INSTANCE=
MOBOCOM_PAY_BALE_ACCOUNT=
# Exact numeric peer ID verified to belong to @bam_bmi; never a display name.
MOBOCOM_PAY_BALE_BANK_PEER=
MOBOCOM_PAY_BALE_BANK_ACCOUNT=
# Existing canonical MoboCom ADMIN UserId with current mobocom-pay.manage authority.
MOBOCOM_PAY_BALE_OWNER_USER_ID=
# Independent random webhook destination secret, at least32 characters.
MOBOCOM_PAY_BALE_WEBHOOK_SECRET=
# Set true only after confirming the original bank arm identity and private server login.
MOBOCOM_PAY_BALE_VERIFIED=false
# Optional private JSON registry (1..32 sources); when set it REPLACES singleton binding.
# Exact record keys: id,alias,instanceId,accountId,bankPeerId,bankAccountId,ownerUserId,secret,enabled,verified
# Protocol IDs are strings; bankAccountId/ownerUserId are integers; flags are booleans.
# Each source has a distinct endpoint ?source=ID, instance, bank destination and signing secret.
MOBOCOM_PAY_BALE_SOURCES=
