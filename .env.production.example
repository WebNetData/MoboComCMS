# ===== MoboComCMS — production (Coolify) =====
# Set these in Coolify → Environment Variables. Never commit real values.
# Public URL of this site (used for callbacks & subscription links)
NEXTAUTH_URL=https://your-domain.example
# openssl rand -hex 32
NEXTAUTH_SECRET=

# Cloudflare Turnstile (protects website login and registration when configured)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# PostgreSQL (Coolify internal URL; never public)
DATABASE_URL=postgresql://happvpn:CHANGE_ME@postgres:5432/happvpn

# ===== Plisio (crypto payment gateway) =====
# Get from Plisio Dashboard -> API -> API settings
PLISIO_API_KEY=
PLISIO_SECRET_KEY=
# comma separated crypto currencies e.g. BTC,USDT,LTC,TRX
PLISIO_CURRENCIES=BTC,USDT,LTC
# default fiat currency used for pricing
PLISIO_FIAT_CURRENCY=USD
# NOTE: the webhook is authenticated with Plisio's HMAC `verify_hash` signature
# (PLISIO_SECRET_KEY). There is no extra callback secret to configure.


# ===== FrenzyEx — «درگاه پرداخت ارزی ریالی» (Iranian card-to-card) =====
# Server-side merchant credentials. Never expose these in browser/Mini App/Telegram URLs.
FRENZYEX_API_KEY=
FRENZYEX_CALLBACK_SECRET=
# Optional override; production default is https://frenzy.fastsnap.info
FRENZYEX_BASE_URL=https://frenzy.fastsnap.info
# Used when your plans/products are priced in USD and the provider invoice must be TMN.
# A positive Admin Settings -> usdRateToman takes precedence. Missing/zero DB
# values fall back to this env value.
FRENZYEX_USD_RATE_TOMAN=
# Configure this exact public HTTPS callback in the FrenzyEx merchant panel:
# https://YOUR_DOMAIN/api/payment/frenzyex/webhook

# ===== VPN Panels (Remnawave / PasarGuard) =====
# Panel base URL WITHOUT trailing slash, e.g. https://panel.example.com
PANEL_1_URL=
# REMNAWAVE or PASARGUARD
PANEL_1_TYPE=REMNAWAVE
# Remnawave: API token (Bearer) | PasarGuard: admin username
PANEL_1_TOKEN=
# PasarGuard only: admin password
PANEL_1_PASSWORD=
# PasarGuard only: inbound tags allowed for provisioning (comma separated) - optional
PANEL_1_INBOUNDS=

# Happ uses the official crypt5 API at https://crypto.happ.su/api-v2.php.
# Configure a public HTTPS siteUrl in Admin Settings. No custom client key is required.

# Financial guardrails (DB settings walletTopupMin[.CUR]/walletTopupMax[.CUR] override these)
WALLET_TOPUP_DEFAULT_MIN=1
WALLET_TOPUP_DEFAULT_MAX=5000

# Internal worker endpoint. Use a long random value in production.
# Run POST /api/internal/fulfillment/run about once per minute; it reconciles
# FrenzyEx payments first, then retries fulfillment and cleans stale inventory.
# openssl rand -hex 32
INTERNAL_JOBS_SECRET=
# Generate once and KEEP FOREVER: openssl rand -hex 32
PANEL_CREDENTIAL_KEY=

# Initial seed identity. In production set ADMIN_PASSWORD explicitly and keep demo data disabled.
# WARNING: SEED_DEMO_DATA=true creates demo customers/support accounts — never enable it in production.
# WARNING: rotate NEXTAUTH_SECRET and INTERNAL_JOBS_SECRET before going live, and keep this file out of backups/VCS.
ADMIN_EMAIL=admin@happvpn.com
ADMIN_PASSWORD=
SEED_DEMO_DATA=false

# Node server reminder scheduler. On serverless use the authenticated internal endpoint.
SUBSCRIPTION_REMINDER_SCHEDULER=true

# PostgreSQL encrypted backups; generate and preserve a separate 32-byte hex key.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=storage/backups
BACKUP_SCHEDULER=true
# BACKUP_PG_CONTAINER=happvpn-postgres

# Fresh installs should keep the old shop-domain raw subscription proxy disabled.
ALLOW_LEGACY_HAPP_PROXY=false

# ---- Code packages (Extensions → "Apply & rebuild") ----
# off (default) | git (commit to the repo; Coolify builds on push) | local (write ./src; dev only)
PACKAGE_APPLY_MODE=off
# git mode: fine-grained token with "Contents: read & write" on this repository only
PACKAGE_GIT_TOKEN=
PACKAGE_GIT_REPO=WebNetData/MoboComCMS
PACKAGE_GIT_BRANCH=main
# optional: Coolify deploy webhook (+ API token) to start the deployment explicitly
PACKAGE_DEPLOY_WEBHOOK=
PACKAGE_DEPLOY_TOKEN=
