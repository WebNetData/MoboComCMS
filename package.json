{
  "name": "mobocomcms",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/generate-db-client.cjs && next build",
    "start": "next start -p 3000",
    "postinstall": "npm run extensions:generate && node scripts/generate-db-client.cjs",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.cjs",
    "media:demo": "node --env-file=.env scripts/seed-media-demo.cjs",
    "setup": "npm install && npm run db:push && npm run db:seed && npm run db:migrate-post-categories",
    "test:site": "node --test scripts/site.test.cjs scripts/content-controls.test.cjs scripts/store.test.cjs scripts/builder.test.cjs scripts/packages.test.cjs scripts/forum.test.cjs scripts/seo.test.cjs scripts/ai.test.cjs scripts/payments-sms.test.cjs scripts/forum-community.test.cjs scripts/engagement.test.cjs scripts/shipping.test.cjs scripts/navigation.test.cjs scripts/taxonomy.test.cjs scripts/store-v2.test.cjs scripts/forum-v3.test.cjs scripts/games-v2.test.cjs",
    "arch:check": "node scripts/check-architecture.mjs",
    "check": "npm run extensions:generate && npm run arch:check && npm run source:check && npm run schema:check && npm run money:check && npm run money-ui:check && npm run security:check && npm run audit:check && npm run i18n:check && npm run test:site && npm run test:connected && npm run typecheck && npm run test:backup",
    "extensions:generate": "node scripts/generate-extensions.mjs",
    "predev": "npm run extensions:generate",
    "prebuild": "npm run extensions:generate",
    "source:check": "node scripts/check-source.mjs",
    "schema:check": "node scripts/check-schema-parity.mjs && node scripts/check-money-schema.mjs",
    "money:check": "node scripts/money-self-test.mjs",
    "release:check": "npm run check",
    "extension:new": "node scripts/create-extension.mjs",
    "theme:new": "node scripts/create-theme.mjs",
    "package:zip": "node scripts/pack-package.mjs",
    "test:connected": "node --test scripts/connected.test.cjs",
    "i18n:check": "node scripts/i18n-audit.cjs",
    "test:integration": "node --env-file=.env scripts/site.integration.cjs && node --env-file=.env scripts/content.integration.cjs",
    "money-ui:check": "node scripts/check-money-ui.mjs",
    "security:check": "node scripts/check-security.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:export:sqlite": "node scripts/export-sqlite-snapshot.mjs prisma/dev.db var/sqlite-export.json",
    "db:import:postgres": "node --env-file=.env scripts/import-postgresql-snapshot.mjs var/sqlite-export.json",
    "build:postgres": "npm run extensions:generate && prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "db:migrate-post-categories": "node --env-file=.env scripts/migrate-post-categories.cjs",
    "test:categories": "node --env-file=.env scripts/categories.integration.cjs",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "backup:run": "node --env-file=.env scripts/backup-worker.cjs",
    "backup:restore-test": "node --env-file=.env scripts/restore-backup.cjs",
    "backup:restore-live": "node --env-file=.env scripts/restore-live.cjs",
    "test:backup": "node --test scripts/backup.test.cjs",
    "deploy:preflight": "node scripts/production-preflight.cjs",
    "deploy:migrate": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "deploy:start": "sh deploy/docker-start.sh",
    "deploy:seed": "node prisma/seed.cjs",
    "deploy:encrypt-panel-credentials": "node scripts/encrypt-panel-credentials.cjs"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@prisma/client": "5.22.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/sanitize-html": "2.16.1",
    "bcryptjs": "2.4.3",
    "next": "15.5.25",
    "next-auth": "4.24.15",
    "prisma": "5.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-simple-maps": "5.0.5",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.43",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9 <25"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "packageManager": "npm@10.9.2"
}
