// MoboComCMS – Prisma schema (extended CMS + RBAC)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userGroups UserGroupMember[] @relation("UserGroupMember")
  sitePopupsSeen SitePopupSeen[] @relation("SitePopupSeen")
  promptTemplates PromptTemplate[] @relation("PromptTemplateCreator")
  promptGenerations PromptGeneration[]
  libraryFolders MediaFolder[] @relation("MediaFolderCreator")
  libraryAssets MediaAsset[] @relation("MediaAssetCreator")
  mediaTransfers MediaTransfer[] @relation("MediaTransferActor")
  representedBusinesses BusinessProfile[] @relation("BusinessRepresentative")
  businessRequests BusinessRequest[] @relation("BusinessRequester")
  decidedBusinessRequests BusinessRequest[] @relation("BusinessRequestReviewer")
  businessReviewReplies ItemReview[] @relation("BusinessReviewReply")
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  name           String          @default("")
  role           String          @default("CUSTOMER") // legacy simple role: CUSTOMER | ADMIN
  roleId         Int? // link to Role (fine-grained RBAC)
  status         String          @default("ACTIVE") // ACTIVE | BANNED
  note           String          @default("")
  phone          String          @default("")
  avatarColor    String          @default("#4b45ee")
  walletBalance  Float           @default(0) // legacy USD mirror; use WalletAccount for accounting
  // Telegram login: `telegramId` is the account identity inside the bot and
  // the mini app, the rest is profile sugar for the greeting.
  telegramId     String?         @unique
  telegramUsername String        @default("")
  telegramName   String          @default("")
  telegramPhoto  String          @default("")
  telegramLinkedAt DateTime?
  subscriptionAlerts Boolean @default(true)
  phoneVerifiedAt DateTime?
  smsAlerts      Boolean         @default(true)
  emailAlerts    Boolean         @default(true)
  pushAlerts     Boolean         @default(true)
  recommendationOptIn Boolean    @default(false)
  playbackPrefs  String          @default("{}") // how the member likes to watch: audio side first, subtitle language (media/domain/playback-prefs)
  recommendationListeningOptIn Boolean @default(false) // separate consent: listening history may shape private suggestions
  profileData    String          @default("{}")
  profileCompletedAt DateTime?
  passwordChangedAt DateTime?
  totpSecret     String          @default("")
  totpEnabledAt  DateTime?
  totpBackup     String          @default("[]")
  totpLastStep   Int             @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  orders         Order[] @relation("OrderBuyer")
  assignedOrders Order[] @relation("OrderAssignee")
  subscriptions  Subscription[]
  tickets        Ticket[]        @relation("TicketUser")
  ticketMessages TicketMessage[]
  crmNotes       CrmNote[]
  roleRef        Role?           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  posts          Post[]
  postComments   PostComment[]
  productReviews  ProductReview[]
  productQuestions ProductQuestion[]
  invoices       Invoice[]
  payments       Payment[]
  walletTxs      WalletTx[]
  walletAccounts WalletAccount[]
  apiKeys        ApiKey[]
  reseller       Reseller?
  resellerMembership ResellerMember?
  trialClaim     TrialClaim?
  notifications  UserNotification[]
  notificationMutes UserNotificationMute[]

  @@index([telegramId])
  forumThreads   ForumThread[]
  forumPosts     ForumPost[]
  paymentReceipts PaymentReceipt[]
  forumProfile   ForumProfile?
  forumGroups    ForumGroupMember[]
  forumModerating ForumCategoryModerator[]
  savedViews AdminSavedView[]
  accessRestrictions AccessRestriction[]
  forumReactions ForumReaction[]
  forumBookmarks ForumBookmark[]
  forumFlags     ForumFlag[]
  forumTopicUsers ForumTopicUser[]
  forumBadges    ForumUserBadge[]
  forumConversations ForumConversationUser[]
  forumMessages  ForumMessage[]
  forumPollVotes ForumPollVote[]
  forumCategoryUsers ForumCategoryUser[]
  gameLibrary  GameLibrary[]
  musicPlaylists UserMusicPlaylist[]
  musicListenHistory MusicListenHistory[]
  cinemaWatchProgress CinemaWatchProgress[]
  recentViews UserRecentView[]
  ownedCollections UserCollection[] @relation("CollectionOwner")
  scheduledCollections UserCollection[] @relation("EditorialPublisher")
  editorPatterns EditorPattern[]
  collectionCollaborations UserCollectionCollaborator[]
  followedCollections UserCollectionFollow[]
  savedCollections UserCollectionSave[]
  collectionReactions UserCollectionReaction[]
  userProfile  UserProfile?
  following    UserFollow[] @relation("UserFollowing")
  followers    UserFollow[] @relation("UserFollowers")
  blocking     UserBlock[]  @relation("UserBlocking")
  blockedBy    UserBlock[]  @relation("UserBlockedBy")
  communityPosts CommunityPost[]
  communityComments CommunityComment[]
  communityLikes CommunityLike[]
  communityReports CommunityReport[] @relation("CommunityReporter")
  reviewedCommunityReports CommunityReport[] @relation("CommunityReportReviewer")
  businessProofs BusinessPurchaseProof[] @relation("BusinessProofOwner")
  reviewedBusinessProofs BusinessPurchaseProof[] @relation("BusinessProofReviewer")
  itemReviews    ItemReview[]
  itemReviewHelpfulVotes ItemReviewHelpful[]
  itemFavorites  ItemFavorite[]
  pushSubscriptions PushSubscription[]
  addresses      UserAddress[]
  cart           Cart?

  @@index([phone])
}

model PromptTemplate {
  audienceGroups String @default("")
  createdById Int?
  createdBy User? @relation("PromptTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewNote String @default("")
  trashedStatus String @default("")
  trashedAt DateTime?
  trashedById Int?
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  summary     String   @default("")
  kind        String   @default("TEXT")
  category    String   @default("")
  tags        String   @default("")
  content     String
  example     String   @default("")
  defaults    String   @default("{}")
  showcase    String   @default("{}")
  status      String   @default("DRAFT")
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  version     Int      @default(1)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([createdById, status])
  @@index([status, kind, category, sortOrder])
}

model PromptGeneration {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  kind      String
  input     String
  output    String
  engine    String   @default("STRUCTURED")
  model     String   @default("")
  pinned    Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, pinned, createdAt])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // admin | support | reseller | backup
  nameFa      String   @default("")
  nameEn      String   @default("")
  permissions String   @default("") // comma separated keys
  isSystem    Boolean  @default(false)
  users       User[]
  editorTemplates EditorRoleTemplate[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model UserNotification {
  id         Int       @id @default(autoincrement())
  userId     Int
  kind       String
  dedupeKey  String    @unique
  titleEn    String
  titleFa    String
  bodyEn     String    @default("")
  bodyFa     String    @default("")
  href       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// A missing row means the external copy is allowed. In-app notices are never muted here.
model UserNotificationMute {
  id        Int      @id @default(autoincrement())
  userId    Int
  kind      String
  channel   String   // sms | email | push
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, channel])
  @@index([userId])
}

model Panel {
  id            Int            @id @default(autoincrement())
  name          String
  type          String // REMNAWAVE | PASARGUARD
  url           String
  token         String
  password      String         @default("")
  inbounds      String         @default("")
  // Remnawave "internal squads" (UUIDs or names, comma separated). A user
  // without a squad gets no config, so a plan on this panel needs them.
  internalSquads String        @default("")
  config        String         @default("{}")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  plans         Plan[]
  subscriptions Subscription[]
}

model Plan {
  id             Int             @id @default(autoincrement())
  name           String
  nameEn         String          @default("")
  description    String          @default("")
  descriptionEn  String          @default("")
  trafficGB      Int
  days           Int
  deviceLimit    Int             @default(2)
  price          Float           // legacy display mirror; exact value is priceMinor
  priceMinor     BigInt          @default(0)
  currency       String          @default("USD")
  active         Boolean         @default(true)
  featured       Boolean         @default(false)
  access         String          @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  memberPriceMinor BigInt        @default(0)
  vipGiftDays    Int             @default(0)
  sort           Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  panel          Panel?          @relation(fields: [panelId], references: [id])
  panelId        Int?
  orderItems     OrderItem[]
  orders         Order[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  resellerPrices ResellerPrice[]
  serviceOffers ServiceOffer[]
}

model Order {
  id            Int            @id @default(autoincrement())
  userId        Int
  assigneeId Int?
  assignee User? @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  planId        Int?
  productId     Int? // single-product purchase
  totalAmount   Float          // legacy display mirror; exact value is totalMinor
  totalMinor    BigInt         @default(0)
  currency      String         @default("USD")
  idempotencyKey String?       @unique
  status        String         @default("PENDING")
  provider      String         @default("plisio")
  providerTxnId String         @default("")
  paymentUrl    String         @default("")
  paidCrypto    String         @default("")
  paidAmount    String         @default("")
  meta          String         @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  user          User           @relation("OrderBuyer", fields: [userId], references: [id])
  plan          Plan?          @relation(fields: [planId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  items         OrderItem[]
  subscriptions Subscription[]
  gateway       Gateway?       @relation(fields: [gatewayId], references: [id])
  gatewayId     Int?
  invoice       Invoice?
  payments      Payment[]
  promotionRedemptions PromotionRedemption[]
  productDelivery ProductDelivery?
  deliveryBooking DeliveryBooking?
  lines         OrderLine[]
  events        OrderEvent[]
  returns       ReturnRequest[]
  shipment      Shipment?
  @@index([assigneeId, status])
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  orderId  Int
  planId   Int
  quantity Int   @default(1)
  price    Float // legacy display mirror
  priceMinor BigInt @default(0)
  order    Order @relation(fields: [orderId], references: [id])
  plan     Plan  @relation(fields: [planId], references: [id])
}

model Subscription {
  tickets Ticket[]
  id           Int       @id @default(autoincrement())
  userId       Int
  planId       Int
  orderId      Int?
  panelId      Int?
  status       String    @default("ACTIVE")
  username     String
  email        String?
  trafficLimit Int       @default(0)
  trafficUsed  Int       @default(0)
  deviceLimit  Int       @default(0)
  expiresAt    DateTime
  subToken     String    @unique
  panelSubUrl  String    @default("")
  configLinks  String    @default("[]")
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  plan         Plan      @relation(fields: [planId], references: [id])
  order        Order?    @relation(fields: [orderId], references: [id])
  panel        Panel?    @relation(fields: [panelId], references: [id])
  // set when a reseller created this account for their own customer
  resellerId   Int?
  reseller     Reseller? @relation(fields: [resellerId], references: [id])
}

/// A reseller (agency) account: creates subscriptions for its own customers
/// under admin-defined quotas (volume, account count, per-account limits).
model Reseller {
  id                     Int             @id @default(autoincrement())
  userId                 Int             @unique
  active                 Boolean         @default(true)
  // pricing: percentage off the list price, or explicit per-plan prices
  priceMode              String          @default("DISCOUNT") // DISCOUNT | CUSTOM
  discountPercent        Float           @default(0)
  // quotas — 0 means unlimited
  maxAccounts            Int             @default(0)
  maxActiveAccounts      Int             @default(0)
  trafficQuotaGB         Int             @default(0) // total GB the reseller may hand out
  maxTrafficPerAccountGB Int             @default(0) // cap per account (e.g. 100)
  allowUnlimitedTraffic  Boolean         @default(false) // may create accounts with 0 = unlimited
  maxDaysPerAccount      Int             @default(0) // cap on duration (e.g. 31)
  allowUnlimitedDays     Boolean         @default(false)
  maxDevicesPerAccount   Int             @default(0)
  note                   String          @default("")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  user                   User            @relation(fields: [userId], references: [id])
  prices                 ResellerPrice[]
  subscriptions          Subscription[]
  members                ResellerMember[]
}

model ResellerMember {
  id Int @id @default(autoincrement())
  resellerId Int
  userId Int @unique
  permissions String @default("")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resellerId, active])
}

model ResellerPrice {
  id         Int      @id @default(autoincrement())
  resellerId Int
  planId     Int
  price      Float // legacy display mirror
  priceMinor BigInt @default(0)
  reseller   Reseller @relation(fields: [resellerId], references: [id])
  plan       Plan     @relation(fields: [planId], references: [id])

  @@unique([resellerId, planId])
}

model TrialClaim {
  id Int @id @default(autoincrement())
  userId Int @unique
  planId Int
  orderId Int @unique
  status String @default("PENDING")
  subscriptionId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user User @relation(fields: [userId], references: [id])
}

model Promotion {
  id Int @id @default(autoincrement())
  code String @unique
  active Boolean @default(true)
  kind String @default("PERCENT")
  percentBps Int @default(0)
  amountMinor BigInt @default(0)
  currency String @default("USD")
  planId Int?
  minSubtotalMinor BigInt @default(0)
  maxUses Int @default(0)
  perUserLimit Int @default(1)
  membersOnly Boolean @default(false)
  reservedCount Int @default(0)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  redemptions PromotionRedemption[]
}

model PromotionRedemption {
  id Int @id @default(autoincrement())
  promotionId Int
  userId Int
  orderId Int @unique
  status String @default("RESERVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  promotion Promotion @relation(fields: [promotionId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  @@index([promotionId, userId, status])
}

model ReferralCode {
  id Int @id @default(autoincrement())
  ownerId Int @unique
  code String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

model ReferralAttribution {
  id Int @id @default(autoincrement())
  referredUserId Int @unique
  referrerUserId Int
  code String
  rewardBps Int
  rewardOrderId Int?
  rewardMinor BigInt @default(0)
  rewardCurrency String @default("USD")
  rewardedAt DateTime?
  createdAt DateTime @default(now())
  @@index([referrerUserId, createdAt])
}

model ServiceOffer {
  id Int @id @default(autoincrement())
  ownerKey String
  planId Int
  nameFa String
  nameEn String
  trafficGB Int
  days Int
  deviceLimit Int
  priceMinor BigInt
  currency String @default("USD")
  cardPriceMinor BigInt?
  cardCurrency String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  plan Plan @relation(fields: [planId], references: [id])
  sales ResellerSale[]
  @@index([ownerKey, active, sortOrder])
}

model ResellerBot {
  id Int @id @default(autoincrement())
  resellerId Int @unique
  botId String @unique
  username String
  tokenCipher String
  webhookSecret String
  ownerTelegramId String
  brandName String
  publicUrl String @default("")
  cardNumber String
  cardHolder String
  active Boolean @default(false)
  lastError String @default("")
  installedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ResellerSale {
  id Int @id @default(autoincrement())
  resellerId Int
  offerId Int
  botId Int
  telegramUserId String
  telegramChatId String
  sourceUpdateId String?
  status String @default("AWAITING_RECEIPT")
  receiptFileId String @default("")
  terms String @default("{}")
  retailMinor BigInt @default(0)
  currency String @default("USD")
  locale String @default("en")
  lastError String @default("")
  deliveredAt DateTime?
  reviewedAt DateTime?
  reviewerUserId Int?
  reviewerTelegramId String @default("")
  reviewDecision String @default("")
  orderId Int?
  subscriptionId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  offer ServiceOffer @relation(fields: [offerId], references: [id])
  @@index([resellerId, status, createdAt])
  @@index([botId, telegramUserId, createdAt])
  @@unique([botId, sourceUpdateId])
}

model ResellerBotUpdate {
  id Int @id @default(autoincrement())
  botId Int
  updateId String
  createdAt DateTime @default(now())
  @@unique([botId, updateId])
  @@index([createdAt])
}

model Ticket {
  subscriptionId Int?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionUsername String @default("")
  subscriptionLink String @default("")
  productId Int?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  department String @default("GENERAL")
  customFields String @default("{}")
  device String?
  issueType String?
  id        Int             @id @default(autoincrement())
  userId    Int
  subject   String
  status    String          @default("OPEN") // OPEN | PENDING | CLOSED
  priority  String          @default("normal")
  assignedToId Int?
  firstResponseAt DateTime?
  lastCustomerAt DateTime?
  lastStaffAt DateTime?
  closedAt DateTime?
  slaDueAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  user      User            @relation("TicketUser", fields: [userId], references: [id])
  messages  TicketMessage[]
  @@index([department, status, updatedAt])
  @@index([assignedToId, status])
}

model TicketDepartment {
  id Int @id @default(autoincrement())
  slug String @unique
  nameFa String
  nameEn String
  descriptionFa String @default("")
  descriptionEn String @default("")
  active Boolean @default(true)
  requiresSubscription Boolean @default(false)
  requiresProduct Boolean @default(false)
  fields String @default("[]")
  roleIds String @default("[]")
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    Int
  fromAdmin Boolean  @default(false)
  internal Boolean @default(false)
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  attachments TicketAttachment[]
}

model TicketAttachment {
  id Int @id @default(autoincrement())
  messageId Int
  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename String @unique
  originalName String
  mimeType String
  size Int
  createdAt DateTime @default(now())
  @@index([messageId])
}

model CrmNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  adminId   Int
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model WebhookLog {
  id        Int      @id @default(autoincrement())
  source    String   @default("plisio")
  payload   String
  valid     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int
  actorEmail  String
  action      String
  targetType  String
  targetId    String   @default("")
  requestId   String   @default("")
  ip          String   @default("")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([requestId])
}

// ============ CMS ============
model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  titleEn   String   @default("")
  content   String   @default("")
  contentEn String   @default("")
  // How this page is written: "legacy" (HTML in content) or "blocks-v1" (a MoboCom document in contentDocument;
  // content then holds HTML generated from it for search, feeds and readers that only know HTML).
  editorFormat    String   @default("legacy")
  contentDocument String   @default("")
  status    String   @default("PUBLISHED") // DRAFT | PUBLISHED
  showInNav Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PostCategory {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  nameEn    String   @default("")
  createdAt DateTime @default(now())
  posts     Post[]
  parentId  Int?
  parent    PostCategory? @relation("PostCategoryTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children  PostCategory[] @relation("PostCategoryTree")
  assignments PostCategoryAssignment[]

  @@index([parentId])
}

model Post {
  /// Site group keys that may see this item, as JSON; empty for everyone.
  audienceGroups String @default("")
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  titleEn     String        @default("")
  excerpt     String        @default("")
  excerptEn   String        @default("")
  content     String
  contentEn   String        @default("")
  // How this article is written: "legacy" (HTML in content) or "blocks-v1" (a MoboCom document in contentDocument;
  // content then holds HTML generated from it for search, feeds and readers that only know HTML).
  editorFormat    String        @default("legacy")
  // A code of the owner's POST_FORMAT list (article, news, review, video…); its family decides the post's own facts,
  // kept in formatData (validated JSON: review score/pros/cons/verdict, video address, news source, interview guest).
  format          String        @default("ARTICLE")
  formatData      String        @default("{}")
  contentDocument String        @default("")
  cover       String        @default("")
  status      String        @default("PUBLISHED") // DRAFT | PUBLISHED
  featured    Boolean       @default(false)
  access      String        @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  views       Int           @default(0)
  authorId    Int?
  categoryId  Int?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  author      User?         @relation(fields: [authorId], references: [id])
  category    PostCategory? @relation(fields: [categoryId], references: [id])
  categories  PostCategoryAssignment[]
  editProposal PostEditProposal?
  comments    PostComment[]
  itemLinks   PostItemLink[]
  // A delete asked by an author: status is TRASHED, the status it had is kept here until a manager decides.
  trashedStatus String    @default("")
  trashedAt     DateTime?
  trashedById   Int?

  @@index([status, publishedAt])
  @@index([format])
}

model PostItemLink {
  id        Int    @id @default(autoincrement())
  postId    Int
  itemType  String
  itemId    Int
  position  Int    @default(0)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, itemType, itemId])
  @@index([itemType, itemId, position])
}

model PostComment {
  id        Int       @id @default(autoincrement())
  postId    Int
  userId    Int
  parentId  Int?
  body      String
  status    String    @default("PENDING") // PENDING | APPROVED | REJECTED | DELETED (by its author; an empty placeholder kept only while it has replies)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    PostComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   PostComment[] @relation("CommentReplies")
  @@index([postId, status, createdAt])
  @@index([parentId])
}

model PostCategoryAssignment {
  postId     Int
  categoryId Int
  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  nameEn    String    @default("")
  createdAt DateTime  @default(now())
  products  Product[]
  extraProducts ProductCategoryAssignment[]
  parentId  Int?
  parent    ProductCategory? @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("ProductCategoryTree")
  attributeGroupId Int?
  attributeGroup ProductAttributeGroup? @relation(fields: [attributeGroupId], references: [id], onDelete: SetNull)
  image     String @default("")
  icon      String @default("")
  description String @default("")
  sortOrder Int @default(0)
  // The half of the shop this category is in: '' (not decided) | PHYSICAL | VIRTUAL. A root decides; its descendants carry the same value.
  kind      String @default("")
  @@index([parentId])
  @@index([attributeGroupId])
}

/// A further category a product is listed under; the main one stays Product.categoryId.
model ProductCategoryAssignment {
  productId  Int
  categoryId Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductAttributeGroup {
  id        Int @id @default(autoincrement())
  name      String
  nameEn    String @default("")
  appliesTo String @default("ANY") // ANY | VIRTUAL | PHYSICAL
  // Validated array of {key, label, labelEn, kind, options, required}.
  fields    String @default("[]")
  categories ProductCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Product {
  groupPrices ProductGroupPrice[] @relation("ProductGroupPrice")
  /// Site group keys that may see this item, as JSON; empty for everyone.
  audienceGroups String @default("")
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  name          String
  nameEn        String           @default("")
  description   String           @default("")
  descriptionEn String           @default("")
  price         Float            @default(0) // legacy display mirror; exact value is priceMinor
  priceMinor    BigInt           @default(0)
  currency      String           @default("USD")
  image         String           @default("")
  gallery       String           @default("[]")
  stock         Int              @default(-1) // -1 = unlimited
  active        Boolean          @default(true)
  featured      Boolean          @default(false)
  sortOrder     Int              @default(0)
  categoryId    Int?
  // Further categories the product is also listed under (WordPress-like ticks); categoryId stays its main one.
  extraCategories ProductCategoryAssignment[]
  kind          String @default("VIRTUAL") // VIRTUAL | PHYSICAL
  access        String @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  memberPriceMinor BigInt @default(0) // VIP price; 0 = none
  vipGiftDays   Int @default(0) // VIP days granted with a paid purchase
  specifications String @default("{}") // attribute keys inherited from category group
  brandId       Int?
  sku           String @default("")
  compareAtMinor BigInt @default(0) // list price shown struck through; 0 = no discount
  saleEndsAt    DateTime? // end of a timed "amazing offer"
  shortDescription String @default("")
  warranty      String @default("")
  weightGrams   Int @default(0)
  maxPerOrder   Int @default(0) // 0 = no per-order limit
  lowStockAt    Int @default(0) // 0 = store default threshold
  seoTitle      String @default("")
  seoDescription String @default("")
  views         Int @default(0)
  soldCount     Int @default(0)
  faqs          String @default("[]")
  digitalMode   String @default("MANUAL") // VIRTUAL goods: MANUAL (staff delivers each order) | CODES (a code from the pool is delivered on payment)
  sellerId      Int? // marketplace seller; null = the site itself
  approval      String @default("APPROVED") // APPROVED | PENDING | REJECTED (seller products are reviewed)
  approvalNote  String @default("")
  pricingMode   String @default("FIXED") // FIXED | FX (price follows a foreign cost and the live rate)
  fxCurrency    String @default("") // cost currency: USD, EUR, …
  fxAmountMinor BigInt @default(0) // foreign cost in minor units (cents)
  fxCompareAtMinor BigInt @default(0) // foreign list price shown struck through; 0 = none
  fxMemberMinor BigInt @default(0) // foreign VIP price; 0 = none
  markupBps     Int @default(0) // profit percentage in basis points (1250 = 12.5%)
  // What an order of this product needs from the buyer: validated array of {key, label, labelEn, kind, required, help, options}.
  orderFields   String @default("[]")
  // A service whose foreign amount the buyer types (paying a foreign site): priced from that amount, the live rate and the two markups below.
  openAmount    Boolean @default(false)
  openCurrencies String @default("") // comma list of the currencies the buyer may type, e.g. USD,EUR
  openMinMinor  BigInt @default(0) // smallest amount, in minor units of the foreign currency
  isService    Boolean @default(false) // a virtual product that is a piece of work done by staff; listed under Services in the admin
  openMaxMinor  BigInt @default(0) // largest amount (0 = no upper limit)
  markupFixedMinor BigInt @default(0) // fixed profit added after the percentage, in the selling currency
  repricedAt    DateTime?
  seller        Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  reviews       ProductReview[]
  pricePoints   ProductPricePoint[]
  bundles ProductBundle[] @relation("ProductBundleSource")
  bundleComponents ProductBundleComponent[] @relation("BundleComponentProduct")
  outgoingRelationships ProductRelationship[] @relation("ProductRelationshipSource")
  incomingRelationships ProductRelationship[] @relation("ProductRelationshipTarget")
  questions     ProductQuestion[]
  digitalCodes  ProductDigitalCode[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  brand         ProductBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  cartLines     CartLine[]
  orderLines    OrderLine[]
  orders        Order[]
  invoices      Invoice[]
  tickets       Ticket[]

  @@index([brandId])
  @@index([sku])
  @@index([active, soldCount])
  @@index([sellerId])
  @@index([pricingMode])
  @@index([isService])
}

/// Named fixed component selections; Store remains the pricing/cart/order owner.
model ProductBundle {
  id Int @id @default(autoincrement())
  productId Int
  name String
  nameEn String @default("")
  active Boolean @default(false)
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product Product @relation("ProductBundleSource", fields: [productId], references: [id], onDelete: Cascade)
  components ProductBundleComponent[]
  @@index([productId, active, position, id])
}

model ProductBundleComponent {
  id Int @id @default(autoincrement())
  bundleId Int
  productId Int?
  variantKey Int @default(0)
  quantity Int @default(1)
  position Int @default(0)
  bundle ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product? @relation("BundleComponentProduct", fields: [productId], references: [id], onDelete: SetNull)
  @@unique([bundleId, productId, variantKey])
  @@index([bundleId, position, id])
  @@index([productId])
}

/// Directed editorial assertions; purchase-derived suggestions remain in Recommendations.
model ProductRelationship {
  id Int @id @default(autoincrement())
  productId Int
  targetId Int
  kind String
  position Int @default(0)
  product Product @relation("ProductRelationshipSource", fields: [productId], references: [id], onDelete: Cascade)
  target Product @relation("ProductRelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([productId, kind, targetId])
  @@index([productId, kind, position, id])
  @@index([targetId])
}

/// Observed regular public prices; variantId 0 identifies the base product.
model ProductPricePoint {
  id          Int      @id @default(autoincrement())
  productId   Int
  variantId   Int      @default(0)
  amountMinor BigInt
  currency    String
  recordedAt  DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, variantId, recordedAt, id])
}

// The pool of codes (gift cards, licence keys) a product delivers by itself. A row without an order is on the
// shelf; Product.stock of a CODES product always equals the rows on the shelf minus the units held by open orders.
model ProductDigitalCode {
  id          Int       @id @default(autoincrement())
  productId   Int
  variantId   Int?
  secret      String // encrypted; shown to the buyer of the order and to store staff only
  fingerprint String // keyed hash of the code: the same code is refused twice for one product
  orderId     Int?
  orderLine   Int?
  deliveredAt DateTime?
  // Taken back from the buyer (a refund, or replaced by staff): void, and never on the shelf again.
  returnedAt  DateTime?
  returnId    Int?
  returnNote  String    @default("")
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, fingerprint])
  @@index([productId, variantId, orderId])
  @@index([orderId])
}

model ProductVariant {
  id          Int @id @default(autoincrement())
  productId   Int
  sku         String @unique
  name        String
  nameEn      String @default("")
  // Selected attribute keys and values, e.g. {"color":"blue"}.
  attributes  String @default("{}")
  price       Float @default(0)
  priceMinor  BigInt @default(0)
  memberPriceMinor BigInt @default(0)
  compareAtMinor BigInt @default(0)
  fxAmountMinor BigInt @default(0) // foreign cost of this variant when the product is FX-priced; 0 = product cost
  image       String @default("") // photo of this variant (shown when it is selected)
  stock       Int @default(-1)
  active      Boolean @default(true)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]
  @@index([productId, active])
}

model ProductReview {
  id        Int @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  criteria  String @default("{}") // quality, value and usability scores (1–5)
  title     String @default("")
  body      String
  status    String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
}

model ProductQuestion {
  id        Int @id @default(autoincrement())
  productId Int
  userId    Int?
  guestName String @default("")
  body      String
  answer    String @default("")
  status    String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([productId, status, createdAt])
}

model ProductDelivery {
  id          Int @id @default(autoincrement())
  orderId     Int @unique
  status      String @default("PENDING") // PENDING | PROCESSING | DELIVERED
  address     String @default("")
  trackingCode String @default("")
  deliveryNote String @default("")
  scheduledDate String @default("") // chosen delivery day, YYYY-MM-DD
  scheduledSlot String @default("") // chosen time window label
  digitalDelivery String @default("") // encrypted fulfillment details, owner/admin only
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============ FINANCE / BILLING ============
model Gateway {
  id           Int       @id @default(autoincrement())
  name         String
  provider     String    @default("PLISIO") // PLISIO | FRENZYEX | MANUAL
  apiKey       String    @default("")
  secretKey    String    @default("")
  /// Login user for gateways that need one (Bank Mellat).
  accountUser  String    @default("")
  /// Provider settings that do not fit the columns above (JSON; installment gateways).
  config       String    @default("{}")
  fiat         String    @default("USD")
  currencies   String    @default("")
  feePercent   Float     @default(0) // legacy display mirror
  feeBps       Int       @default(0)
  minAmount    Float     @default(0) // legacy display mirror
  minAmountMinor BigInt  @default(0)
  instructions String    @default("")
  active       Boolean   @default(true)
  isDefault    Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]
}

model Invoice {
  id            Int       @id @default(autoincrement())
  number        String    @unique
  userId        Int
  orderId       Int?      @unique
  planId        Int?
  productId     Int?
  subtotal      Float     @default(0) // legacy display mirrors; exact values are *Minor
  subtotalMinor BigInt    @default(0)
  discount      Float     @default(0)
  discountMinor BigInt    @default(0)
  tax           Float     @default(0)
  taxMinor      BigInt    @default(0)
  total         Float     @default(0)
  totalMinor    BigInt    @default(0)
  // how much of the total was covered by the customer's wallet credit
  walletApplied Float     @default(0)
  walletAppliedMinor BigInt @default(0)
  currency      String    @default("USD")
  idempotencyKey String?  @unique
  status        String    @default("UNPAID") // DRAFT | UNPAID | PAID | VOID | REFUNDED
  gatewayId     Int?
  providerTxnId String    @default("")
  paymentUrl    String    @default("")
  paidCrypto    String    @default("")
  paidAmount    Float     @default(0)
  paidAmountMinor BigInt   @default(0)
  notes         String    @default("")
  kind          String    @default("BILLING") // BILLING | WALLET_TOPUP
  /// What the invoice is for, set by staff (empty: worked out from the order, see billing/domain/invoice-subject.ts).
  title         String    @default("")
  detail        String    @default("")
  /// An unpaid invoice closes by itself at this time (exchange-rate items: a few hours after checkout).
  expiresAt     DateTime?
  /// Toman per unit of each foreign currency the price followed, at checkout: {"USD": 98000}. Empty: not rate-bound.
  fxRates       String    @default("")
  /// Why the invoice was closed by a rule: FX_RATE | EXPIRED | OVERDUE (empty: by hand or never).
  closedReason  String    @default("")
  recurringId   Int?
  createdBy     Int?
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  order         Order?    @relation(fields: [orderId], references: [id])
  plan          Plan?     @relation(fields: [planId], references: [id])
  product       Product?  @relation(fields: [productId], references: [id])
  gateway       Gateway?  @relation(fields: [gatewayId], references: [id])
  payments      Payment[]
  receipts      PaymentReceipt[]

  @@index([status, expiresAt])
  @@index([recurringId])
}

/// An invoice staff issue to a customer again and again (weekly, monthly, every 3, 6 or 12 months).
model RecurringInvoice {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  detail      String    @default("")
  amountMinor BigInt
  currency    String    @default("IRT")
  interval    String    @default("MONTH") // WEEK | MONTH | QUARTER | HALF | YEAR
  nextAt      DateTime
  endsAt      DateTime?
  maxCount    Int       @default(0) // 0: until stopped
  issuedCount Int       @default(0)
  dueDays     Int       @default(7)
  gatewayId   Int?
  notes       String    @default("")
  active      Boolean   @default(true)
  lastInvoiceId Int?
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([active, nextAt])
  @@index([userId])
}

model Payment {
  id             Int       @id @default(autoincrement())
  userId         Int?
  orderId        Int?
  invoiceId      Int?
  gatewayId      Int?
  provider       String    @default("PLISIO")
  providerTxnId  String    @default("")
  amount         Float     @default(0) // legacy display mirror
  amountMinor    BigInt    @default(0)
  currency       String    @default("USD")
  cryptoCurrency String    @default("")
  cryptoAmount   String    @default("")
  fee            Float     @default(0) // legacy display mirror
  feeMinor       BigInt    @default(0)
  eventKey       String?   @unique
  status         String    @default("PENDING") // PENDING | PROCESSED | CONFIRMED | FAILED | REFUNDED
  raw            String    @default("{}")
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  user           User?     @relation(fields: [userId], references: [id])
  order          Order?    @relation(fields: [orderId], references: [id])
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id])
  gateway        Gateway?  @relation(fields: [gatewayId], references: [id])
}

model WalletTx {
  id           Int      @id @default(autoincrement())
  userId       Int
  amount       Float // legacy display mirror; + credit / - debit
  amountMinor  BigInt   @default(0)
  balanceAfter Float    @default(0) // legacy display mirror
  balanceAfterMinor BigInt @default(0)
  currency     String   @default("USD")
  idempotencyKey String? @unique
  type         String   @default("TOPUP") // TOPUP | PURCHASE | REFUND | ADMIN_CREDIT | ADMIN_DEBIT | RENEWAL
  status       String   @default("DONE") // DONE | PENDING | PROCESSING | FAILED
  description  String   @default("")
  orderId      Int?
  invoiceId    Int?
  adminId      Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String    @default("default")
  prefix     String    @default("")
  token      String    @unique
  active     Boolean   @default(true)
  requests   Int       @default(0)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  category  String   @default("SERVER") // SERVER | MARKETING | SALARY | OTHER
  amount    Float    @default(0) // legacy display mirror
  amountMinor BigInt  @default(0)
  currency  String   @default("USD")
  spentAt   DateTime @default(now())
  note      String   @default("")
  createdBy Int?
  createdAt DateTime @default(now())
}

// ============ FINANCIAL / DELIVERY INFRASTRUCTURE ============
model WalletAccount {
  id           Int      @id @default(autoincrement())
  userId       Int
  currency     String
  balanceMinor BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@index([currency])
}

model InvoiceSequence {
  year      Int      @id
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

/// Durable webhook inbox. A provider event is claimed once and can be retried
/// after a worker crash without settling the same financial event twice.
model WebhookInbox {
  id          Int       @id @default(autoincrement())
  provider    String
  eventKey    String
  status      String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  payload     String
  attempts    Int       @default(0)
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([provider, eventKey])
  @@index([status, lockedAt])
}

/// Durable side-effect queue. Payment settlement is committed before external
/// VPN provisioning/product delivery; workers can safely retry failed jobs.
model FulfillmentJob {
  id             Int       @id @default(autoincrement())
  kind           String // PROVISION_SUBSCRIPTION | RENEW_SUBSCRIPTION | DELIVER_PRODUCT | RESELLER_PROVISION
  dedupeKey      String    @unique
  status         String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  payload        String    @default("{}")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  lastError      String    @default("")
  orderId        Int?
  invoiceId      Int?
  subscriptionId Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([orderId])
  @@index([invoiceId])
}

/// Reserves finite stock while an invoice is open so concurrent checkouts
/// cannot oversell the last unit.
model InventoryReservation {
  id        Int      @id @default(autoincrement())
  orderId   Int
  line      Int      @default(0) // order line index; single-item orders use 0
  productId Int
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantFinite Boolean @default(false)
  quantity  Int      @default(1)
  finite    Boolean  @default(true)
  status    String   @default("HELD") // HELD | CONSUMED | RELEASED
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([orderId, line])
  @@index([productId, status])
  @@index([expiresAt, status])
}

// Map markers for landing globe
model MapLocation {
  id        Int      @id @default(autoincrement())
  country   String // e.g. Germany
  countryFa String   @default("")
  flag      String   @default("🏳️")
  lat       Float
  lng       Float
  city      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Independent form definitions and private submissions.
model SiteForm {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  title       String
  description String           @default("")
  fields      String           @default("[]")
  published   Boolean          @default(false)
  successText String           @default("پیام شما با موفقیت ثبت شد.")
  settings    String           @default("{}") // steps, notifications, limits, schedule (see modules/forms/domain)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]
  uploads     FormUpload[]
  bookings    FormBooking[]
}

model FormBooking {
  id           Int            @id @default(autoincrement())
  formId       Int
  fieldId      String
  slot         String // "YYYY-MM-DD HH:MM" of an appointment field
  seat         Int // 1 … capacity; the unique key below is what stops a turn from being overbooked
  submissionId Int
  createdAt    DateTime       @default(now())
  form         SiteForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([formId, fieldId, slot, seat])
  @@index([submissionId])
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  formId    Int
  data      String
  read      Boolean  @default(false)
  status    String   @default("NEW") // NEW | READ | STARRED | ARCHIVED | SPAM
  note      String   @default("")
  userId    Int?
  ipHash    String   @default("")
  // Paid forms and the work on an answer (see modules/forms)
  amountMinor BigInt  @default(0) // what the answers cost, in `currency`
  currency    String  @default("")
  pricing     String  @default("") // the bill as it was priced: lines with amounts and rates (JSON)
  payStatus   String  @default("") // '' (nothing to pay) | UNPAID | PAID
  orderId     Int?
  paidAt      DateTime?
  stage       String  @default("") // '' | OPEN | IN_PROGRESS | DONE | REJECTED
  assigneeId  Int?
  reply       String  @default("") // what staff wrote back to the sender
  secrets     String  @default("") // encrypted answers of secret fields
  secretsErasedAt DateTime?
  score       Int     @default(0) // quiz points, and the most that could be had
  scoreMax    Int     @default(0)
  createdAt DateTime @default(now())
  form      SiteForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  uploads   FormUpload[]
  bookings  FormBooking[]

  @@index([formId, createdAt])
  @@index([formId, status])
  @@index([userId])
  @@index([orderId])
  @@index([formId, stage])
}

model FormUpload {
  id           String          @id // stored file name (uuid + extension)
  formId       Int
  submissionId Int?
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())
  form         SiteForm        @relation(fields: [formId], references: [id], onDelete: Cascade)
  submission   FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([submissionId])
  @@index([createdAt])
}

model SubscriptionReminder {
  id             String   @id
  subscriptionId Int
  kind           String
  status         String   @default("CLAIMED")
  attempts       Int      @default(1)
  retryAt        DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([status, retryAt])
  @@index([subscriptionId])
}

model ServiceIncident {
  id Int @id @default(autoincrement())
  panelId Int?
  titleFa String
  titleEn String
  messageFa String
  messageEn String
  status String @default("INVESTIGATING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([panelId, status])
}


// ---------------------------------------------------------------- VIP membership

/// Paid VIP membership plans (site-wide premium access).
model MembershipPlan {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  name          String
  nameEn        String   @default("")
  description   String   @default("")
  descriptionEn String   @default("")
  days          Int
  priceMinor    BigInt   @default(0)
  currency      String   @default("USD")
  perks         String   @default("[]")
  highlight     Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

/// One VIP period. A user is a member while now is between startsAt and endsAt (and not revoked).
model UserMembership {
  id        Int       @id @default(autoincrement())
  userId    Int
  planId    Int?
  source    String    @default("PURCHASE") // PURCHASE | GIFT | ADMIN
  startsAt  DateTime  @default(now())
  endsAt    DateTime
  orderId   Int?
  dedupeKey String?   @unique
  note      String    @default("")
  revokedAt DateTime?
  createdBy Int?
  createdAt DateTime  @default(now())

  @@index([userId, endsAt])
  @@index([orderId])
}

// ---------------------------------------------------------------- Music

model MusicArtist {
  mergedIntoId Int?
  mergedInto MusicArtist? @relation("MusicArtistMerges", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  aliases MusicArtist[] @relation("MusicArtistMerges")
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  name      String
  nameEn    String       @default("")
  bio       String       @default("")
  image     String       @default("")
  cover     String       @default("")
  featured  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  albums    MusicAlbum[]
  tracks    MusicTrack[]
  credits   MusicCredit[]
  celebrity Celebrity?
  // The staff member who created the item; a section author manages only the items they created.
  createdById Int?
  @@index([createdById])
}

model MusicAlbum {
  /// Site group keys that may see this item, as JSON; empty for everyone.
  audienceGroups String @default("")
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  title       String
  titleEn     String       @default("")
  artistId    Int
  cover       String       @default("")
  year        Int?
  genre       String       @default("")
  // A code of the owner's ALBUM_TYPE list (ALBUM, EP, SINGLE, …).
  albumType   String       @default("ALBUM")
  description String       @default("")
  access      String       @default("PUBLIC") // PUBLIC | MEMBERS
  status      String       @default("PUBLISHED")
  featured    Boolean      @default(false)
  views       Int          @default(0)
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  artist      MusicArtist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      MusicTrack[]
  // The staff member who created the item; a section author manages only the items they created.
  createdById Int?
  // A delete asked by an author: status is TRASHED, the status it had is kept here until a manager decides.
  trashedStatus String    @default("")
  trashedAt     DateTime?
  trashedById   Int?

  @@index([artistId])
  @@index([status, publishedAt])
  @@index([createdById])
}

/// Who else made a song, beside its main artist: an artist profile in a role of the owner's CREDIT_ROLE list
/// (featured artist, composer, lyricist, arranger, …), in the order the song lists them.
model MusicCredit {
  id        Int         @id @default(autoincrement())
  trackId   Int
  artistId  Int
  role      String
  sortOrder Int         @default(0)
  track     MusicTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist    MusicArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId, role])
  @@index([artistId, role])
}

model MusicTrack {
  /// Site group keys that may see this item, as JSON; empty for everyone.
  audienceGroups String @default("")
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  title       String
  titleEn     String      @default("")
  artistId    Int
  albumId     Int?
  trackNo     Int         @default(0)
  cover       String      @default("")
  audioUrl    String      @default("")
  audioHqUrl  String      @default("")
  duration    Int         @default(0)
  genre       String      @default("")
  lyrics      String      @default("")
  access      String      @default("PUBLIC")
  status      String      @default("PUBLISHED")
  featured    Boolean     @default(false)
  plays       Int         @default(0)
  downloads   Int         @default(0)
  publishedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  artist      MusicArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album       MusicAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  userPlaylistItems UserMusicPlaylistTrack[]
  releaseNotification MusicTrackReleaseNotification?
  listenHistory MusicListenHistory[]
  credits     MusicCredit[]
  // The staff member who created the item; a section author manages only the items they created.
  createdById Int?
  // A delete asked by an author: status is TRASHED, the status it had is kept here until a manager decides.
  trashedStatus String    @default("")
  trashedAt     DateTime?
  trashedById   Int?

  @@index([artistId])
  @@index([albumId, trackNo])
  @@index([status, publishedAt])
  @@index([createdById])
}

model MusicPlaylist {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  titleEn     String   @default("")
  cover       String   @default("")
  description String   @default("")
  trackIds    String   @default("[]")
  access      String   @default("PUBLIC")
  status      String   @default("PUBLISHED")
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model MusicTrackReleaseNotification {
  trackId     Int        @id
  dueAt       DateTime
  lastUserId  Int        @default(0)
  completedAt DateTime?
  track       MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([completedAt, dueAt])
}

model MusicListenHistory {
  userId       Int
  trackId      Int
  playCount    Int        @default(1)
  firstPlayedAt DateTime @default(now())
  lastPlayedAt DateTime   @default(now())
  positionSeconds Int    @default(0)
  durationSeconds Int    @default(0)
  progressUpdatedAt DateTime?
  completedAt DateTime?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track        MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, lastPlayedAt])
}

model UserMusicPlaylist {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    UserMusicPlaylistTrack[]

  @@index([userId, updatedAt])
}

model UserMusicPlaylistTrack {
  playlistId Int
  trackId    Int
  position   Int
  addedAt    DateTime @default(now())
  playlist   UserMusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      MusicTrack        @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([playlistId, position])
  @@index([trackId])
}

model UserCollection {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  title       String
  description String   @default("")
  cover       String   @default("")
  shareToken  String?  @unique
  visibility  String   @default("PRIVATE") // PRIVATE | UNLISTED | PUBLIC | EDITORIAL
  // Written by the site's staff in the admin panel: a draft while PRIVATE, published as EDITORIAL; any staff member with a content permission edits it.
  staffAuthored Boolean @default(false)
  publishAt DateTime?
  scheduledById Int?
  scheduleAuthorizedAt DateTime?
  scheduleError String @default("")
  scheduledBy User? @relation("EditorialPublisher", fields: [scheduledById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  owner       User     @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items       UserCollectionItem[]
  collaborators UserCollectionCollaborator[]
  followers   UserCollectionFollow[]
  saves       UserCollectionSave[]
  reactions   UserCollectionReaction[]

  @@index([ownerId, updatedAt])
  @@index([visibility, updatedAt])
}

model UserCollectionItem {
  id           Int      @id @default(autoincrement())
  collectionId Int
  itemType     String
  itemId       Int
  position     Int
  addedAt      DateTime @default(now())
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, itemType, itemId])
  @@unique([collectionId, position])
}

model UserCollectionCollaborator {
  collectionId Int
  userId       Int
  createdAt    DateTime @default(now())
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
  @@index([userId])
}

model UserCollectionFollow {
  collectionId Int
  userId       Int
  createdAt    DateTime @default(now())
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
  @@index([userId])
}

model UserCollectionSave {
  collectionId Int
  userId       Int
  createdAt    DateTime @default(now())
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
  @@index([userId, createdAt])
}

model UserCollectionReaction {
  collectionId Int
  userId       Int
  createdAt    DateTime @default(now())
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- Film & series

model CinemaTitle {
  /// Site group keys that may see this item, as JSON; empty for everyone.
  audienceGroups String @default("")
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  kind          String         @default("MOVIE") // MOVIE | SERIES — follows the format's structure
  // The managed kind of title (film, series, anime…); a format in use cannot be deleted.
  formatId      Int?
  format        CinemaFormat?  @relation(fields: [formatId], references: [id], onDelete: Restrict)
  title         String
  titleEn       String         @default("")
  originalTitle String         @default("")
  poster        String         @default("")
  backdrop      String         @default("")
  year          Int?
  endYear       Int?
  // The day a film opens (cinemas or streaming); the release calendar is built from it. Unset: not on the calendar.
  releaseDate   DateTime?
  imdbRating    Float?
  imdbId        String         @default("")
  runtime       Int            @default(0)
  ageRating     String         @default("")
  countries     String         @default("")
  languages     String         @default("")
  genres        String         @default("")
  director      String         @default("")
  // Producers, separated like the director line; read into PRODUCER credits.
  producer      String         @default("")
  cast          String         @default("[]")
  summary       String         @default("")
  summaryEn     String         @default("")
  trailerUrl    String         @default("")
  quality       String         @default("")
  dubbed        Boolean        @default(false)
  subtitle      Boolean        @default(false)
  seriesStatus  String         @default("")
  access        String         @default("PUBLIC")
  status        String         @default("PUBLISHED")
  featured      Boolean        @default(false)
  views         Int            @default(0)
  publishedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  seasons       CinemaSeason[]
  airNotifications CinemaEpisodeAirNotification[]
  credits       CinemaCredit[]
  // The staff member who created the item; a section author manages only the items they created.
  createdById Int?
  // A delete asked by an author: status is TRASHED, the status it had is kept here until a manager decides.
  trashedStatus String    @default("")
  trashedAt     DateTime?
  trashedById   Int?

  @@index([kind, status, publishedAt])
  @@index([kind, status, releaseDate])
  @@index([formatId, status, publishedAt])
  @@index([createdById])
}

/// A kind of film or series the owner manages (film, series, anime, documentary…). `structure` says whether a title of
/// this kind is one work (MOVIE: links on the title) or has seasons and episodes (SERIES); the title's `kind` follows it.
model CinemaFormat {
  id        Int           @id @default(autoincrement())
  slug      String        @unique
  name      String
  nameEn    String        @default("")
  // The plural for shelves, menus and the browse heading ("انیمه‌ها").
  plural    String        @default("")
  structure String        @default("MOVIE") // MOVIE | SERIES
  icon      String        @default("")
  sortOrder Int           @default(0)
  // An inactive format is not offered for new titles nor in the public filter; titles that have it keep it.
  active    Boolean       @default(true)
  // Its own shelf on the cinema home, in the "format shelves" rail (film and series have rails of their own).
  homeShelf Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  titles    CinemaTitle[]
}

/// A person of films and series (director, producer, cast), read out of the titles' own director and producer lines and cast list.
model CinemaPerson {
  mergedIntoId Int?
  mergedInto CinemaPerson? @relation("CinemaPersonMerges", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  aliases CinemaPerson[] @relation("CinemaPersonMerges")
  id             Int            @id @default(autoincrement())
  name           String
  normalizedName String         @unique
  image          String         @default("")
  bio            String         @default("")
  displayNameKey String         @default("")
  imageLocked    Boolean        @default(false)
  profileVersion Int            @default(0)
  createdAt      DateTime       @default(now())
  credits        CinemaCredit[]
  celebrity      Celebrity?
}

model CinemaCredit {
  id        Int          @id @default(autoincrement())
  titleId   Int
  personId  Int
  role      String // DIRECTOR | PRODUCER | CAST
  character String       @default("")
  sortOrder Int          @default(0)
  title     CinemaTitle  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  person    CinemaPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([titleId, personId, role])
  @@index([personId, role])
}

/// One person across the site's sections («چهره‌ها»): a film's actor or director and a singer are one page when linked.
/// Built from the sections' own people (CinemaPerson, MusicArtist), which stay the owners of names, pictures and works.
model Celebrity {
  id             Int           @id @default(autoincrement())
  slug           String        @unique
  name           String
  normalizedName String        @default("")
  cinemaPersonId Int?          @unique
  musicArtistId  Int?          @unique
  cinemaPerson   CinemaPerson? @relation(fields: [cinemaPersonId], references: [id], onDelete: SetNull)
  musicArtist    MusicArtist?  @relation(fields: [musicArtistId], references: [id], onDelete: SetNull)
  /// The owner split it from a same-named person of the other section: never joined again by name.
  keepApart      Boolean       @default(false)
  featured       Boolean       @default(false)
  slugAliases    CelebritySlugAlias[]
  /// Published works across the sections (films and series credited, songs, albums, song credits): «most known» order.
  score          Int           @default(0)
  /// The owner's profile fields beyond the biography (country, born, died…): JSON code → value, fields in the managed list PROFILE_FIELD.
  facts          String        @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([normalizedName])
  @@index([score])
}

/// Prior artist page addresses remain reserved and redirect to the canonical profile.
model CelebritySlugAlias {
  slug        String    @id
  celebrityId Int
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@index([celebrityId])
}

model CinemaSeason {
  id       Int             @id @default(autoincrement())
  titleId  Int
  number   Int
  name     String          @default("")
  poster   String          @default("")
  title    CinemaTitle     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes CinemaEpisode[]

  @@unique([titleId, number])
}

model CinemaEpisode {
  id       Int          @id @default(autoincrement())
  seasonId Int
  number   Int
  title    String       @default("")
  titleEn  String       @default("")
  summary  String       @default("")
  still    String       @default("")
  runtime  Int          @default(0)
  airDate  DateTime?
  access   String       @default("PUBLIC")
  season   CinemaSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, number])
  @@index([airDate])
}

// One line per episode whose airing is announced to the members who follow the series. The episode is
// named by series, season and number: saving a series rebuilds its episode rows, so their ids do not last.
model CinemaEpisodeAirNotification {
  id          Int         @id @default(autoincrement())
  titleId     Int
  season      Int
  episode     Int
  dueAt       DateTime
  lastUserId  Int         @default(0)
  completedAt DateTime?
  title       CinemaTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([titleId, season, episode])
  @@index([completedAt, dueAt])
}

model CinemaWatchProgress {
  userId          Int
  ownerType       String // title | episode
  ownerId         Int
  positionSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt
  completedAt     DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ownerType, ownerId])
  @@index([userId, updatedAt])
}

model UserRecentView {
  userId        Int
  itemType      String
  itemId        Int
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemType, itemId])
  @@index([userId, lastViewedAt])
}

// ---------------------------------------------------------------- Games

/// The owner's managed lists of every section (games: platforms, stores, play modes, localisations; software:
/// licences; …). Each section declares its lists in code; `code` is what an item stores and never changes, while
/// the name shown, icon, order and whether it is offered are the owner's.
model Vocabulary {
  id        Int      @id @default(autoincrement())
  section   String   // games | software | …
  list      String   // PLATFORM, STORE, MODE, LOCALIZATION, LICENSE, …
  code      String
  name      String
  nameEn    String   @default("")
  icon      String   @default("")
  // The kind of thing an entry is, for lists that declare families (a software platform: DESKTOP | MOBILE | WEB).
  family    String   @default("")
  sortOrder Int      @default(0)
  // An inactive entry is not offered in forms nor public filters; items that have it keep it.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([section, list, code])
  @@index([section, list, active, sortOrder])
}

model GameTitle {
  /// Site group keys that may see this item, as JSON; empty for everyone.
  audienceGroups String @default("")
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  titleEn      String    @default("")
  cover        String    @default("")
  backdrop     String    @default("")
  platforms    String    @default("")
  genres       String    @default("")
  developer    String    @default("")
  publisher    String    @default("")
  developerStudioId Int?
  developerStudio Studio? @relation("GameDeveloperStudio", fields: [developerStudioId], references: [id], onDelete: SetNull)
  publisherStudioId Int?
  publisherStudio Studio? @relation("GamePublisherStudio", fields: [publisherStudioId], references: [id], onDelete: SetNull)
  releaseDate  DateTime?
  score        Int?
  userScore    Float?
  ageRating    String    @default("")
  trailerUrl   String    @default("")
  screenshots  String    @default("[]")
  summary      String    @default("")
  content      String    @default("")
  pros         String    @default("[]")
  cons         String    @default("[]")
  requirements String    @default("{}")
  access       String    @default("PUBLIC")
  status       String    @default("PUBLISHED")
  featured     Boolean   @default(false)
  views        Int       @default(0)
  franchiseId  Int?
  franchise    GameFranchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  engine       String    @default("")
  modes        String    @default("") // SINGLE, MULTI, COOP, ONLINE (comma separated)
  localization String    @default("") // FA_SUB, FA_DUB, FA_UI (comma separated)
  releases     String    @default("[]") // per-platform release dates [{platform, date}]
  playMain     Int       @default(0) // hours to finish the main story
  playExtra    Int       @default(0) // main + extras
  playComplete Int       @default(0) // completionist
  storeLinks   String    @default("[]") // official stores [{store, url}]
  gameSize     String    @default("")
  version      String    @default("") // latest build / version on the download links
  verdict      String    @default("") // one-line editor verdict next to the score
  editorsChoice Boolean  @default(false)
  seoTitle     String    @default("")
  seoDescription String  @default("")
  updates      GameUpdate[]
  library      GameLibrary[]
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  // The staff member who created the item; a section author manages only the items they created.
  createdById Int?
  // A delete asked by an author: status is TRASHED, the status it had is kept here until a manager decides.
  trashedStatus String    @default("")
  trashedAt     DateTime?
  trashedById   Int?

  @@index([status, publishedAt])
  @@index([releaseDate])
  @@index([franchiseId])
  @@index([developerStudioId])
  @@index([publisherStudioId])
  @@index([createdById])
}

/// A game series (Souls, God of War…): groups titles on the franchise page.
model GameFranchise {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  title       String
  titleEn     String      @default("")
  description String      @default("")
  image       String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  games       GameTitle[]
}

/// Updates, patches, DLCs and editions of a game. Download links live in
/// MediaLink (ownerType "gameupdate").
model GameUpdate {
  id         Int       @id @default(autoincrement())
  gameId     Int
  game       GameTitle @relation(fields: [gameId], references: [id], onDelete: Cascade)
  kind       String    @default("UPDATE") // UPDATE | PATCH | DLC | EDITION
  title      String
  version    String    @default("")
  size       String    @default("")
  notes      String    @default("")
  releasedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  releaseNotification GameUpdateReleaseNotification?

  @@index([gameId, releasedAt])
}

model GameUpdateReleaseNotification {
  updateId    Int        @id
  dueAt       DateTime
  lastUserId  Int        @default(0)
  completedAt DateTime?
  update      GameUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([completedAt, dueAt])
}

/// A member's game library (GameUp "played / playing / want to play").
model GameLibrary {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    Int
  game      GameTitle @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status    String // PLAYING | PLAYED | WANT | DROPPED
  hours     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([userId, gameId])
  @@index([gameId, status])
  @@index([userId, status, updatedAt])
}

/// Software downloads (Windows/macOS/Linux/Android/iOS). Base and versioned
/// MediaLink rows use ownerType "software" and "softwarerelease" respectively.
model SoftwareTitle {
  /// Site group keys that may see this item, as JSON; empty for everyone.
  audienceGroups String @default("")
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  titleEn      String    @default("")
  icon         String    @default("")
  cover        String    @default("")
  version      String    @default("")
  developer    String    @default("")
  publisher    String    @default("")
  developerStudioId Int?
  developerStudio Studio? @relation("SoftwareDeveloperStudio", fields: [developerStudioId], references: [id], onDelete: SetNull)
  publisherStudioId Int?
  publisherStudio Studio? @relation("SoftwarePublisherStudio", fields: [publisherStudioId], references: [id], onDelete: SetNull)
  license      String    @default("FREE") // FREE | FREEMIUM | TRIAL | PAID | OPEN_SOURCE
  platforms    String    @default("")
  category     String    @default("")
  size         String    @default("")
  website      String    @default("")
  requirements String    @default("")
  screenshots  String    @default("[]")
  summary      String    @default("")
  content      String    @default("")
  changelog    String    @default("")
  installGuide String    @default("")
  archivePassword String @default("")
  // A mobile app: its package or bundle id, the oldest system it runs on, and its pages on app stores
  // (validated JSON [{store, url}], the store a code of the APP_STORE list).
  packageId    String    @default("")
  minOs        String    @default("")
  appStores    String    @default("[]")
  features     String    @default("")
  access       String    @default("PUBLIC")
  status       String    @default("PUBLISHED")
  featured     Boolean   @default(false)
  views        Int       @default(0)
  downloads    Int       @default(0)
  releasedAt   DateTime?
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  releases     SoftwareRelease[]
  // The staff member who created the item; a section author manages only the items they created.
  createdById Int?
  // A delete asked by an author: status is TRASHED, the status it had is kept here until a manager decides.
  trashedStatus String    @default("")
  trashedAt     DateTime?
  trashedById   Int?

  @@index([status, publishedAt])
  @@index([developerStudioId])
  @@index([publisherStudioId])
  @@index([createdById])
}

/// Shared developer/publisher identity for Games and Software.
model Studio {
  id                  Int       @id @default(autoincrement())
  name                String
  normalizedName      String    @unique
  summary             String    @default("")
  logo                String    @default("")
  website             String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  gamesDeveloped      GameTitle[] @relation("GameDeveloperStudio")
  gamesPublished      GameTitle[] @relation("GamePublisherStudio")
  softwareDeveloped   SoftwareTitle[] @relation("SoftwareDeveloperStudio")
  softwarePublished   SoftwareTitle[] @relation("SoftwarePublisherStudio")
}

/// Durable follower cursor for the first publication of a Game or Software title.
model StudioPublicationNotification {
  itemType    String
  itemId      Int
  dueAt       DateTime
  lastUserId  Int       @default(0)
  completedAt DateTime?

  @@id([itemType, itemId])
  @@index([completedAt, dueAt])
}

/// Version history. Files are MediaLink rows with ownerType "softwarerelease".
model SoftwareRelease {
  id         Int       @id @default(autoincrement())
  softwareId Int
  software   SoftwareTitle @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  version    String
  channel    String    @default("STABLE") // STABLE | BETA | NIGHTLY
  status     String    @default("DRAFT") // DRAFT | PUBLISHED
  changelog  String    @default("")
  size       String    @default("")
  checksum   String    @default("")
  requirements String @default("")
  screenshots String   @default("[]")
  releasedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  notification SoftwareReleaseNotification?
  targets    SoftwareReleaseTarget[]

  @@unique([softwareId, version, channel])
  @@index([softwareId, status, releasedAt])
  @@index([status, releasedAt])
}

/// OS/CPU compatibility for one Software version. Empty architecture means any.
model SoftwareReleaseTarget {
  id           Int      @id @default(autoincrement())
  releaseId    Int
  release      SoftwareRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform     String
  architecture String   @default("")
  minVersion   String   @default("")
  notes        String   @default("")

  @@unique([releaseId, platform, architecture])
  @@index([platform, architecture])
}

model SoftwareReleaseNotification {
  releaseId   Int       @id
  dueAt       DateTime
  lastUserId  Int       @default(0)
  completedAt DateTime?
  release     SoftwareRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([completedAt, dueAt])
}

/// Forum (تالار گفتمان). The first post of a thread is its body; counters are
/// denormalized for fast listings and kept in sync by the forum service.
model ForumCategory {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  description String        @default("")
  icon        String        @default("")
  access      String        @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  locked      Boolean       @default(false) // only moderators start threads
  sortOrder   Int           @default(0)
  parentId    Int?
  parent      ForumCategory?  @relation("ForumSubcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    ForumCategory[] @relation("ForumSubcategories")
  color       String        @default("#6366f1")
  threadCount Int           @default(0)
  postCount   Int           @default(0)
  lastPostAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  threads     ForumThread[]
  permissions ForumCategoryPermission[]
  watchers    ForumCategoryUser[]
  moderators  ForumCategoryModerator[]
  club        ForumGroup?   @relation("ForumClubForum")
}

model ForumThread {
  id             Int           @id @default(autoincrement())
  itemType       String?
  itemId         Int?
  kind           String        @default("DISCUSSION") // DISCUSSION | QUESTION
  categoryId     Int
  category       ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  pinned         Boolean       @default(false)
  locked         Boolean       @default(false)
  status         String        @default("VISIBLE") // VISIBLE | HIDDEN
  views          Int           @default(0)
  replyCount     Int           @default(0)
  lastPostAt     DateTime      @default(now())
  lastPostUserId Int?
  solvedPostId   Int?          @unique
  closeAt        DateTime? // topic timer: closes automatically at this moment
  slowModeSeconds Int          @default(0) // minimum seconds between one member's replies
  listed         Boolean       @default(true) // unlisted topics open by link only
  solvedPost     ForumPost?    @relation("ForumSolution", fields: [solvedPostId], references: [id], onDelete: SetNull)
  likeCount      Int           @default(0)
  postCount      Int           @default(0) // highest post number
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  posts          ForumPost[]   @relation("ForumThreadPosts")
  tags           ForumThreadTag[]
  topicUsers     ForumTopicUser[]

  @@index([categoryId, status, pinned, lastPostAt])
  @@index([userId])
  @@index([status, lastPostAt])
  @@index([itemType, itemId, kind, status, listed, lastPostAt])
}

model ForumPost {
  id        Int         @id @default(autoincrement())
  threadId  Int
  thread    ForumThread @relation("ForumThreadPosts", fields: [threadId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  status    String      @default("VISIBLE") // VISIBLE | HIDDEN
  editedAt  DateTime?
  postNumber Int        @default(0)
  replyToId Int?
  likeCount Int         @default(0)
  editCount Int         @default(0)
  wiki      Boolean     @default(false) // members from trust level 1 may edit
  reviewReason String   @default("") // why a PENDING post waits for staff approval
  createdAt DateTime    @default(now())

  @@index([threadId, status, createdAt])
  reactions ForumReaction[]
  bookmarks ForumBookmark[]
  flags     ForumFlag[]
  revisions ForumPostRevision[]
  polls     ForumPoll[]
  solutionOf ForumThread?   @relation("ForumSolution")

  @@index([userId, createdAt])
  @@index([threadId, postNumber])
}

/// Download / stream links for films, episodes and games. URLs are never sent to
/// the browser; visitors go through /api/media/link/<id>, which checks VIP access.
model MediaLink {
  id        Int      @id @default(autoincrement())
  ownerType String // title | episode | game | software
  ownerId   Int
  label     String   @default("")
  kind      String   @default("DOWNLOAD") // DOWNLOAD | STREAM | SUBTITLE | AUDIO
  quality   String   @default("")
  size      String   @default("")
  platform  String   @default("") // software downloads: Windows/macOS/Linux/Android/iOS
  architecture String @default("") // x86 | x64 | arm64 | armv7 | universal
  checksum  String   @default("") // per-file SHA-256 when supplied
  audio     String   @default("") // ORIGINAL | DUBBED | ''
  subtitle  Boolean  @default(false)
  language  String   @default("") // of a separate subtitle or audio file (kind SUBTITLE | AUDIO): fa, en, ...
  url       String
  access    String   @default("PUBLIC")
  clicks    Int      @default(0)
  disabled  Boolean  @default(false) // hidden (broken link or copyright takedown)
  reports   LinkReport[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
}

/// Bank accounts shown to customers for card-to-card and bank transfers.
model BankAccount {
  id            Int              @id @default(autoincrement())
  bankName      String
  holderName    String
  cardNumber    String           @default("")
  sheba         String           @default("")
  accountNumber String           @default("")
  note          String           @default("")
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  receipts      PaymentReceipt[]
}

/// A customer's proof of a card-to-card / bank transfer. An admin approves it
/// (which settles the invoice) or rejects it with a reason.
model PaymentReceipt {
  id            Int          @id @default(autoincrement())
  invoiceId     Int
  userId        Int
  bankAccountId Int?
  method        String       @default("CARD") // CARD | PAYA | SATNA | ACCOUNT
  amountMinor   BigInt       @default(0)
  currency      String       @default("IRR")
  payerName     String       @default("")
  payerBank     String       @default("")
  payerCard     String       @default("") // last four digits of the source card
  trackingCode  String       @default("")
  paidAt        DateTime?
  image         String       @default("") // file name under storage/receipts
  imageType     String       @default("")
  status        String       @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote     String       @default("")
  reviewedBy    Int?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invoiceId])
  @@index([userId])
}

/// One-time SMS codes for phone login and phone verification (only a hash is stored).
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  email      String?
  purpose    String    @default("LOGIN") // LOGIN | VERIFY
  codeHash   String
  attempts   Int       @default(0)
  userId     Int?
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String    @default("")
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([email, purpose, createdAt])
}

/// Outgoing SMS history (IPPanel).
model SmsLog {
  id         Int      @id @default(autoincrement())
  phone      String
  event      String   @default("")
  kind       String   @default("TEXT") // TEXT | PATTERN | OTP
  body       String   @default("")
  status     String   @default("SENT") // SENT | FAILED | SKIPPED
  providerId String   @default("")
  error      String   @default("")
  userId     Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([phone, createdAt])
}

/// Forum profile (Discourse-style): public handle, bio, trust level and counters.
model ForumProfile {
  userId        Int          @id
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String       @unique
  bio           String       @default("")
  location      String       @default("")
  website       String       @default("")
  avatar        String       @default("")
  cover         String       @default("")
  title         String       @default("")
  primaryGroupId Int?
  manualLevelId String? // Activity degree override only; never grants access.
  trustLevel    Int          @default(0)
  trustLocked   Boolean      @default(false)
  topicCount    Int          @default(0)
  postCount     Int          @default(0)
  likesGiven    Int          @default(0)
  likesReceived Int          @default(0)
  // Reactions received, each by the weight of its kind (forum settings). Recounted from the reactions themselves.
  reputation    Int          @default(0)
  solvedCount   Int          @default(0)
  topicsEntered Int          @default(0)
  daysVisited   Int          @default(0)
  lastVisitDay  String       @default("")
  lastSeenAt    DateTime?
  silencedUntil DateTime?
  suspendedUntil DateTime?
  sanctionProjection String @default("") // last canonical dates, to detect legacy writers
  moderationNote String      @default("")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([trustLevel])
  @@index([postCount])
  @@index([reputation])
}

/// Forum groups: custom (open, by request or invite-only) and automatic ones
/// (everyone, vip, staff, trust_level_0..4) used in category permissions.
model ForumGroup {
  id          Int                  @id @default(autoincrement())
  slug        String               @unique
  name        String
  description String               @default("")
  icon        String               @default("")
  color       String               @default("#6366f1")
  title       String               @default("") // title granted to members
  automatic   String?              @unique // everyone | vip | staff | trust_level_0..4
  visibility  String               @default("PUBLIC") // PUBLIC | MEMBERS | STAFF
  joinMode    String               @default("CLOSED") // OPEN | REQUEST | CLOSED
  moderator   Boolean              @default(false) // members moderate the forum
  mentionable Boolean              @default(false)
  memberCount Int                  @default(0)
  /// Set for a club: a group made by a member, with this forum of its own.
  clubCategoryId Int?              @unique
  clubCategory ForumCategory?      @relation("ForumClubForum", fields: [clubCategoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  members     ForumGroupMember[]
  permissions ForumCategoryPermission[]
}

model ForumGroupMember {
  id        Int        @id @default(autoincrement())
  groupId   Int
  group     ForumGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner     Boolean    @default(false)
  status    String     @default("ACTIVE") // ACTIVE | PENDING
  createdAt DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId, status])
}

/// Per-category group permission. A category with rows is restricted to them.
model ForumCategoryPermission {
  id         Int           @id @default(autoincrement())
  categoryId Int
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groupId    Int
  group      ForumGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  level      String        @default("CREATE") // SEE | REPLY | CREATE

  @@unique([categoryId, groupId])
}

model ForumTag {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String           @default("")
  topicCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  threads     ForumThreadTag[]
}

model ForumThreadTag {
  threadId Int
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tagId    Int
  tag      ForumTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

model ForumReaction {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String    @default("heart")
  createdAt DateTime  @default(now())

  @@unique([postId, userId, emoji])
  @@index([userId, createdAt])
}

model ForumBookmark {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, postId])
}

/// Community flags; enough weight hides a post until staff review it.
model ForumFlag {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String    @default("OTHER") // SPAM | INAPPROPRIATE | OFF_TOPIC | OTHER
  note      String    @default("")
  weight    Int       @default(1)
  status    String    @default("PENDING") // PENDING | AGREED | DISAGREED
  handledBy Int?
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([status, createdAt])
}

model ForumPostRevision {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  content   String
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
}

/// Per-user topic state: read position (unread/new) and notification level.
model ForumTopicUser {
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId       Int
  thread         ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  lastRead       Int         @default(0)
  level          String      @default("NORMAL") // WATCHING | TRACKING | NORMAL | MUTED
  firstVisitedAt DateTime    @default(now())
  lastVisitedAt  DateTime    @default(now())

  @@id([userId, threadId])
  @@index([threadId, level])
}

model ForumBadge {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  name        String
  description String           @default("")
  icon        String           @default("🏅")
  tier        String           @default("BRONZE") // BRONZE | SILVER | GOLD
  rule        String           @default("") // automatic rule id; empty = granted by staff
  enabled     Boolean          @default(true)
  grantCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  grants      ForumUserBadge[]
}

model ForumUserBadge {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   Int
  badge     ForumBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  reason    String     @default("")
  grantedBy Int?
  grantedAt DateTime   @default(now())

  @@unique([userId, badgeId])
  @@index([badgeId, grantedAt])
}

// ---------------------------------------------------------------- downloads
model DownloadLog {
  id        Int      @id @default(autoincrement())
  linkId    Int?
  ownerType String // title | episode | game | software | track
  ownerId   Int
  userId    Int?
  visitor   String   @default("") // daily salted hash of ip + user agent
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([visitor, createdAt])
  @@index([ownerType, ownerId])
}

model LinkReport {
  id         Int       @id @default(autoincrement())
  linkId     Int
  userId     Int?
  visitor    String    @default("")
  reason     String // BROKEN | WRONG_FILE | SLOW | PASSWORD | OTHER
  note       String    @default("")
  status     String    @default("OPEN") // OPEN | FIXED | DISMISSED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  link       MediaLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([linkId])
}

// ---------------------------------------------------------------- reviews & favorites
model ItemReview {
  businessProofs BusinessPurchaseProof[]
  businessReports CommunityReport[]
  experiencedOn DateTime?
  businessReply String @default("")
  businessReplyBy Int?
  businessReplyAt DateTime?
  businessReplyAuthor User? @relation("BusinessReviewReply", fields: [businessReplyBy], references: [id], onDelete: SetNull)
  id        Int      @id @default(autoincrement())
  itemType  String // software | game | title | album | track
  itemId    Int
  userId    Int
  rating    Int
  body      String   @default("")
  status    String   @default("APPROVED") // text moderation: PENDING | APPROVED | REJECTED (rejected ratings are not counted)
  verified  String   @default("") // the site's own record that the reviewer used the item: PURCHASE | DOWNLOAD | WATCH | LISTEN
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpfulVotes ItemReviewHelpful[]
  scores    ItemReviewScore[]

  @@unique([itemType, itemId, userId])
  @@index([itemType, itemId, status, createdAt])
  @@index([status, createdAt])
}

// Optional per-type dimension scores (gameplay, story, …); keys live in reviews/domain/dimensions.
model ItemReviewScore {
  reviewId Int
  key      String
  score    Int
  review   ItemReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, key])
}

model ItemReviewHelpful {
  reviewId  Int
  userId    Int
  createdAt DateTime @default(now())
  review    ItemReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
}

model ItemFavorite {
  userId    Int
  itemType  String
  itemId    Int
  notify    Boolean  @default(true) // "tell me about new versions / episodes"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemType, itemId])
  @@index([itemType, itemId])
}

model ItemStat {
  itemType    String
  itemId      Int
  ratingCount Int    @default(0)
  ratingSum   Int    @default(0)
  favorites   Int    @default(0)

  @@id([itemType, itemId])
}

// ---------------------------------------------------------------- search
model SearchDocument {
  id          Int      @id @default(autoincrement())
  itemType    String
  itemId      Int
  title       String
  subtitle    String   @default("")
  text        String // normalized title, keywords and summary
  url         String
  image       String   @default("")
  access      String   @default("PUBLIC")
  boost       Int      @default(0)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([itemType, itemId])
  @@index([itemType, publishedAt])
  /// The search reads matches newest published first and stops at its cap.
  @@index([publishedAt, id])
}

// ---------------------------------------------------------------- social publishing
model SocialPost {
  id            Int       @id @default(autoincrement())
  channel       String // TELEGRAM | INSTAGRAM
  itemType      String
  itemId        Int
  status        String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  attempts      Int       @default(0)
  error         String    @default("")
  externalId    String    @default("")
  text          String    @default("")
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([channel, itemType, itemId])
  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------- web push
model PushSubscription {
  id            Int       @id @default(autoincrement())
  endpoint      String    @unique
  p256dh        String
  auth          String
  userId        Int?
  userAgent     String    @default("")
  failures      Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PushCampaign {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @default("")
  url       String   @default("/")
  audience  String   @default("ALL") // ALL | USERS | VIP | GUESTS
  sent      Int      @default(0)
  failed    Int      @default(0)
  createdBy Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------- analytics
model AnalyticsDaily {
  day      String // YYYY-MM-DD (Asia/Tehran)
  path     String // "*" holds the site-wide totals
  views    Int    @default(0)
  visitors Int    @default(0)

  @@id([day, path])
}

model AnalyticsVisitor {
  day  String
  hash String

  @@id([day, hash])
}

model AnalyticsDimension {
  day   String
  dim   String // source | device | browser | os | search | search-empty
  value String
  count Int    @default(0)

  @@id([day, dim, value])
  @@index([dim, day])
}

// ---------------------------------------------------------------- copyright
model CopyrightReport {
  id             Int       @id @default(autoincrement())
  code           String    @unique // tracking code shown to the reporter
  name           String
  email          String
  organization   String    @default("")
  phone          String    @default("")
  role           String    @default("OWNER") // OWNER | AGENT
  workTitle      String
  originalUrl    String    @default("")
  infringingUrls String // one URL per line
  itemType       String    @default("")
  itemId         Int?
  description    String
  signature      String
  status         String    @default("NEW") // NEW | REVIEWING | ACCEPTED | REJECTED
  resolution     String    @default("") // message shown to the reporter
  actionTaken    String    @default("") // internal log of what was removed
  visitor        String    @default("")
  handledBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  resolvedAt     DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- shipping
model UserAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String   @default("")
  recipient  String
  mobile     String
  province   String
  city       String
  address    String
  plaque     String   @default("")
  unit       String   @default("")
  postalCode String
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeliveryBooking {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  date      String // YYYY-MM-DD (Tehran)
  slotId    String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([date, slotId])
}

/// Hierarchical categories for content sections (WordPress-style taxonomy).
/// One tree per section ("software", "games", "music", "cinema"); items are
/// linked through TaxonomyAssignment, whose ownerId points at that section's
/// own table.
model TaxonomyTerm {
  facet          String    @default("")
  id             Int       @id @default(autoincrement())
  taxonomy       String
  slug           String
  name           String
  description    String    @default("")
  icon           String    @default("")
  image          String    @default("")
  color          String    @default("")
  parentId       Int?
  parent         TaxonomyTerm?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       TaxonomyTerm[] @relation("TaxonomyTree")
  sortOrder      Int       @default(0)
  inMenu         Boolean   @default(true)
  count          Int       @default(0)
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  assignments    TaxonomyAssignment[]

  @@unique([taxonomy, slug])
  @@index([taxonomy, parentId, sortOrder])
}

model TaxonomyAssignment {
  termId   Int
  ownerId  Int
  taxonomy String
  primary  Boolean      @default(false)
  term     TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([termId, ownerId])
  @@index([taxonomy, ownerId])
}

/// Manufacturer / brand of store products.
model ProductBrand {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  nameEn      String    @default("")
  logo        String    @default("")
  description String    @default("")
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  products    Product[]
}

/// Shopping cart: one per signed-in customer, or per browser (token cookie) for guests.
model Cart {
  id        Int        @id @default(autoincrement())
  token     String     @unique
  userId    Int?       @unique
  remindedAt    DateTime?
  reminderCount Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines     CartLine[]

  @@index([updatedAt])
}

model CartLine {
  id         Int      @id @default(autoincrement())
  cartId     Int
  productId  Int
  variantKey Int      @default(0) // variant id, 0 = product without variants
  quantity   Int      @default(1)
  inputs     String   @default("") // encrypted answers of the buyer to the product's order fields
  openAmountMinor BigInt @default(0) // the foreign amount typed by the buyer (open-amount products)
  openCurrency String  @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
  @@index([productId])
}

/// Snapshot of each product line of a store order (price and name at purchase time).
model OrderLine {
  id             Int      @id @default(autoincrement())
  orderId        Int
  line           Int      @default(0)
  productId      Int?
  variantId      Int?
  name           String
  variantName    String   @default("")
  sku            String   @default("")
  image          String   @default("")
  kind           String   @default("VIRTUAL")
  quantity       Int      @default(1)
  unitPriceMinor BigInt   @default(0)
  listPriceMinor BigInt   @default(0)
  totalMinor     BigInt   @default(0)
  currency       String   @default("IRT")
  sellerId       Int? // marketplace seller of this line
  commissionMinor BigInt  @default(0)
  sellerStatus   String   @default("") // '' | ACCEPTED | READY | SHIPPED | CANCELLED
  sellerTracking String   @default("")
  inputs         String   @default("") // encrypted answers of the buyer, with their labels as they were asked
  openAmountMinor BigInt  @default(0) // the foreign amount this line paid for
  openCurrency   String   @default("")
  openRate       String   @default("") // the rate used, as text (toman per unit)
  inputsErasedAt DateTime? // when the answers were wiped (by staff, or after the order was done)
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([orderId, line])
  @@index([productId])
  @@index([sellerId, createdAt])
}

/// Order timeline (status changes, notes); customer-visible rows appear in order tracking.
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String   @default("")
  note      String   @default("")
  visible   Boolean  @default(true)
  actorId   Int?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// A poll inside a forum post ([poll] … [/poll] blocks, one row per block).
model ForumPoll {
  id         Int             @id @default(autoincrement())
  postId     Int
  post       ForumPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  name       String          @default("poll")
  title      String          @default("")
  type       String          @default("regular") // regular | multiple
  options    String          @default("[]") // [{ id, label }]
  minChoices Int             @default(1)
  maxChoices Int             @default(1)
  results    String          @default("on_vote") // always | on_vote | on_close
  closed     Boolean         @default(false)
  closesAt   DateTime?
  voterCount Int             @default(0)
  createdAt  DateTime        @default(now())
  votes      ForumPollVote[]

  @@unique([postId, name])
}

model ForumPollVote {
  pollId    Int
  poll      ForumPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  createdAt DateTime  @default(now())

  @@id([pollId, userId, optionId])
  @@index([userId])
}

/// Per-member category notification level (watching, watching first post, tracking, normal, muted).
model ForumCategoryUser {
  userId     Int
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level      String        @default("NORMAL")

  @@id([userId, categoryId])
  @@index([categoryId, level])
}

/// A member who moderates one forum and everything under it (its forums and subforums).
model ForumCategoryModerator {
  id         Int           @id @default(autoincrement())
  categoryId Int
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     Int
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([categoryId, userId])
  @@index([userId])
}

/// Personal messages: private conversations between members (and staff).
model ForumConversation {
  id             Int                     @id @default(autoincrement())
  title          String
  userId         Int // creator
  postCount      Int                     @default(0)
  lastPostAt     DateTime                @default(now())
  lastPostUserId Int?
  createdAt      DateTime                @default(now())
  participants   ForumConversationUser[]
  messages       ForumMessage[]

  @@index([lastPostAt])
}

model ForumConversationUser {
  conversationId Int
  conversation   ForumConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastRead       Int               @default(0)
  archived       Boolean           @default(false)
  left           Boolean           @default(false)
  joinedAt       DateTime          @default(now())

  @@id([conversationId, userId])
  @@index([userId, archived])
}

model ForumMessage {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   ForumConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  number         Int
  content        String
  editedAt       DateTime?
  createdAt      DateTime          @default(now())

  @@unique([conversationId, number])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- Unified profile & social graph

/// The one public profile of a member across the site (forum, reviews,
/// game library, social posts). The forum keeps a denormalized copy of the
/// username/avatar in ForumProfile for its own queries.
model UserProfile {
  userId         Int      @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String   @unique
  headline       String   @default("") // one-line tagline under the name
  bio            String   @default("")
  location       String   @default("")
  website        String   @default("")
  avatar         String   @default("")
  cover          String   @default("")
  links          String   @default("[]") // [{kind, url}] social accounts
  privacy        String   @default("{}") // visibility, messages, activity toggles
  verified       Boolean  @default(false)
  followerCount  Int      @default(0)
  followingCount Int      @default(0)
  postCount      Int      @default(0)
  pinnedPostId   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([followerCount])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A member's post on their profile / the social feed.
model CommunityPost {
  id           Int             @id @default(autoincrement())
  authorId     Int
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content      String
  images       String          @default("[]")
  itemType     String          @default("") // shared site item: game | software | product | post | thread …
  itemId       Int?
  visibility   String          @default("PUBLIC") // PUBLIC | FOLLOWERS
  status       String          @default("VISIBLE") // VISIBLE | HIDDEN (by staff, reversible) | DELETED (by its author, final)
  likeCount    Int             @default(0)
  commentCount Int             @default(0)
  editedAt     DateTime?
  createdAt    DateTime        @default(now())
  comments     CommunityComment[]
  likes        CommunityLike[]
  reports      CommunityReport[]

  @@index([authorId, status, createdAt])
  @@index([status, createdAt])
}

model CommunityComment {
  id        Int            @id @default(autoincrement())
  postId    Int
  post      CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  status    String         @default("VISIBLE")
  createdAt DateTime       @default(now())
  reports   CommunityReport[]

  @@index([postId, status, createdAt])
}

model CommunityLike {
  id        Int        @id @default(autoincrement())
  postId    Int
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model CommunityReport {
  businessId Int?
  itemReviewId Int?
  sellerReviewId Int?
  businessReviewDigest String @default("")
  decisionNote String @default("")
  reviewedById Int?
  reviewedAt DateTime?
  business BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemReview ItemReview? @relation(fields: [itemReviewId], references: [id], onDelete: Cascade)
  sellerReview SellerReview? @relation(fields: [sellerReviewId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  id         Int            @id @default(autoincrement())
  postId     Int?
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  Int?
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User           @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  note       String         @default("")
  status     String         @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime       @default(now())

  @@index([status, createdAt])
  @@index([businessId, status, id])
}

/// Emails the site sent (test sends, notifications) — the panel's sent log.
model MailLog {
  id        Int      @id @default(autoincrement())
  toAddress String
  subject   String
  status    String   @default("SENT")
  error     String   @default("")
  messageId String   @default("")
  source    String   @default("system")
  actorId   Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

/// One-time password-reset links sent by email (only the hash is stored).
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String    @default("")
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Customer cancellation (before shipping) or return (after delivery) of a store order; refunds go to the wallet.
model ReturnRequest {
  id          Int       @id @default(autoincrement())
  number      String    @unique
  orderId     Int
  userId      Int
  kind        String    @default("RETURN") // CANCEL | RETURN
  status      String    @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | REFUNDED | WITHDRAWN
  reason      String    @default("")
  description String    @default("")
  photos      String    @default("[]") // stored file names under storage/returns
  lines       String    @default("[]") // [{ line, quantity }]
  requestedMinor BigInt @default(0)
  refundMinor BigInt    @default(0)
  currency    String    @default("IRT")
  restocked   Boolean   @default(false)
  adminNote   String    @default("")
  decidedBy   Int?
  decidedAt   DateTime?
  refundedAt  DateTime?
  walletTxId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// A parcel handed to a carrier (waybill): our own waybill number, the carrier's tracking code and its journey.
model Shipment {
  id           Int       @id @default(autoincrement())
  orderId      Int       @unique
  waybill      String    @unique
  carrier      String
  carrierName  String    @default("")
  trackingCode String    @default("")
  status       String    @default("READY") // READY | PICKED_UP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | RETURNED | CANCELLED
  weightGrams  Int       @default(0)
  parcels      Int       @default(1)
  feeMinor     BigInt    @default(0) // charged to the customer
  costMinor    BigInt    @default(0) // paid to the carrier (optional, for margins)
  currency     String    @default("IRT")
  sender       String    @default("{}")
  receiver     String    @default("{}")
  note         String    @default("")
  createdBy    Int?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events       ShipmentEvent[]

  @@index([status, createdAt])
  @@index([trackingCode])
}

/// One step of a shipment's journey, shown on the public tracking page.
model ShipmentEvent {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  status     String
  note       String   @default("")
  location   String   @default("")
  actorId    Int?
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
}

/// Short link / forwarder: /forwarder/<slug> shows a countdown page (with ads) and then opens the target.
model ShortLink {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  target      String
  title       String    @default("")
  countdown   Int?      // seconds; null = site default
  active      Boolean   @default(true)
  clicks      Int       @default(0)
  lastClickAt DateTime?
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([createdAt])
}

model DownloadJob {
  id         Int       @id @default(autoincrement())
  kind       String    // fetch | transfer | extract | repack | pack
  status     String    @default("queued") // queued | running | done | failed | cancelled
  title      String    @default("")
  url        String    @default("")
  storageId  String    @default("local")
  dir        String    @default("/")
  name       String    @default("")
  params     String    @default("{}") // JSON, never passwords
  total      Float?
  received   Float     @default(0)
  speed      Float     @default(0)
  result     String    @default("")
  error      String    @default("")
  createdBy  Int?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
}

/// "Let me know when it's back": one row per customer and product/variant.
model StockAlert {
  id         Int       @id @default(autoincrement())
  userId     Int
  productId  Int
  variantId  Int       @default(0) // 0 = the product itself
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([userId, productId, variantId])
  @@index([productId, notifiedAt])
}

/// Store gift card. Only a hash of the code is kept; the code is shown once.
model GiftCard {
  id             Int       @id @default(autoincrement())
  codeHash       String    @unique
  last4          String
  /// Encrypted code, so the buyer (and staff) can see it again.
  codeEnc        String    @default("")
  currency       String    @default("IRT")
  amountMinor    BigInt
  status         String    @default("ACTIVE") // ACTIVE | REDEEMED | DISABLED
  source         String    @default("ADMIN") // ADMIN | PURCHASE
  purchaserId    Int?
  recipientName  String    @default("")
  recipientEmail String    @default("")
  message        String    @default("")
  note           String    @default("")
  /// One card per paid purchase request: the wallet debit's idempotency marker.
  purchaseKey    String?   @unique
  expiresAt      DateTime?
  redeemedBy     Int?
  redeemedAt     DateTime?
  createdBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([purchaserId])
  @@index([redeemedBy])
}

/// Customer club points ledger (earned on paid orders, spent as wallet credit).
model LoyaltyEntry {
  id             Int      @id @default(autoincrement())
  userId         Int
  points         Int
  kind           String // EARN_ORDER | REVERSE_ORDER | REDEEM | ADMIN | BONUS
  note           String   @default("")
  orderId        Int?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([kind, createdAt])
}

model LoyaltyAccount {
  userId    Int      @id
  balance   Int      @default(0)
  lifetime  Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([lifetime])
}

/// Abandoned cart reminders (one row per reminder sent).
model CartReminder {
  id               Int       @id @default(autoincrement())
  cartId           Int
  userId           Int
  step             Int
  valueMinor       BigInt    @default(0)
  currency         String    @default("IRT")
  couponCode       String    @default("")
  sentAt           DateTime  @default(now())
  recoveredOrderId Int?
  recoveredAt      DateTime?

  @@index([cartId])
  @@index([userId, sentAt])
  @@index([sentAt])
}

/// Newsletter list: site visitors who subscribed (double opt-in) and anyone who unsubscribed.
model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  name           String    @default("")
  userId         Int?
  status         String    @default("PENDING") // PENDING | ACTIVE | UNSUBSCRIBED
  token          String    @unique
  source         String    @default("form")
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
}

model NewsletterCampaign {
  id          Int       @id @default(autoincrement())
  subject     String
  preheader   String    @default("")
  html        String    @default("")
  audience    String    @default("subscribers") // subscribers | users | customers | all
  status      String    @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | CANCELLED
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  opens       Int       @default(0)
  clicks      Int       @default(0)
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([status, scheduledAt])
}

model NewsletterDelivery {
  id         Int       @id @default(autoincrement())
  campaignId Int
  email      String
  name       String    @default("")
  userId     Int?
  token      String    @unique
  status     String    @default("PENDING") // PENDING | SENDING (claimed; sentAt = claim time) | SENT | FAILED
  error      String    @default("")
  sentAt     DateTime?
  openedAt   DateTime?
  opens      Int       @default(0)
  clickedAt  DateTime?
  clicks     Int       @default(0)

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

// ---------------------------------------------------------------- Paid content

/// A price on one piece of content (article, software, game, film, album, track).
/// VIP members get it free, at a member price, or pay like everyone else.
model PaidItem {
  id               Int      @id @default(autoincrement())
  ownerType        String   // post | software | game | title | album | track
  ownerId          Int
  priceMinor       BigInt
  currency         String   @default("IRT")
  vipAccess        String   @default("FREE") // FREE | DISCOUNT | NONE
  memberPriceMinor BigInt?
  active           Boolean  @default(true)
  sales            Int      @default(0)
  revenueMinor     BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([ownerType, ownerId])
}

/// Lifetime access to one piece of paid content.
model ContentPurchase {
  id         Int       @id @default(autoincrement())
  userId     Int
  ownerType  String
  ownerId    Int
  orderId    Int?
  paidMinor  BigInt    @default(0)
  currency   String    @default("IRT")
  source     String    @default("PURCHASE") // PURCHASE | ADMIN
  note       String    @default("")
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, ownerType, ownerId])
  @@index([ownerType, ownerId])
  @@index([orderId])
}

// ---------------------------------------------------------------- Marketplace (multi-vendor)

/// A shop selling on the site (Digikala-style marketplace). One per user.
model Seller {
  businessProfile BusinessProfile?
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  slug              String    @unique
  shopName          String
  legalName         String    @default("")
  kind              String    @default("PERSON") // PERSON | COMPANY
  nationalId        String    @default("")
  phone             String    @default("")
  email             String    @default("")
  city              String    @default("")
  address           String    @default("")
  about             String    @default("")
  logo              String    @default("")
  banner            String    @default("")
  iban              String    @default("")
  ibanOwner         String    @default("")
  status            String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED | REJECTED
  statusNote        String    @default("")
  commissionPercent Int?      // overrides the category/default commission
  ratingSum         Int       @default(0)
  ratingCount       Int       @default(0)
  salesCount        Int       @default(0)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  products          Product[]

  @@index([status])
}

/// Seller money: sales, commission, refunds and payouts (signed amounts). Sales become withdrawable after the hold period.
model SellerLedger {
  id          Int      @id @default(autoincrement())
  sellerId    Int
  kind        String   // SALE | COMMISSION | REFUND | PAYOUT | ADJUST
  amountMinor BigInt
  currency    String   @default("IRT")
  orderId     Int?
  orderLineId Int?
  payoutId    Int?
  note        String   @default("")
  availableAt DateTime @default(now())
  dedupeKey   String   @unique
  createdAt   DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([orderId])
}

/// A seller's withdrawal request, paid by the admin to the seller's IBAN.
model SellerPayout {
  id          Int       @id @default(autoincrement())
  sellerId    Int
  amountMinor BigInt
  currency    String    @default("IRT")
  status      String    @default("REQUESTED") // REQUESTED | PAID | REJECTED
  iban        String    @default("")
  ibanOwner   String    @default("")
  reference   String    @default("")
  note        String    @default("")
  processedBy Int?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([sellerId, status])
  @@index([status, createdAt])
}

/// Customer rating of a seller after an order (on time, as described, packaging).
model SellerReview {
  businessReports CommunityReport[]
  id        Int      @id @default(autoincrement())
  sellerId  Int
  userId    Int
  orderId   Int
  rating    Int
  criteria  String   @default("{}")
  body      String   @default("")
  status    String   @default("APPROVED") // APPROVED | HIDDEN
  reply     String   @default("")
  createdAt DateTime @default(now())

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
}

// ---------------------------------------------------------------- Live chat & CRM

/// A live chat on the site: answered by the AI assistant first, then by an operator.
model ChatConversation {
  id               Int       @id @default(autoincrement())
  token            String    @unique // visitor cookie
  userId           Int?
  name             String    @default("")
  contact          String    @default("") // phone or email left by a guest
  status           String    @default("BOT") // BOT | WAITING | OPEN | CLOSED
  assignedTo       Int?
  pageUrl          String    @default("")
  botReplies       Int       @default(0)
  unreadForAgent   Int       @default(0)
  unreadForVisitor Int       @default(0)
  rating           Int?
  lastMessageAt    DateTime  @default(now())
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  messages         ChatMessage[]

  @@index([status, lastMessageAt])
  @@index([userId])
  @@index([assignedTo, status])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  sender         String           // VISITOR | BOT | AGENT | SYSTEM
  agentId        Int?
  body           String
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
}

/// Customer labels for segmentation in the CRM (e.g. wholesale, VIP, needs follow-up).
model CrmTag {
  id        Int      @id @default(autoincrement())
  userId    Int
  tag       String
  createdAt DateTime @default(now())

  @@unique([userId, tag])
  @@index([tag])
}

// ---------------------------------------------------------------- Operations

/// Background queue for heavy work (image optimization, re-indexing…), run by the job scheduler.
/// A staff member's saved view: a name for an admin address with its filters (identity/domain/saved-views).
model AdminSavedView {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  href      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// A version of an item staff edit (a post, a page, a film, a game, ...): its own columns after a save,
/// kept so its history can be read and an earlier state put back (content/domain/revisions).
model ContentRevision {
  id         Int      @id @default(autoincrement())
  entityType String // posts | pages | a media resource (cinema-titles, games, software, music-albums, ...)
  entityId   Int
  version    Int
  snapshot   String // the item's own columns as JSON; never a secret
  changed    String   @default("") // columns that differ from the version before, comma separated
  source     String   @default("edit") // baseline | edit | restore | import
  actorId    Int?
  actorEmail String   @default("")
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
}

/// What staff do about one waiting item of any section: who has taken it, their note, and the decision sent
/// from the overview. The item and its decision stay with the owning module (moderation/domain/cases).
model ModerationCase {
  id          Int       @id @default(autoincrement())
  round       Int       @default(1)
  decisions   ModerationDecision[]
  source      String // a QueueSourceKey: forum-posts, article-comments, item-reviews, ...
  itemId      Int
  status      String    @default("OPEN") // OPEN | CLAIMED | DECIDED | CLOSED
  assigneeId  Int?
  claimedAt   DateTime?
  note        String    @default("")
  decision    String    @default("") // approve | reject, once decided from the overview
  decidedById Int?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([source, itemId])
  @@index([status, claimedAt])
  @@index([status, decidedAt])
}

model ModerationDecision {
  id          Int      @id @default(autoincrement())
  caseId      Int
  round       Int
  decision    String
  decidedById Int?
  decidedAt   DateTime
  note        String   @default("")
  case        ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, round])
  @@index([decidedAt, id])
}

model BackgroundJob {
  mediaTransfer MediaTransfer?
  id         Int       @id @default(autoincrement())
  kind       String
  payload    String    @default("{}")
  status     String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  attempts   Int       @default(0)
  dedupeKey  String?   @unique
  runAt      DateTime  @default(now())
  lockedAt   DateTime?
  lastError  String    @default("")
  result     String    @default("")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
}

/// Sampled real-user performance (Web Vitals) and server timings, kept for a week.
model PerfSample {
  id        Int      @id @default(autoincrement())
  kind      String   // LCP | INP | CLS | TTFB | FCP
  value     Float
  page      String   @default("")
  device    String   @default("") // mobile | desktop
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Exchange rates

/// Toman per one unit of a foreign currency; FX-priced products follow it.
model CurrencyRate {
  code        String    @id // USD, EUR, …
  rate        Float // Toman per unit
  source      String    @default("MANUAL") // navasan | brsapi | custom | cross | MANUAL
  locked      Boolean   @default(false) // set by hand; automatic updates skip it
  pendingRate Float? // a jump over the limit waits for approval
  pendingAt   DateTime?
  fetchedAt   DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt
}

model CurrencyRateLog {
  id        Int      @id @default(autoincrement())
  code      String
  rate      Float
  source    String
  products  Int      @default(0) // products repriced by this change
  createdAt DateTime @default(now())

  @@index([code, createdAt])
}

// ---------------------------------------------------------------- Advertising

/// A place on the site that shows promotions (header banner, sidebar, …).
model AdPlacement {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  name         String
  description  String   @default("")
  width        Int      @default(0)
  height       Int      @default(0)
  device       String   @default("ALL") // ALL | DESKTOP | MOBILE
  kind         String   @default("BANNER") // BANNER | STICKY
  active       Boolean  @default(true)
  builtin      Boolean  @default(false)
  fallbackHtml String   @default("") // the site's own promotion, shown when no campaign matches
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Advertiser {
  id        Int          @id @default(autoincrement())
  userId    Int?         @unique
  name      String
  company   String       @default("")
  email     String       @default("")
  phone     String       @default("")
  website   String       @default("")
  notes     String       @default("")
  status    String       @default("ACTIVE") // ACTIVE | BLOCKED
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  campaigns AdCampaign[]

  @@index([status])
}

model AdCampaign {
  id               Int         @id @default(autoincrement())
  advertiserId     Int?
  name             String
  status           String      @default("DRAFT") // DRAFT | PENDING | ACTIVE | PAUSED | ENDED | REJECTED
  priority         Int         @default(5) // 1 (last) to 10 (first)
  startsAt         DateTime?
  endsAt           DateTime?
  placements       String      @default("[]")
  devices          String      @default("ALL")
  audience         String      @default("ALL") // ALL | GUEST | MEMBER | NON_VIP
  includePaths     String      @default("[]")
  excludePaths     String      @default("[]")
  languages        String      @default("[]")
  hours            String      @default("") // local hours, e.g. "9-23"
  maxImpressions   Int         @default(0) // 0 = no limit
  maxClicks        Int         @default(0)
  dailyImpressions Int         @default(0)
  dailyClicks      Int         @default(0)
  impressions      Int         @default(0)
  clicks           Int         @default(0)
  packageId        Int?
  paidMinor        BigInt      @default(0)
  currency         String      @default("IRT")
  note             String      @default("")
  rejectReason     String      @default("")
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  advertiser       Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  creatives        AdCreative[]

  @@index([status, startsAt, endsAt])
  @@index([advertiserId])
}

model AdCreative {
  id             Int        @id @default(autoincrement())
  campaignId     Int
  kind           String     @default("IMAGE") // IMAGE | HTML | TEXT
  title          String     @default("")
  imageUrl       String     @default("")
  imageMobileUrl String     @default("")
  alt            String     @default("")
  linkUrl        String     @default("")
  html           String     @default("")
  text           String     @default("")
  cta            String     @default("")
  weight         Int        @default(1)
  active         Boolean    @default(true)
  impressions    Int        @default(0)
  clicks         Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  campaign       AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, active])
}

/// Impressions and clicks per day, creative and placement (written in batches).
model AdStatDaily {
  id           Int    @id @default(autoincrement())
  day          String // YYYY-MM-DD
  campaignId   Int
  creativeId   Int
  placementKey String
  impressions  Int    @default(0)
  clicks       Int    @default(0)
  requests     Int    @default(0) // placement rows only (creativeId 0): ad requests
  empty        Int    @default(0) // … and how many found no campaign

  @@unique([day, creativeId, placementKey])
  @@index([campaignId, day])
  @@index([day])
}

/// A placement package the site sells to advertisers.
model AdPackage {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  placements  String   @default("[]")
  days        Int      @default(30)
  impressions Int      @default(0) // 0 = unlimited within the period
  clicks      Int      @default(0)
  priceMinor  BigInt
  currency    String   @default("IRT")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  sold        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// ---------------------------------------------------------------- plugin & theme repository (vendor side)

model RepoProduct {
  id          Int           @id @default(autoincrement())
  slug        String        @unique // equals the package id in manifest.json
  kind        String        @default("PLUGIN") // PLUGIN | THEME
  name        String
  summary     String        @default("")
  description String        @default("")
  icon        String        @default("")
  cover       String        @default("")
  author      String        @default("")
  category    String        @default("")
  priceMinor  BigInt        @default(0) // 0 = free
  currency    String        @default("IRT")
  siteLimit   Int           @default(1) // sites per license; 0 = unlimited
  supportDays Int           @default(365) // releases published within this period of the purchase; 0 = for life
  active      Boolean       @default(false)
  featured    Boolean       @default(false)
  downloads   Int           @default(0)
  sold        Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  releases    RepoRelease[]
  licenses    RepoLicense[]

  @@index([active, kind])
}

model RepoRelease {
  id           Int         @id @default(autoincrement())
  productId    Int
  version      String
  fileId       String // stored file name under storage/repository (uuid.zip)
  sha256       String
  size         Int
  changelog    String      @default("")
  requiresCore String      @default("")
  runtime      String      @default("declarative") // declarative | code
  published    Boolean     @default(true)
  storageState String      @default("READY") // READY | STAGING; a staged upload never publishes.
  uploadTokenHash String? // private owner/fencing token, cleared on finalization
  createdAt    DateTime    @default(now())
  product      RepoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
  @@index([fileId])
  @@index([productId, createdAt])
}

model RepoLicense {
  id           Int              @id @default(autoincrement())
  keyHash      String           @unique // sha256 of the normalised key (lookup)
  keyEnc       String // the key encrypted, so the buyer can see it again
  keyLast4     String
  productId    Int
  userId       Int?
  email        String           @default("")
  source       String           @default("PURCHASE") // PURCHASE | GRANT
  status       String           @default("ACTIVE") // ACTIVE | REVOKED
  siteLimit    Int              @default(1)
  paidMinor    BigInt           @default(0)
  currency     String           @default("IRT")
  note         String           @default("")
  createdAt    DateTime         @default(now())
  updatesUntil DateTime? // null = for life
  product      RepoProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  activations  RepoActivation[]

  @@index([productId, status])
  @@index([userId])
}

model RepoActivation {
  id         Int         @id @default(autoincrement())
  licenseId  Int
  site       String // host name of the site that activated the license
  coreVersion String     @default("")
  active     Boolean     @default(true)
  ipHash     String      @default("")
  firstAt    DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  license    RepoLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, site])
}

// ------------------------------------------------------------------ bulk import
// One import run: the uploaded file, its mapping and options, progress and totals.
model ImportJob {
  id             Int       @id @default(autoincrement())
  adapter        String
  status         String    @default("DRAFT") // DRAFT | QUEUED | RUNNING | PAUSED | CANCELLED | DONE | DONE_WITH_ERRORS | FAILED | ROLLING_BACK | ROLLED_BACK
  fileName       String    @default("")
  fileKey        String    @default("") // stored upload under storage/imports (never public)
  fileHash       String    @default("")
  format         String    @default("") // json | csv | xlsx
  settings       String    @default("{}") // mapping, field policies and options (validated)
  templateId     Int?
  total          Int       @default(0)
  cursor         Int       @default(0) // next record to process
  stats          String    @default("{}")
  dryRun         String    @default("") // summary of the last dry run
  createdById    Int
  createdByEmail String    @default("")
  executionActorId Int? // current authorized operator; upload creator remains immutable
  executionAuthorizedAt DateTime?
  executionMode String @default("RUN") // RUN | ROLLBACK; retained while paused
  executionGeneration Int @default(0) // atomically increments on every execution grant
  lockedUntil    DateTime? // lease held by the worker processing a slice
  error          String    @default("")
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  records        ImportRecord[]

  @@index([status, updatedAt])
  @@index([adapter, createdAt])
}

// Saved mapping and options for a recurring source ("Digikala export", "Movie source A").
model ImportTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  adapter     String
  settings    String   @default("{}")
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([adapter, name])
}

// What happened to one record of a job, with what is needed to undo it.
model ImportRecord {
  id         Int       @id @default(autoincrement())
  jobId      Int
  index      Int
  sourceKey  String    @default("")
  title      String    @default("")
  action     String    @default("") // CREATE | UPDATE | SKIP | FAIL
  status     String    @default("OK") // OK | WARNING | FAILED | ROLLED_BACK | ROLLBACK_CONFLICT
  entityType String    @default("")
  entityId   Int?
  messages   String    @default("[]")
  changes    String    @default("{}") // created rows and field values before/after, for rollback
  createdAt  DateTime  @default(now())
  job        ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, index])
  @@index([jobId, status])
  @@index([entityType, entityId])
}

// External ids of imported rows per source (a supplier, imdb…), so a re-import finds the same
// row and one entity can carry ids from several sources.
model ImportExternalRef {
  id         Int      @id @default(autoincrement())
  source     String   @default("default") // supplier-a | imdb | …
  entityType String // store.product | store.variant | post | media.movies …
  externalId String
  entityId   Int
  jobId      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([source, entityType, externalId])
  @@index([entityType, entityId])
}

// Remote images already copied into the media library (by address and by content).
model ImportMedia {
  id          Int      @id @default(autoincrement())
  sourceHash  String   @unique
  sourceUrl   String
  contentHash String   @default("")
  localUrl    String
  createdAt   DateTime @default(now())

  @@index([contentHash])
}

// Canonical Identity restriction history; optional modules consume facts through Identity.
model AccessRestriction {
  id                 Int       @id @default(autoincrement())
  userId             Int
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope              String    @default("MODULE")
  moduleKey          String?
  resourceType       String?
  resourceId         String?
  capabilities       String    @default("[]")
  effectKey          String
  reason             String    @default("")
  issuedByUserId     Int?
  issuedAt           DateTime  @default(now())
  startsAt           DateTime  @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedByUserId    Int?
  revocationReason   String    @default("")
  // Logical immutable references to the canonical audit log; legacy provenance may be unknown.
  issuanceAuditId    Int?
  revocationAuditId  Int?
  sourceKey          String?   @unique
  source             String    @default("ADMIN")
  sourceMetadata     String    @default("{}")

  @@index([userId, scope, moduleKey, revokedAt, expiresAt])
  @@index([userId, moduleKey, effectKey])
}

// Business profiles compose existing ItemReview or SellerReview; never duplicate their history.
model BusinessProfile {
  purchaseProofs BusinessPurchaseProof[]
  reports CommunityReport[]
  requests BusinessRequest[]
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  kind String @default("EXTERNAL") // EXTERNAL | SELLER | SITE
  domain String? @unique
  website String @default("")
  category String @default("")
  description String @default("")
  status String @default("DRAFT") // DRAFT | PUBLISHED
  sellerId Int? @unique
  representativeId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  representative User? @relation("BusinessRepresentative", fields: [representativeId], references: [id], onDelete: SetNull)

  @@index([status, category, createdAt])
}

model BusinessRequest {
  id Int @id @default(autoincrement())
  kind String // SUGGESTION | CLAIM
  requesterId Int
  businessId Int?
  reviewerId Int?
  name String
  domain String
  website String @default("")
  category String @default("")
  note String
  status String @default("PENDING")
  decisionNote String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  requester User @relation("BusinessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer User? @relation("BusinessRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  business BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, id])
  @@index([requesterId, id])
}

/// Automation: "when this happens, and these hold, do these" (modules/automation).
model AutomationRule {
  id            Int             @id @default(autoincrement())
  name          String
  description   String          @default("")
  enabled       Boolean         @default(true)
  trigger       String // an id from TRIGGERS (order.paid, ticket.waiting, report.daily…)
  wait          Int             @default(0) // hours or days a scan waits, or the hour a schedule fires
  conditions    String          @default("[]")
  logic         String          @default("all")
  actions       String          @default("[]")
  cooldownHours Int             @default(0) // 0: once per event, or once ever per subject for a scan
  runCount      Int             @default(0)
  lastRunAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  runs          AutomationRun[]

  @@index([enabled, trigger])
}

/// Something that happened, waiting for the rules that start from it. Processed once.
model AutomationEvent {
  id          Int       @id @default(autoincrement())
  name        String
  subjectKey  String // "order:12", "user:7"
  userId      Int?
  payload     String    @default("{}")
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, id])
}

/// One rule run for one subject: what it did, or why it could not.
model AutomationRun {
  id         Int            @id @default(autoincrement())
  ruleId     Int
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  subjectKey String
  status     String // DONE | PARTIAL | FAILED
  detail     String         @default("")
  createdAt  DateTime       @default(now())

  @@index([ruleId, subjectKey, createdAt])
  @@index([createdAt])
}


model BusinessPurchaseProof {
  id Int @id @default(autoincrement())
  businessId Int
  reviewId Int
  userId Int
  reviewerId Int?
  status String @default("PENDING") // PENDING | APPROVED | REJECTED | WITHDRAWN
  reviewDigest String
  filename String @unique
  originalName String
  mimeType String
  size Int
  sha256 String
  decisionNote String @default("")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review ItemReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user User @relation("BusinessProofOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("BusinessProofReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@index([status, id])
  @@index([userId, id])
  @@index([reviewId, status])
}

// Public media metadata only; existing cover/download stores retain the bytes and URLs.
model MediaFolder {
  id Int @id @default(autoincrement())
  name String
  key String @unique
  parentId Int?
  parent MediaFolder? @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children MediaFolder[] @relation("MediaFolderTree")
  assets MediaAsset[]
  transfers MediaTransfer[]
  createdById Int?
  createdBy User? @relation("MediaFolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([parentId])
}

model MediaAsset {
  id String @id @default(uuid())
  storage String // covers | downloads; never private form/support/proof storage
  key String
  name String
  mime String @default("application/octet-stream")
  kind String @default("file")
  bytes BigInt @default(0)
  width Int @default(0)
  height Int @default(0)
  alt String @default("")
  caption String @default("")
  tags String @default("[]")
  folderId Int?
  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  createdById Int?
  createdBy User? @relation("MediaAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transfers MediaTransfer[]
  archivedAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([storage, key])
  @@index([folderId, archivedAt, createdAt])
  @@index([kind, archivedAt])
}

// Workflow metadata; BackgroundJob is the only executable queue.
model MediaTransfer {
  destination String @default("")
  id String @id @default(uuid())
  authority String @default("media")
  sourceHash String @unique
  sourceUrl String
  kind String // image | file
  section String @default("posts")
  name String @default("")
  status String @default("QUEUED")
  actorId Int?
  actor User? @relation("MediaTransferActor", fields: [actorId], references: [id], onDelete: SetNull)
  authAt DateTime?
  folderId Int?
  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  assetId String?
  asset MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  jobId Int? @unique
  job BackgroundJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  runAt DateTime @default(now())
  generation Int @default(0)
  leaseToken String @default("")
  lockedUntil DateTime?
  receivedBytes BigInt @default(0)
  totalBytes BigInt?
  attempts Int @default(0)
  lastError String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([status, runAt])
  @@index([actorId, createdAt])
}

// Canonical editor documents, scoped to the section that owns them. No engine serialization.
model EditorPattern {
  id Int @id @default(autoincrement())
  entity String
  kind String @default("pattern")
  title String
  contentDocument String
  createdById Int?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roleDefaults EditorRoleTemplate[]
  @@index([entity, updatedAt])
}

/// The template a role's new pages or articles start from in the block editor (owner decision 2026-10-20).
/// One per role and section; removing the role or the template removes the default with it.
model EditorRoleTemplate {
  id Int @id @default(autoincrement())
  entity String
  roleId Int
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  patternId Int
  pattern EditorPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  updatedById Int?
  updatedAt DateTime @updatedAt
  @@unique([entity, roleId])
  @@index([patternId])
}

/// An author's proposed change to their published article while the magazine reviews authors (docs/specs/journal-review).
/// One per article: a newer proposal replaces the open one; applying or rejecting it removes it (the decision is kept in
/// the article's versions, the audit log and the author's notice).
model PostEditProposal {
  id            Int      @id @default(autoincrement())
  postId        Int      @unique
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// JSON of the proposed fields only (title, excerpt, body, cover, categories…), never status, time or address.
  changes       String
  /// When the article was last saved as the proposal was made: later edits of the live article are shown as such.
  baseUpdatedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

/// An announcement shown as a popup. Who sees it and how often are chosen in the panel.
model SitePopup {
  id           Int      @id @default(autoincrement())
  title        String
  body         String   @default("")
  kind         String   @default("NOTICE") // NOTICE | NEWS | WARNING | OFFER
  design       String   @default("seal") // seal | cover | split | spotlight
  effect       String   @default("rise") // rise | zoom | drop | slide | flip
  position     String   @default("center") // center | bottom | corner
  image        String   @default("")
  actionLabel  String   @default("")
  actionUrl    String   @default("")
  closeLabel   String   @default("")
  mustConfirm  Boolean  @default(false)
  status       String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED
  startsAt     DateTime?
  endsAt       DateTime?
  audience     String   @default("ALL") // ALL | GUESTS | MEMBERS | GROUPS | SECTION_MANAGERS | ALL_MANAGERS
  groupIds     String   @default("[]") // ForumGroup ids
  sections     String   @default("[]") // SITE_SECTIONS ids
  repeatHours  Int      @default(24) // 0: once
  maxViews     Int      @default(0) // 0: no total
  delaySeconds Int      @default(2)
  pages        String   @default("") // one address per line; empty: the whole site
  priority     Int      @default(0)
  /// Raised by "show to everyone again": guests' browsers keep their count per revision.
  revision     Int      @default(1)
  guestViews   Int      @default(0)
  clicks       Int      @default(0)
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  seen         SitePopupSeen[]

  @@index([status])
}

/// How often one member has seen a popup, kept on the server so it holds across their devices.
model SitePopupSeen {
  id      Int       @id @default(autoincrement())
  popupId Int
  popup   SitePopup @relation(fields: [popupId], references: [id], onDelete: Cascade)
  userId  Int
  user    User      @relation("SitePopupSeen", fields: [userId], references: [id], onDelete: Cascade)
  views   Int       @default(1)
  clicked Boolean   @default(false)
  firstAt DateTime  @default(now())
  lastAt  DateTime  @default(now())

  @@unique([popupId, userId])
  @@index([userId])
}

/// A user group of the whole site. It gives its members public benefits, never access to the panel.
model UserGroup {
  id              Int      @id @default(autoincrement())
  name            String
  description     String   @default("")
  color           String   @default("#4b45ee")
  active          Boolean  @default(true)
  vipBenefits     Boolean  @default(false)
  hideAds         Boolean  @default(false)
  discountPercent Int      @default(0)
  /// Shown in a box under the member's name.
  showBadge       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  members         UserGroupMember[]
  prices          ProductGroupPrice[]
}

model UserGroupMember {
  id        Int       @id @default(autoincrement())
  groupId   Int
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation("UserGroupMember", fields: [userId], references: [id], onDelete: Cascade)
  /// Membership ends by itself; read at decision time.
  expiresAt DateTime?
  note      String    @default("")
  addedBy   Int?
  createdAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// A product's price for one group. variantId 0 is the whole product.
model ProductGroupPrice {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation("ProductGroupPrice", fields: [productId], references: [id], onDelete: Cascade)
  variantId  Int       @default(0)
  groupId    Int
  group      UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  priceMinor BigInt

  @@unique([productId, variantId, groupId])
  @@index([groupId])
}
