// MoboComCMS – Prisma schema (extended CMS + RBAC)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  name           String          @default("")
  role           String          @default("CUSTOMER") // legacy simple role: CUSTOMER | ADMIN
  roleId         Int? // link to Role (fine-grained RBAC)
  status         String          @default("ACTIVE") // ACTIVE | BANNED
  note           String          @default("")
  phone          String          @default("")
  avatarColor    String          @default("#4b45ee")
  walletBalance  Float           @default(0) // legacy USD mirror; use WalletAccount for accounting
  // Telegram login: `telegramId` is the account identity inside the bot and
  // the mini app, the rest is profile sugar for the greeting.
  telegramId     String?         @unique
  telegramUsername String        @default("")
  telegramName   String          @default("")
  telegramPhoto  String          @default("")
  telegramLinkedAt DateTime?
  subscriptionAlerts Boolean @default(true)
  phoneVerifiedAt DateTime?
  smsAlerts      Boolean         @default(true)
  emailAlerts    Boolean         @default(true)
  profileData    String          @default("{}")
  profileCompletedAt DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  orders         Order[]
  subscriptions  Subscription[]
  tickets        Ticket[]        @relation("TicketUser")
  ticketMessages TicketMessage[]
  crmNotes       CrmNote[]
  roleRef        Role?           @relation(fields: [roleId], references: [id])
  posts          Post[]
  postComments   PostComment[]
  productReviews  ProductReview[]
  productQuestions ProductQuestion[]
  invoices       Invoice[]
  payments       Payment[]
  walletTxs      WalletTx[]
  walletAccounts WalletAccount[]
  apiKeys        ApiKey[]
  reseller       Reseller?
  resellerMembership ResellerMember?
  trialClaim     TrialClaim?
  notifications  UserNotification[]

  @@index([telegramId])
  forumThreads   ForumThread[]
  forumPosts     ForumPost[]
  paymentReceipts PaymentReceipt[]
  forumProfile   ForumProfile?
  forumGroups    ForumGroupMember[]
  forumReactions ForumReaction[]
  forumBookmarks ForumBookmark[]
  forumFlags     ForumFlag[]
  forumTopicUsers ForumTopicUser[]
  forumBadges    ForumUserBadge[]
  forumConversations ForumConversationUser[]
  forumMessages  ForumMessage[]
  forumPollVotes ForumPollVote[]
  forumCategoryUsers ForumCategoryUser[]
  gameLibrary  GameLibrary[]
  userProfile  UserProfile?
  following    UserFollow[] @relation("UserFollowing")
  followers    UserFollow[] @relation("UserFollowers")
  blocking     UserBlock[]  @relation("UserBlocking")
  blockedBy    UserBlock[]  @relation("UserBlockedBy")
  communityPosts CommunityPost[]
  communityComments CommunityComment[]
  communityLikes CommunityLike[]
  communityReports CommunityReport[]
  itemReviews    ItemReview[]
  itemFavorites  ItemFavorite[]
  pushSubscriptions PushSubscription[]
  addresses      UserAddress[]
  cart           Cart?

  @@index([phone])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // admin | support | reseller | backup
  nameFa      String   @default("")
  nameEn      String   @default("")
  permissions String   @default("") // comma separated keys
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model UserNotification {
  id         Int       @id @default(autoincrement())
  userId     Int
  kind       String
  dedupeKey  String    @unique
  titleEn    String
  titleFa    String
  bodyEn     String    @default("")
  bodyFa     String    @default("")
  href       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Panel {
  id            Int            @id @default(autoincrement())
  name          String
  type          String // REMNAWAVE | PASARGUARD
  url           String
  token         String
  password      String         @default("")
  inbounds      String         @default("")
  // Remnawave "internal squads" (UUIDs or names, comma separated). A user
  // without a squad gets no config, so a plan on this panel needs them.
  internalSquads String        @default("")
  config        String         @default("{}")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  plans         Plan[]
  subscriptions Subscription[]
}

model Plan {
  id             Int             @id @default(autoincrement())
  name           String
  nameEn         String          @default("")
  description    String          @default("")
  descriptionEn  String          @default("")
  trafficGB      Int
  days           Int
  deviceLimit    Int             @default(2)
  price          Float           // legacy display mirror; exact value is priceMinor
  priceMinor     BigInt          @default(0)
  currency       String          @default("USD")
  active         Boolean         @default(true)
  featured       Boolean         @default(false)
  access         String          @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  memberPriceMinor BigInt        @default(0)
  vipGiftDays    Int             @default(0)
  sort           Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  panel          Panel?          @relation(fields: [panelId], references: [id])
  panelId        Int?
  orderItems     OrderItem[]
  orders         Order[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  resellerPrices ResellerPrice[]
  serviceOffers ServiceOffer[]
}

model Order {
  id            Int            @id @default(autoincrement())
  userId        Int
  planId        Int?
  productId     Int? // single-product purchase
  totalAmount   Float          // legacy display mirror; exact value is totalMinor
  totalMinor    BigInt         @default(0)
  currency      String         @default("USD")
  idempotencyKey String?       @unique
  status        String         @default("PENDING")
  provider      String         @default("plisio")
  providerTxnId String         @default("")
  paymentUrl    String         @default("")
  paidCrypto    String         @default("")
  paidAmount    String         @default("")
  meta          String         @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  plan          Plan?          @relation(fields: [planId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  items         OrderItem[]
  subscriptions Subscription[]
  gateway       Gateway?       @relation(fields: [gatewayId], references: [id])
  gatewayId     Int?
  invoice       Invoice?
  payments      Payment[]
  promotionRedemptions PromotionRedemption[]
  productDelivery ProductDelivery?
  deliveryBooking DeliveryBooking?
  lines         OrderLine[]
  events        OrderEvent[]
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  orderId  Int
  planId   Int
  quantity Int   @default(1)
  price    Float // legacy display mirror
  priceMinor BigInt @default(0)
  order    Order @relation(fields: [orderId], references: [id])
  plan     Plan  @relation(fields: [planId], references: [id])
}

model Subscription {
  tickets Ticket[]
  id           Int       @id @default(autoincrement())
  userId       Int
  planId       Int
  orderId      Int?
  panelId      Int?
  status       String    @default("ACTIVE")
  username     String
  email        String?
  trafficLimit Int       @default(0)
  trafficUsed  Int       @default(0)
  deviceLimit  Int       @default(0)
  expiresAt    DateTime
  subToken     String    @unique
  panelSubUrl  String    @default("")
  configLinks  String    @default("[]")
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  plan         Plan      @relation(fields: [planId], references: [id])
  order        Order?    @relation(fields: [orderId], references: [id])
  panel        Panel?    @relation(fields: [panelId], references: [id])
  // set when a reseller created this account for their own customer
  resellerId   Int?
  reseller     Reseller? @relation(fields: [resellerId], references: [id])
}

/// A reseller (agency) account: creates subscriptions for its own customers
/// under admin-defined quotas (volume, account count, per-account limits).
model Reseller {
  id                     Int             @id @default(autoincrement())
  userId                 Int             @unique
  active                 Boolean         @default(true)
  // pricing: percentage off the list price, or explicit per-plan prices
  priceMode              String          @default("DISCOUNT") // DISCOUNT | CUSTOM
  discountPercent        Float           @default(0)
  // quotas — 0 means unlimited
  maxAccounts            Int             @default(0)
  maxActiveAccounts      Int             @default(0)
  trafficQuotaGB         Int             @default(0) // total GB the reseller may hand out
  maxTrafficPerAccountGB Int             @default(0) // cap per account (e.g. 100)
  allowUnlimitedTraffic  Boolean         @default(false) // may create accounts with 0 = unlimited
  maxDaysPerAccount      Int             @default(0) // cap on duration (e.g. 31)
  allowUnlimitedDays     Boolean         @default(false)
  maxDevicesPerAccount   Int             @default(0)
  note                   String          @default("")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  user                   User            @relation(fields: [userId], references: [id])
  prices                 ResellerPrice[]
  subscriptions          Subscription[]
  members                ResellerMember[]
}

model ResellerMember {
  id Int @id @default(autoincrement())
  resellerId Int
  userId Int @unique
  permissions String @default("")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resellerId, active])
}

model ResellerPrice {
  id         Int      @id @default(autoincrement())
  resellerId Int
  planId     Int
  price      Float // legacy display mirror
  priceMinor BigInt @default(0)
  reseller   Reseller @relation(fields: [resellerId], references: [id])
  plan       Plan     @relation(fields: [planId], references: [id])

  @@unique([resellerId, planId])
}

model TrialClaim {
  id Int @id @default(autoincrement())
  userId Int @unique
  planId Int
  orderId Int @unique
  status String @default("PENDING")
  subscriptionId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user User @relation(fields: [userId], references: [id])
}

model Promotion {
  id Int @id @default(autoincrement())
  code String @unique
  active Boolean @default(true)
  kind String @default("PERCENT")
  percentBps Int @default(0)
  amountMinor BigInt @default(0)
  currency String @default("USD")
  planId Int?
  minSubtotalMinor BigInt @default(0)
  maxUses Int @default(0)
  perUserLimit Int @default(1)
  membersOnly Boolean @default(false)
  reservedCount Int @default(0)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  redemptions PromotionRedemption[]
}

model PromotionRedemption {
  id Int @id @default(autoincrement())
  promotionId Int
  userId Int
  orderId Int @unique
  status String @default("RESERVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  promotion Promotion @relation(fields: [promotionId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  @@index([promotionId, userId, status])
}

model ReferralCode {
  id Int @id @default(autoincrement())
  ownerId Int @unique
  code String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

model ReferralAttribution {
  id Int @id @default(autoincrement())
  referredUserId Int @unique
  referrerUserId Int
  code String
  rewardBps Int
  rewardOrderId Int?
  rewardMinor BigInt @default(0)
  rewardCurrency String @default("USD")
  rewardedAt DateTime?
  createdAt DateTime @default(now())
  @@index([referrerUserId, createdAt])
}

model ServiceOffer {
  id Int @id @default(autoincrement())
  ownerKey String
  planId Int
  nameFa String
  nameEn String
  trafficGB Int
  days Int
  deviceLimit Int
  priceMinor BigInt
  currency String @default("USD")
  cardPriceMinor BigInt?
  cardCurrency String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  plan Plan @relation(fields: [planId], references: [id])
  sales ResellerSale[]
  @@index([ownerKey, active, sortOrder])
}

model ResellerBot {
  id Int @id @default(autoincrement())
  resellerId Int @unique
  botId String @unique
  username String
  tokenCipher String
  webhookSecret String
  ownerTelegramId String
  brandName String
  publicUrl String @default("")
  cardNumber String
  cardHolder String
  active Boolean @default(false)
  lastError String @default("")
  installedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ResellerSale {
  id Int @id @default(autoincrement())
  resellerId Int
  offerId Int
  botId Int
  telegramUserId String
  telegramChatId String
  sourceUpdateId String?
  status String @default("AWAITING_RECEIPT")
  receiptFileId String @default("")
  terms String @default("{}")
  retailMinor BigInt @default(0)
  currency String @default("USD")
  locale String @default("en")
  lastError String @default("")
  deliveredAt DateTime?
  reviewedAt DateTime?
  reviewerUserId Int?
  reviewerTelegramId String @default("")
  reviewDecision String @default("")
  orderId Int?
  subscriptionId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  offer ServiceOffer @relation(fields: [offerId], references: [id])
  @@index([resellerId, status, createdAt])
  @@index([botId, telegramUserId, createdAt])
  @@unique([botId, sourceUpdateId])
}

model ResellerBotUpdate {
  id Int @id @default(autoincrement())
  botId Int
  updateId String
  createdAt DateTime @default(now())
  @@unique([botId, updateId])
  @@index([createdAt])
}

model Ticket {
  subscriptionId Int?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionUsername String @default("")
  subscriptionLink String @default("")
  productId Int?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  department String @default("GENERAL")
  customFields String @default("{}")
  device String?
  issueType String?
  id        Int             @id @default(autoincrement())
  userId    Int
  subject   String
  status    String          @default("OPEN") // OPEN | PENDING | CLOSED
  priority  String          @default("normal")
  assignedToId Int?
  firstResponseAt DateTime?
  lastCustomerAt DateTime?
  lastStaffAt DateTime?
  closedAt DateTime?
  slaDueAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  user      User            @relation("TicketUser", fields: [userId], references: [id])
  messages  TicketMessage[]
  @@index([department, status, updatedAt])
  @@index([assignedToId, status])
}

model TicketDepartment {
  id Int @id @default(autoincrement())
  slug String @unique
  nameFa String
  nameEn String
  descriptionFa String @default("")
  descriptionEn String @default("")
  active Boolean @default(true)
  requiresSubscription Boolean @default(false)
  requiresProduct Boolean @default(false)
  fields String @default("[]")
  roleIds String @default("[]")
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    Int
  fromAdmin Boolean  @default(false)
  internal Boolean @default(false)
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  attachments TicketAttachment[]
}

model TicketAttachment {
  id Int @id @default(autoincrement())
  messageId Int
  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename String @unique
  originalName String
  mimeType String
  size Int
  createdAt DateTime @default(now())
  @@index([messageId])
}

model CrmNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  adminId   Int
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model WebhookLog {
  id        Int      @id @default(autoincrement())
  source    String   @default("plisio")
  payload   String
  valid     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int
  actorEmail  String
  action      String
  targetType  String
  targetId    String   @default("")
  requestId   String   @default("")
  ip          String   @default("")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([requestId])
}

// ============ CMS ============
model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  titleEn   String   @default("")
  content   String   @default("")
  contentEn String   @default("")
  status    String   @default("PUBLISHED") // DRAFT | PUBLISHED
  showInNav Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PostCategory {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  nameEn    String   @default("")
  createdAt DateTime @default(now())
  posts     Post[]
  parentId  Int?
  parent    PostCategory? @relation("PostCategoryTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children  PostCategory[] @relation("PostCategoryTree")
  assignments PostCategoryAssignment[]

  @@index([parentId])
}

model Post {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  titleEn     String        @default("")
  excerpt     String        @default("")
  excerptEn   String        @default("")
  content     String
  contentEn   String        @default("")
  cover       String        @default("")
  status      String        @default("PUBLISHED") // DRAFT | PUBLISHED
  featured    Boolean       @default(false)
  access      String        @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  views       Int           @default(0)
  authorId    Int?
  categoryId  Int?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  author      User?         @relation(fields: [authorId], references: [id])
  category    PostCategory? @relation(fields: [categoryId], references: [id])
  categories  PostCategoryAssignment[]
  comments    PostComment[]
}

model PostComment {
  id        Int       @id @default(autoincrement())
  postId    Int
  userId    Int
  parentId  Int?
  body      String
  status    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    PostComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   PostComment[] @relation("CommentReplies")
  @@index([postId, status, createdAt])
  @@index([parentId])
}

model PostCategoryAssignment {
  postId     Int
  categoryId Int
  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  nameEn    String    @default("")
  createdAt DateTime  @default(now())
  products  Product[]
  parentId  Int?
  parent    ProductCategory? @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("ProductCategoryTree")
  attributeGroupId Int?
  attributeGroup ProductAttributeGroup? @relation(fields: [attributeGroupId], references: [id], onDelete: SetNull)
  image     String @default("")
  icon      String @default("")
  description String @default("")
  sortOrder Int @default(0)
  @@index([parentId])
  @@index([attributeGroupId])
}

model ProductAttributeGroup {
  id        Int @id @default(autoincrement())
  name      String
  nameEn    String @default("")
  appliesTo String @default("ANY") // ANY | VIRTUAL | PHYSICAL
  // Validated array of {key, label, labelEn, kind, options, required}.
  fields    String @default("[]")
  categories ProductCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Product {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  name          String
  nameEn        String           @default("")
  description   String           @default("")
  descriptionEn String           @default("")
  price         Float            @default(0) // legacy display mirror; exact value is priceMinor
  priceMinor    BigInt           @default(0)
  currency      String           @default("USD")
  image         String           @default("")
  gallery       String           @default("[]")
  stock         Int              @default(-1) // -1 = unlimited
  active        Boolean          @default(true)
  featured      Boolean          @default(false)
  sortOrder     Int              @default(0)
  categoryId    Int?
  kind          String @default("VIRTUAL") // VIRTUAL | PHYSICAL
  access        String @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  memberPriceMinor BigInt @default(0) // VIP price; 0 = none
  vipGiftDays   Int @default(0) // VIP days granted with a paid purchase
  specifications String @default("{}") // attribute keys inherited from category group
  brandId       Int?
  sku           String @default("")
  compareAtMinor BigInt @default(0) // list price shown struck through; 0 = no discount
  saleEndsAt    DateTime? // end of a timed "amazing offer"
  shortDescription String @default("")
  warranty      String @default("")
  weightGrams   Int @default(0)
  maxPerOrder   Int @default(0) // 0 = no per-order limit
  lowStockAt    Int @default(0) // 0 = store default threshold
  seoTitle      String @default("")
  seoDescription String @default("")
  views         Int @default(0)
  soldCount     Int @default(0)
  faqs          String @default("[]")
  variants      ProductVariant[]
  reviews       ProductReview[]
  questions     ProductQuestion[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  brand         ProductBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  cartLines     CartLine[]
  orderLines    OrderLine[]
  orders        Order[]
  invoices      Invoice[]
  tickets       Ticket[]

  @@index([brandId])
  @@index([active, soldCount])
}

model ProductVariant {
  id          Int @id @default(autoincrement())
  productId   Int
  sku         String @unique
  name        String
  nameEn      String @default("")
  // Selected attribute keys and values, e.g. {"color":"blue"}.
  attributes  String @default("{}")
  price       Float @default(0)
  priceMinor  BigInt @default(0)
  memberPriceMinor BigInt @default(0)
  compareAtMinor BigInt @default(0)
  stock       Int @default(-1)
  active      Boolean @default(true)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]
  @@index([productId, active])
}

model ProductReview {
  id        Int @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  criteria  String @default("{}") // quality, value and usability scores (1–5)
  title     String @default("")
  body      String
  status    String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
}

model ProductQuestion {
  id        Int @id @default(autoincrement())
  productId Int
  userId    Int?
  guestName String @default("")
  body      String
  answer    String @default("")
  status    String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([productId, status, createdAt])
}

model ProductDelivery {
  id          Int @id @default(autoincrement())
  orderId     Int @unique
  status      String @default("PENDING") // PENDING | PROCESSING | DELIVERED
  address     String @default("")
  trackingCode String @default("")
  deliveryNote String @default("")
  scheduledDate String @default("") // chosen delivery day, YYYY-MM-DD
  scheduledSlot String @default("") // chosen time window label
  digitalDelivery String @default("") // encrypted fulfillment details, owner/admin only
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============ FINANCE / BILLING ============
model Gateway {
  id           Int       @id @default(autoincrement())
  name         String
  provider     String    @default("PLISIO") // PLISIO | FRENZYEX | MANUAL
  apiKey       String    @default("")
  secretKey    String    @default("")
  /// Login user for gateways that need one (Bank Mellat).
  accountUser  String    @default("")
  fiat         String    @default("USD")
  currencies   String    @default("")
  feePercent   Float     @default(0) // legacy display mirror
  feeBps       Int       @default(0)
  minAmount    Float     @default(0) // legacy display mirror
  minAmountMinor BigInt  @default(0)
  instructions String    @default("")
  active       Boolean   @default(true)
  isDefault    Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]
}

model Invoice {
  id            Int       @id @default(autoincrement())
  number        String    @unique
  userId        Int
  orderId       Int?      @unique
  planId        Int?
  productId     Int?
  subtotal      Float     @default(0) // legacy display mirrors; exact values are *Minor
  subtotalMinor BigInt    @default(0)
  discount      Float     @default(0)
  discountMinor BigInt    @default(0)
  tax           Float     @default(0)
  taxMinor      BigInt    @default(0)
  total         Float     @default(0)
  totalMinor    BigInt    @default(0)
  // how much of the total was covered by the customer's wallet credit
  walletApplied Float     @default(0)
  walletAppliedMinor BigInt @default(0)
  currency      String    @default("USD")
  idempotencyKey String?  @unique
  status        String    @default("UNPAID") // DRAFT | UNPAID | PAID | VOID | REFUNDED
  gatewayId     Int?
  providerTxnId String    @default("")
  paymentUrl    String    @default("")
  paidCrypto    String    @default("")
  paidAmount    Float     @default(0)
  paidAmountMinor BigInt   @default(0)
  notes         String    @default("")
  kind          String    @default("BILLING") // BILLING | WALLET_TOPUP
  createdBy     Int?
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  order         Order?    @relation(fields: [orderId], references: [id])
  plan          Plan?     @relation(fields: [planId], references: [id])
  product       Product?  @relation(fields: [productId], references: [id])
  gateway       Gateway?  @relation(fields: [gatewayId], references: [id])
  payments      Payment[]
  receipts      PaymentReceipt[]
}

model Payment {
  id             Int       @id @default(autoincrement())
  userId         Int?
  orderId        Int?
  invoiceId      Int?
  gatewayId      Int?
  provider       String    @default("PLISIO")
  providerTxnId  String    @default("")
  amount         Float     @default(0) // legacy display mirror
  amountMinor    BigInt    @default(0)
  currency       String    @default("USD")
  cryptoCurrency String    @default("")
  cryptoAmount   String    @default("")
  fee            Float     @default(0) // legacy display mirror
  feeMinor       BigInt    @default(0)
  eventKey       String?   @unique
  status         String    @default("PENDING") // PENDING | PROCESSED | CONFIRMED | FAILED | REFUNDED
  raw            String    @default("{}")
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  user           User?     @relation(fields: [userId], references: [id])
  order          Order?    @relation(fields: [orderId], references: [id])
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id])
  gateway        Gateway?  @relation(fields: [gatewayId], references: [id])
}

model WalletTx {
  id           Int      @id @default(autoincrement())
  userId       Int
  amount       Float // legacy display mirror; + credit / - debit
  amountMinor  BigInt   @default(0)
  balanceAfter Float    @default(0) // legacy display mirror
  balanceAfterMinor BigInt @default(0)
  currency     String   @default("USD")
  idempotencyKey String? @unique
  type         String   @default("TOPUP") // TOPUP | PURCHASE | REFUND | ADMIN_CREDIT | ADMIN_DEBIT | RENEWAL
  status       String   @default("DONE") // DONE | PENDING | PROCESSING | FAILED
  description  String   @default("")
  orderId      Int?
  invoiceId    Int?
  adminId      Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String    @default("default")
  prefix     String    @default("")
  token      String    @unique
  active     Boolean   @default(true)
  requests   Int       @default(0)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  category  String   @default("SERVER") // SERVER | MARKETING | SALARY | OTHER
  amount    Float    @default(0) // legacy display mirror
  amountMinor BigInt  @default(0)
  currency  String   @default("USD")
  spentAt   DateTime @default(now())
  note      String   @default("")
  createdBy Int?
  createdAt DateTime @default(now())
}

// ============ FINANCIAL / DELIVERY INFRASTRUCTURE ============
model WalletAccount {
  id           Int      @id @default(autoincrement())
  userId       Int
  currency     String
  balanceMinor BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@index([currency])
}

model InvoiceSequence {
  year      Int      @id
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

/// Durable webhook inbox. A provider event is claimed once and can be retried
/// after a worker crash without settling the same financial event twice.
model WebhookInbox {
  id          Int       @id @default(autoincrement())
  provider    String
  eventKey    String
  status      String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  payload     String
  attempts    Int       @default(0)
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([provider, eventKey])
  @@index([status, lockedAt])
}

/// Durable side-effect queue. Payment settlement is committed before external
/// VPN provisioning/product delivery; workers can safely retry failed jobs.
model FulfillmentJob {
  id             Int       @id @default(autoincrement())
  kind           String // PROVISION_SUBSCRIPTION | RENEW_SUBSCRIPTION | DELIVER_PRODUCT | RESELLER_PROVISION
  dedupeKey      String    @unique
  status         String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  payload        String    @default("{}")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  lastError      String    @default("")
  orderId        Int?
  invoiceId      Int?
  subscriptionId Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([orderId])
  @@index([invoiceId])
}

/// Reserves finite stock while an invoice is open so concurrent checkouts
/// cannot oversell the last unit.
model InventoryReservation {
  id        Int      @id @default(autoincrement())
  orderId   Int
  line      Int      @default(0) // order line index; single-item orders use 0
  productId Int
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantFinite Boolean @default(false)
  quantity  Int      @default(1)
  finite    Boolean  @default(true)
  status    String   @default("HELD") // HELD | CONSUMED | RELEASED
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([orderId, line])
  @@index([productId, status])
  @@index([expiresAt, status])
}

// Map markers for landing globe
model MapLocation {
  id        Int      @id @default(autoincrement())
  country   String // e.g. Germany
  countryFa String   @default("")
  flag      String   @default("🏳️")
  lat       Float
  lng       Float
  city      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Independent form definitions and private submissions.
model SiteForm {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  title       String
  description String           @default("")
  fields      String           @default("[]")
  published   Boolean          @default(false)
  successText String           @default("پیام شما با موفقیت ثبت شد.")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  formId    Int
  data      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  form      SiteForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
}

model SubscriptionReminder {
  id             String   @id
  subscriptionId Int
  kind           String
  status         String   @default("CLAIMED")
  attempts       Int      @default(1)
  retryAt        DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([status, retryAt])
  @@index([subscriptionId])
}

model ServiceIncident {
  id Int @id @default(autoincrement())
  panelId Int?
  titleFa String
  titleEn String
  messageFa String
  messageEn String
  status String @default("INVESTIGATING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([panelId, status])
}


// ---------------------------------------------------------------- VIP membership

/// Paid VIP membership plans (site-wide premium access).
model MembershipPlan {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  name          String
  nameEn        String   @default("")
  description   String   @default("")
  descriptionEn String   @default("")
  days          Int
  priceMinor    BigInt   @default(0)
  currency      String   @default("USD")
  perks         String   @default("[]")
  highlight     Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

/// One VIP period. A user is a member while now is between startsAt and endsAt (and not revoked).
model UserMembership {
  id        Int       @id @default(autoincrement())
  userId    Int
  planId    Int?
  source    String    @default("PURCHASE") // PURCHASE | GIFT | ADMIN
  startsAt  DateTime  @default(now())
  endsAt    DateTime
  orderId   Int?
  dedupeKey String?   @unique
  note      String    @default("")
  revokedAt DateTime?
  createdBy Int?
  createdAt DateTime  @default(now())

  @@index([userId, endsAt])
  @@index([orderId])
}

// ---------------------------------------------------------------- Music

model MusicArtist {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  name      String
  nameEn    String       @default("")
  bio       String       @default("")
  image     String       @default("")
  cover     String       @default("")
  featured  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  albums    MusicAlbum[]
  tracks    MusicTrack[]
}

model MusicAlbum {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  title       String
  titleEn     String       @default("")
  artistId    Int
  cover       String       @default("")
  year        Int?
  genre       String       @default("")
  description String       @default("")
  access      String       @default("PUBLIC") // PUBLIC | MEMBERS
  status      String       @default("PUBLISHED")
  featured    Boolean      @default(false)
  views       Int          @default(0)
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  artist      MusicArtist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      MusicTrack[]

  @@index([artistId])
  @@index([status, publishedAt])
}

model MusicTrack {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  title       String
  titleEn     String      @default("")
  artistId    Int
  albumId     Int?
  trackNo     Int         @default(0)
  cover       String      @default("")
  audioUrl    String      @default("")
  audioHqUrl  String      @default("")
  duration    Int         @default(0)
  genre       String      @default("")
  lyrics      String      @default("")
  access      String      @default("PUBLIC")
  status      String      @default("PUBLISHED")
  featured    Boolean     @default(false)
  plays       Int         @default(0)
  downloads   Int         @default(0)
  publishedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  artist      MusicArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album       MusicAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([artistId])
  @@index([albumId, trackNo])
  @@index([status, publishedAt])
}

model MusicPlaylist {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  titleEn     String   @default("")
  cover       String   @default("")
  description String   @default("")
  trackIds    String   @default("[]")
  access      String   @default("PUBLIC")
  status      String   @default("PUBLISHED")
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// ---------------------------------------------------------------- Film & series

model CinemaTitle {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  kind          String         @default("MOVIE") // MOVIE | SERIES
  title         String
  titleEn       String         @default("")
  originalTitle String         @default("")
  poster        String         @default("")
  backdrop      String         @default("")
  year          Int?
  endYear       Int?
  imdbRating    Float?
  imdbId        String         @default("")
  runtime       Int            @default(0)
  ageRating     String         @default("")
  countries     String         @default("")
  languages     String         @default("")
  genres        String         @default("")
  director      String         @default("")
  cast          String         @default("[]")
  summary       String         @default("")
  summaryEn     String         @default("")
  trailerUrl    String         @default("")
  quality       String         @default("")
  dubbed        Boolean        @default(false)
  subtitle      Boolean        @default(false)
  seriesStatus  String         @default("")
  access        String         @default("PUBLIC")
  status        String         @default("PUBLISHED")
  featured      Boolean        @default(false)
  views         Int            @default(0)
  publishedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  seasons       CinemaSeason[]

  @@index([kind, status, publishedAt])
}

model CinemaSeason {
  id       Int             @id @default(autoincrement())
  titleId  Int
  number   Int
  name     String          @default("")
  poster   String          @default("")
  title    CinemaTitle     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes CinemaEpisode[]

  @@unique([titleId, number])
}

model CinemaEpisode {
  id       Int          @id @default(autoincrement())
  seasonId Int
  number   Int
  title    String       @default("")
  titleEn  String       @default("")
  summary  String       @default("")
  still    String       @default("")
  runtime  Int          @default(0)
  airDate  DateTime?
  access   String       @default("PUBLIC")
  season   CinemaSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, number])
}

// ---------------------------------------------------------------- Games

model GameTitle {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  titleEn      String    @default("")
  cover        String    @default("")
  backdrop     String    @default("")
  platforms    String    @default("")
  genres       String    @default("")
  developer    String    @default("")
  publisher    String    @default("")
  releaseDate  DateTime?
  score        Int?
  userScore    Float?
  ageRating    String    @default("")
  trailerUrl   String    @default("")
  screenshots  String    @default("[]")
  summary      String    @default("")
  content      String    @default("")
  pros         String    @default("[]")
  cons         String    @default("[]")
  requirements String    @default("{}")
  access       String    @default("PUBLIC")
  status       String    @default("PUBLISHED")
  featured     Boolean   @default(false)
  views        Int       @default(0)
  franchiseId  Int?
  franchise    GameFranchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  engine       String    @default("")
  modes        String    @default("") // SINGLE, MULTI, COOP, ONLINE (comma separated)
  localization String    @default("") // FA_SUB, FA_DUB, FA_UI (comma separated)
  releases     String    @default("[]") // per-platform release dates [{platform, date}]
  playMain     Int       @default(0) // hours to finish the main story
  playExtra    Int       @default(0) // main + extras
  playComplete Int       @default(0) // completionist
  storeLinks   String    @default("[]") // official stores [{store, url}]
  gameSize     String    @default("")
  version      String    @default("") // latest build / version on the download links
  verdict      String    @default("") // one-line editor verdict next to the score
  editorsChoice Boolean  @default(false)
  seoTitle     String    @default("")
  seoDescription String  @default("")
  updates      GameUpdate[]
  library      GameLibrary[]
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([status, publishedAt])
  @@index([releaseDate])
  @@index([franchiseId])
}

/// A game series (Souls, God of War…): groups titles on the franchise page.
model GameFranchise {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  title       String
  titleEn     String      @default("")
  description String      @default("")
  image       String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  games       GameTitle[]
}

/// Updates, patches, DLCs and editions of a game. Download links live in
/// MediaLink (ownerType "gameupdate").
model GameUpdate {
  id         Int       @id @default(autoincrement())
  gameId     Int
  game       GameTitle @relation(fields: [gameId], references: [id], onDelete: Cascade)
  kind       String    @default("UPDATE") // UPDATE | PATCH | DLC | EDITION
  title      String
  version    String    @default("")
  size       String    @default("")
  notes      String    @default("")
  releasedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([gameId, releasedAt])
}

/// A member's game library (GameUp "played / playing / want to play").
model GameLibrary {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    Int
  game      GameTitle @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status    String // PLAYING | PLAYED | WANT | DROPPED
  hours     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([userId, gameId])
  @@index([gameId, status])
  @@index([userId, status, updatedAt])
}

/// Software downloads (Windows/macOS/Linux/Android/iOS). Download links live in
/// MediaLink (ownerType "software") and go through the protected redirect.
model SoftwareTitle {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  titleEn      String    @default("")
  icon         String    @default("")
  cover        String    @default("")
  version      String    @default("")
  developer    String    @default("")
  license      String    @default("FREE") // FREE | FREEMIUM | TRIAL | PAID | OPEN_SOURCE
  platforms    String    @default("")
  category     String    @default("")
  size         String    @default("")
  website      String    @default("")
  requirements String    @default("")
  screenshots  String    @default("[]")
  summary      String    @default("")
  content      String    @default("")
  changelog    String    @default("")
  installGuide String    @default("")
  archivePassword String @default("")
  features     String    @default("")
  access       String    @default("PUBLIC")
  status       String    @default("PUBLISHED")
  featured     Boolean   @default(false)
  views        Int       @default(0)
  downloads    Int       @default(0)
  releasedAt   DateTime?
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([status, publishedAt])
}

/// Forum (تالار گفتمان). The first post of a thread is its body; counters are
/// denormalized for fast listings and kept in sync by the forum service.
model ForumCategory {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  description String        @default("")
  icon        String        @default("")
  access      String        @default("PUBLIC") // PUBLIC | MEMBERS (VIP)
  locked      Boolean       @default(false) // only moderators start threads
  sortOrder   Int           @default(0)
  parentId    Int?
  parent      ForumCategory?  @relation("ForumSubcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    ForumCategory[] @relation("ForumSubcategories")
  color       String        @default("#6366f1")
  threadCount Int           @default(0)
  postCount   Int           @default(0)
  lastPostAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  threads     ForumThread[]
  permissions ForumCategoryPermission[]
  watchers    ForumCategoryUser[]
}

model ForumThread {
  id             Int           @id @default(autoincrement())
  categoryId     Int
  category       ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  pinned         Boolean       @default(false)
  locked         Boolean       @default(false)
  status         String        @default("VISIBLE") // VISIBLE | HIDDEN
  views          Int           @default(0)
  replyCount     Int           @default(0)
  lastPostAt     DateTime      @default(now())
  lastPostUserId Int?
  solvedPostId   Int?          @unique
  closeAt        DateTime? // topic timer: closes automatically at this moment
  slowModeSeconds Int          @default(0) // minimum seconds between one member's replies
  listed         Boolean       @default(true) // unlisted topics open by link only
  solvedPost     ForumPost?    @relation("ForumSolution", fields: [solvedPostId], references: [id], onDelete: SetNull)
  likeCount      Int           @default(0)
  postCount      Int           @default(0) // highest post number
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  posts          ForumPost[]   @relation("ForumThreadPosts")
  tags           ForumThreadTag[]
  topicUsers     ForumTopicUser[]

  @@index([categoryId, status, pinned, lastPostAt])
  @@index([userId])
  @@index([status, lastPostAt])
}

model ForumPost {
  id        Int         @id @default(autoincrement())
  threadId  Int
  thread    ForumThread @relation("ForumThreadPosts", fields: [threadId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  status    String      @default("VISIBLE") // VISIBLE | HIDDEN
  editedAt  DateTime?
  postNumber Int        @default(0)
  replyToId Int?
  likeCount Int         @default(0)
  editCount Int         @default(0)
  wiki      Boolean     @default(false) // members from trust level 1 may edit
  reviewReason String   @default("") // why a PENDING post waits for staff approval
  createdAt DateTime    @default(now())

  @@index([threadId, status, createdAt])
  reactions ForumReaction[]
  bookmarks ForumBookmark[]
  flags     ForumFlag[]
  revisions ForumPostRevision[]
  polls     ForumPoll[]
  solutionOf ForumThread?   @relation("ForumSolution")

  @@index([userId, createdAt])
  @@index([threadId, postNumber])
}

/// Download / stream links for films, episodes and games. URLs are never sent to
/// the browser; visitors go through /api/media/link/<id>, which checks VIP access.
model MediaLink {
  id        Int      @id @default(autoincrement())
  ownerType String // title | episode | game | software
  ownerId   Int
  label     String   @default("")
  kind      String   @default("DOWNLOAD") // DOWNLOAD | STREAM
  quality   String   @default("")
  size      String   @default("")
  audio     String   @default("") // ORIGINAL | DUBBED | ''
  subtitle  Boolean  @default(false)
  url       String
  access    String   @default("PUBLIC")
  clicks    Int      @default(0)
  disabled  Boolean  @default(false) // hidden (broken link or copyright takedown)
  reports   LinkReport[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
}

/// Bank accounts shown to customers for card-to-card and bank transfers.
model BankAccount {
  id            Int              @id @default(autoincrement())
  bankName      String
  holderName    String
  cardNumber    String           @default("")
  sheba         String           @default("")
  accountNumber String           @default("")
  note          String           @default("")
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  receipts      PaymentReceipt[]
}

/// A customer's proof of a card-to-card / bank transfer. An admin approves it
/// (which settles the invoice) or rejects it with a reason.
model PaymentReceipt {
  id            Int          @id @default(autoincrement())
  invoiceId     Int
  userId        Int
  bankAccountId Int?
  method        String       @default("CARD") // CARD | PAYA | SATNA | ACCOUNT
  amountMinor   BigInt       @default(0)
  currency      String       @default("IRR")
  payerName     String       @default("")
  payerBank     String       @default("")
  payerCard     String       @default("") // last four digits of the source card
  trackingCode  String       @default("")
  paidAt        DateTime?
  image         String       @default("") // file name under storage/receipts
  imageType     String       @default("")
  status        String       @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote     String       @default("")
  reviewedBy    Int?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invoiceId])
  @@index([userId])
}

/// One-time SMS codes for phone login and phone verification (only a hash is stored).
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  purpose    String    @default("LOGIN") // LOGIN | VERIFY
  codeHash   String
  attempts   Int       @default(0)
  userId     Int?
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String    @default("")
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

/// Outgoing SMS history (IPPanel).
model SmsLog {
  id         Int      @id @default(autoincrement())
  phone      String
  event      String   @default("")
  kind       String   @default("TEXT") // TEXT | PATTERN | OTP
  body       String   @default("")
  status     String   @default("SENT") // SENT | FAILED | SKIPPED
  providerId String   @default("")
  error      String   @default("")
  userId     Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([phone, createdAt])
}

/// Forum profile (Discourse-style): public handle, bio, trust level and counters.
model ForumProfile {
  userId        Int          @id
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String       @unique
  bio           String       @default("")
  location      String       @default("")
  website       String       @default("")
  avatar        String       @default("")
  cover         String       @default("")
  title         String       @default("")
  primaryGroupId Int?
  trustLevel    Int          @default(0)
  trustLocked   Boolean      @default(false)
  topicCount    Int          @default(0)
  postCount     Int          @default(0)
  likesGiven    Int          @default(0)
  likesReceived Int          @default(0)
  solvedCount   Int          @default(0)
  topicsEntered Int          @default(0)
  daysVisited   Int          @default(0)
  lastVisitDay  String       @default("")
  lastSeenAt    DateTime?
  silencedUntil DateTime?
  suspendedUntil DateTime?
  moderationNote String      @default("")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([trustLevel])
  @@index([postCount])
}

/// Forum groups: custom (open, by request or invite-only) and automatic ones
/// (everyone, vip, staff, trust_level_0..4) used in category permissions.
model ForumGroup {
  id          Int                  @id @default(autoincrement())
  slug        String               @unique
  name        String
  description String               @default("")
  icon        String               @default("")
  color       String               @default("#6366f1")
  title       String               @default("") // title granted to members
  automatic   String?              @unique // everyone | vip | staff | trust_level_0..4
  visibility  String               @default("PUBLIC") // PUBLIC | MEMBERS | STAFF
  joinMode    String               @default("CLOSED") // OPEN | REQUEST | CLOSED
  moderator   Boolean              @default(false) // members moderate the forum
  mentionable Boolean              @default(false)
  memberCount Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  members     ForumGroupMember[]
  permissions ForumCategoryPermission[]
}

model ForumGroupMember {
  id        Int        @id @default(autoincrement())
  groupId   Int
  group     ForumGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner     Boolean    @default(false)
  status    String     @default("ACTIVE") // ACTIVE | PENDING
  createdAt DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId, status])
}

/// Per-category group permission. A category with rows is restricted to them.
model ForumCategoryPermission {
  id         Int           @id @default(autoincrement())
  categoryId Int
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groupId    Int
  group      ForumGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  level      String        @default("CREATE") // SEE | REPLY | CREATE

  @@unique([categoryId, groupId])
}

model ForumTag {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String           @default("")
  topicCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  threads     ForumThreadTag[]
}

model ForumThreadTag {
  threadId Int
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tagId    Int
  tag      ForumTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

model ForumReaction {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String    @default("heart")
  createdAt DateTime  @default(now())

  @@unique([postId, userId, emoji])
  @@index([userId, createdAt])
}

model ForumBookmark {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, postId])
}

/// Community flags; enough weight hides a post until staff review it.
model ForumFlag {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String    @default("OTHER") // SPAM | INAPPROPRIATE | OFF_TOPIC | OTHER
  note      String    @default("")
  weight    Int       @default(1)
  status    String    @default("PENDING") // PENDING | AGREED | DISAGREED
  handledBy Int?
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([status, createdAt])
}

model ForumPostRevision {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  content   String
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
}

/// Per-user topic state: read position (unread/new) and notification level.
model ForumTopicUser {
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId       Int
  thread         ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  lastRead       Int         @default(0)
  level          String      @default("NORMAL") // WATCHING | TRACKING | NORMAL | MUTED
  firstVisitedAt DateTime    @default(now())
  lastVisitedAt  DateTime    @default(now())

  @@id([userId, threadId])
  @@index([threadId, level])
}

model ForumBadge {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  name        String
  description String           @default("")
  icon        String           @default("🏅")
  tier        String           @default("BRONZE") // BRONZE | SILVER | GOLD
  rule        String           @default("") // automatic rule id; empty = granted by staff
  enabled     Boolean          @default(true)
  grantCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  grants      ForumUserBadge[]
}

model ForumUserBadge {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   Int
  badge     ForumBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  reason    String     @default("")
  grantedBy Int?
  grantedAt DateTime   @default(now())

  @@unique([userId, badgeId])
  @@index([badgeId, grantedAt])
}

// ---------------------------------------------------------------- downloads
model DownloadLog {
  id        Int      @id @default(autoincrement())
  linkId    Int?
  ownerType String // title | episode | game | software | track
  ownerId   Int
  userId    Int?
  visitor   String   @default("") // daily salted hash of ip + user agent
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([visitor, createdAt])
  @@index([ownerType, ownerId])
}

model LinkReport {
  id         Int       @id @default(autoincrement())
  linkId     Int
  userId     Int?
  visitor    String    @default("")
  reason     String // BROKEN | WRONG_FILE | SLOW | PASSWORD | OTHER
  note       String    @default("")
  status     String    @default("OPEN") // OPEN | FIXED | DISMISSED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  link       MediaLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([linkId])
}

// ---------------------------------------------------------------- reviews & favorites
model ItemReview {
  id        Int      @id @default(autoincrement())
  itemType  String // software | game | title | album | track
  itemId    Int
  userId    Int
  rating    Int
  body      String   @default("")
  status    String   @default("APPROVED") // text moderation: PENDING | APPROVED | REJECTED (rejected ratings are not counted)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemType, itemId, userId])
  @@index([itemType, itemId, status, createdAt])
  @@index([status, createdAt])
}

model ItemFavorite {
  userId    Int
  itemType  String
  itemId    Int
  notify    Boolean  @default(true) // "tell me about new versions / episodes"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemType, itemId])
  @@index([itemType, itemId])
}

model ItemStat {
  itemType    String
  itemId      Int
  ratingCount Int    @default(0)
  ratingSum   Int    @default(0)
  favorites   Int    @default(0)

  @@id([itemType, itemId])
}

// ---------------------------------------------------------------- search
model SearchDocument {
  id          Int      @id @default(autoincrement())
  itemType    String
  itemId      Int
  title       String
  subtitle    String   @default("")
  text        String // normalized title, keywords and summary
  url         String
  image       String   @default("")
  access      String   @default("PUBLIC")
  boost       Int      @default(0)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([itemType, itemId])
  @@index([itemType, publishedAt])
}

// ---------------------------------------------------------------- social publishing
model SocialPost {
  id            Int       @id @default(autoincrement())
  channel       String // TELEGRAM | INSTAGRAM
  itemType      String
  itemId        Int
  status        String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  attempts      Int       @default(0)
  error         String    @default("")
  externalId    String    @default("")
  text          String    @default("")
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([channel, itemType, itemId])
  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------- web push
model PushSubscription {
  id            Int       @id @default(autoincrement())
  endpoint      String    @unique
  p256dh        String
  auth          String
  userId        Int?
  userAgent     String    @default("")
  failures      Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PushCampaign {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @default("")
  url       String   @default("/")
  audience  String   @default("ALL") // ALL | USERS | VIP | GUESTS
  sent      Int      @default(0)
  failed    Int      @default(0)
  createdBy Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------- analytics
model AnalyticsDaily {
  day      String // YYYY-MM-DD (Asia/Tehran)
  path     String // "*" holds the site-wide totals
  views    Int    @default(0)
  visitors Int    @default(0)

  @@id([day, path])
}

model AnalyticsVisitor {
  day  String
  hash String

  @@id([day, hash])
}

model AnalyticsDimension {
  day   String
  dim   String // source | device | browser | os | search | search-empty
  value String
  count Int    @default(0)

  @@id([day, dim, value])
  @@index([dim, day])
}

// ---------------------------------------------------------------- copyright
model CopyrightReport {
  id             Int       @id @default(autoincrement())
  code           String    @unique // tracking code shown to the reporter
  name           String
  email          String
  organization   String    @default("")
  phone          String    @default("")
  role           String    @default("OWNER") // OWNER | AGENT
  workTitle      String
  originalUrl    String    @default("")
  infringingUrls String // one URL per line
  itemType       String    @default("")
  itemId         Int?
  description    String
  signature      String
  status         String    @default("NEW") // NEW | REVIEWING | ACCEPTED | REJECTED
  resolution     String    @default("") // message shown to the reporter
  actionTaken    String    @default("") // internal log of what was removed
  visitor        String    @default("")
  handledBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  resolvedAt     DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- shipping
model UserAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String   @default("")
  recipient  String
  mobile     String
  province   String
  city       String
  address    String
  plaque     String   @default("")
  unit       String   @default("")
  postalCode String
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeliveryBooking {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  date      String // YYYY-MM-DD (Tehran)
  slotId    String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([date, slotId])
}

/// Hierarchical categories for content sections (WordPress-style taxonomy).
/// One tree per section ("software", "games", "music", "cinema"); items are
/// linked through TaxonomyAssignment, whose ownerId points at that section's
/// own table.
model TaxonomyTerm {
  id             Int       @id @default(autoincrement())
  taxonomy       String
  slug           String
  name           String
  description    String    @default("")
  icon           String    @default("")
  image          String    @default("")
  color          String    @default("")
  parentId       Int?
  parent         TaxonomyTerm?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       TaxonomyTerm[] @relation("TaxonomyTree")
  sortOrder      Int       @default(0)
  inMenu         Boolean   @default(true)
  count          Int       @default(0)
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  assignments    TaxonomyAssignment[]

  @@unique([taxonomy, slug])
  @@index([taxonomy, parentId, sortOrder])
}

model TaxonomyAssignment {
  termId   Int
  ownerId  Int
  taxonomy String
  primary  Boolean      @default(false)
  term     TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([termId, ownerId])
  @@index([taxonomy, ownerId])
}

/// Manufacturer / brand of store products.
model ProductBrand {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  nameEn      String    @default("")
  logo        String    @default("")
  description String    @default("")
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  products    Product[]
}

/// Shopping cart: one per signed-in customer, or per browser (token cookie) for guests.
model Cart {
  id        Int        @id @default(autoincrement())
  token     String     @unique
  userId    Int?       @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines     CartLine[]

  @@index([updatedAt])
}

model CartLine {
  id         Int      @id @default(autoincrement())
  cartId     Int
  productId  Int
  variantKey Int      @default(0) // variant id, 0 = product without variants
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
  @@index([productId])
}

/// Snapshot of each product line of a store order (price and name at purchase time).
model OrderLine {
  id             Int      @id @default(autoincrement())
  orderId        Int
  line           Int      @default(0)
  productId      Int?
  variantId      Int?
  name           String
  variantName    String   @default("")
  sku            String   @default("")
  image          String   @default("")
  kind           String   @default("VIRTUAL")
  quantity       Int      @default(1)
  unitPriceMinor BigInt   @default(0)
  listPriceMinor BigInt   @default(0)
  totalMinor     BigInt   @default(0)
  currency       String   @default("IRT")
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([orderId, line])
  @@index([productId])
}

/// Order timeline (status changes, notes); customer-visible rows appear in order tracking.
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String   @default("")
  note      String   @default("")
  visible   Boolean  @default(true)
  actorId   Int?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// A poll inside a forum post ([poll] … [/poll] blocks, one row per block).
model ForumPoll {
  id         Int             @id @default(autoincrement())
  postId     Int
  post       ForumPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  name       String          @default("poll")
  title      String          @default("")
  type       String          @default("regular") // regular | multiple
  options    String          @default("[]") // [{ id, label }]
  minChoices Int             @default(1)
  maxChoices Int             @default(1)
  results    String          @default("on_vote") // always | on_vote | on_close
  closed     Boolean         @default(false)
  closesAt   DateTime?
  voterCount Int             @default(0)
  createdAt  DateTime        @default(now())
  votes      ForumPollVote[]

  @@unique([postId, name])
}

model ForumPollVote {
  pollId    Int
  poll      ForumPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  createdAt DateTime  @default(now())

  @@id([pollId, userId, optionId])
  @@index([userId])
}

/// Per-member category notification level (watching, watching first post, tracking, normal, muted).
model ForumCategoryUser {
  userId     Int
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level      String        @default("NORMAL")

  @@id([userId, categoryId])
  @@index([categoryId, level])
}

/// Personal messages: private conversations between members (and staff).
model ForumConversation {
  id             Int                     @id @default(autoincrement())
  title          String
  userId         Int // creator
  postCount      Int                     @default(0)
  lastPostAt     DateTime                @default(now())
  lastPostUserId Int?
  createdAt      DateTime                @default(now())
  participants   ForumConversationUser[]
  messages       ForumMessage[]

  @@index([lastPostAt])
}

model ForumConversationUser {
  conversationId Int
  conversation   ForumConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastRead       Int               @default(0)
  archived       Boolean           @default(false)
  left           Boolean           @default(false)
  joinedAt       DateTime          @default(now())

  @@id([conversationId, userId])
  @@index([userId, archived])
}

model ForumMessage {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   ForumConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  number         Int
  content        String
  editedAt       DateTime?
  createdAt      DateTime          @default(now())

  @@unique([conversationId, number])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- Unified profile & social graph

/// The one public profile of a member across the site (forum, reviews,
/// game library, social posts). The forum keeps a denormalized copy of the
/// username/avatar in ForumProfile for its own queries.
model UserProfile {
  userId         Int      @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String   @unique
  headline       String   @default("") // one-line tagline under the name
  bio            String   @default("")
  location       String   @default("")
  website        String   @default("")
  avatar         String   @default("")
  cover          String   @default("")
  links          String   @default("[]") // [{kind, url}] social accounts
  privacy        String   @default("{}") // visibility, messages, activity toggles
  verified       Boolean  @default(false)
  followerCount  Int      @default(0)
  followingCount Int      @default(0)
  postCount      Int      @default(0)
  pinnedPostId   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([followerCount])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A member's post on their profile / the social feed.
model CommunityPost {
  id           Int             @id @default(autoincrement())
  authorId     Int
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content      String
  images       String          @default("[]")
  itemType     String          @default("") // shared site item: game | software | product | post | thread …
  itemId       Int?
  visibility   String          @default("PUBLIC") // PUBLIC | FOLLOWERS
  status       String          @default("VISIBLE") // VISIBLE | HIDDEN
  likeCount    Int             @default(0)
  commentCount Int             @default(0)
  editedAt     DateTime?
  createdAt    DateTime        @default(now())
  comments     CommunityComment[]
  likes        CommunityLike[]
  reports      CommunityReport[]

  @@index([authorId, status, createdAt])
  @@index([status, createdAt])
}

model CommunityComment {
  id        Int            @id @default(autoincrement())
  postId    Int
  post      CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  status    String         @default("VISIBLE")
  createdAt DateTime       @default(now())
  reports   CommunityReport[]

  @@index([postId, status, createdAt])
}

model CommunityLike {
  id        Int        @id @default(autoincrement())
  postId    Int
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model CommunityReport {
  id         Int            @id @default(autoincrement())
  postId     Int?
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  Int?
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  note       String         @default("")
  status     String         @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime       @default(now())

  @@index([status, createdAt])
}

/// Emails the site sent (test sends, notifications) — the panel's sent log.
model MailLog {
  id        Int      @id @default(autoincrement())
  toAddress String
  subject   String
  status    String   @default("SENT")
  error     String   @default("")
  messageId String   @default("")
  source    String   @default("system")
  actorId   Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}
